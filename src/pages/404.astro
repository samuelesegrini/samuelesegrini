---
/** Pagina non trovata, in due lingue, senza dipendere da nulla oltre ai token del sito. */
import '../styles/global.css';
import { labPaths } from '../components/lab/chrome';
import { siteConfig } from '../config/site';
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>404 — {siteConfig.name}</title>
	</head>
	<body class="non-trovata">
		<main>
			<span class="non-trovata-kicker">404</span>
			<h1>Questa strada non porta a una pagina.<br /><em>This road leads nowhere.</em></h1>
			<nav aria-label="Dove andare">
				<a href={labPaths.it.home} lang="it">Torna alla home ↗</a>
				<a href={labPaths.en.home} lang="en">Back to the home ↗</a>
			</nav>
		</main>
	</body>
</html>

<style>
	.non-trovata main { display: grid; align-content: center; gap: 28px; min-height: 100svh; padding: 10vh max(24px, 4vw); }
	.non-trovata-kicker { font: 10px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: #6b6760; }
	.non-trovata h1 { max-width: 16ch; margin: 0; font-size: clamp(40px, 7vw, 96px); font-weight: 500; letter-spacing: -.07em; line-height: .96; }
	.non-trovata h1 em { display: block; margin-top: .3em; font-family: var(--serif); font-style: italic; font-weight: 430; color: #6b6760; }
	.non-trovata nav { display: flex; flex-wrap: wrap; gap: 12px; }
	.non-trovata nav a { display: inline-flex; min-height: 44px; align-items: center; padding: 0 18px; border-radius: 999px; background: #111; color: #fffef9; font-size: 14px; font-weight: 700; }
</style>
