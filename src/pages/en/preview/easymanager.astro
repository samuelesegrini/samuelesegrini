---
/**
 * Anteprima non elencata del nuovo dettaglio progetto, impaginato come una pagina prodotto.
 * Serve a valutare la proposta su un progetto vero prima di farne il modello per tutti:
 * fuori dalla sitemap, noindex, nessun link dal resto del sito.
 */
import { render } from 'astro:content';
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import LabContentLink from '../../../components/lab/LabContentLink.astro';
import LabContentImage from '../../../components/lab/LabContentImage.astro';
import { Story, Section, Hero, Highlights, Statement, FeatureGrid, Gallery, CodeSplit, Layers, Numbers, Compare, Specs, Timeline, Callout, Topics, Faq, Limits, FullStory, Next } from '../../../components/story';
import { getPortfolioContent } from '../../../lib/portfolio';
import { labPaths, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';

const { projects, projectDocuments } = await getPortfolioContent();
const project = projects.find((p) => p.locale === 'en' && p.translationKey === 'easymanager')!;
const next = projects.find((p) => p.locale === 'en' && p.translationKey === 'galaxy-trucker')!;
const document = projectDocuments.find((d) => d.data.locale === 'en' && d.data.translationKey === 'easymanager')!;
const { Content, headings } = await render(document);
const chapters = headings.filter((h) => h.depth === 2).length;
const repo = project.links[0]?.url;

// Le carte del dock seguono i capitoli della pagina: la barra in alto non serve più, il dock fa da indice.
const sections = [
	{ kicker: 'Chapter 1 of 6', value: 'Highlights', detail: { kicker: 'In short', value: '4 highlights' } },
	{ kicker: 'Chapter 2 of 6', value: 'How it works', detail: { kicker: 'Design', value: '3 decisions' } },
	{ kicker: 'Chapter 3 of 6', value: 'Screens', detail: { kicker: 'Stations', value: '3 iPads' } },
	{ kicker: 'Chapter 4 of 6', value: 'Numbers', detail: { kicker: 'Modules', value: `${project.outcomes[0]?.value ?? ''} in 0.1` } },
	{ kicker: 'Chapter 5 of 6', value: '2023 vs 2026', detail: { kicker: 'Eras', value: 'App → toolkit' } },
	{ kicker: 'Chapter 6 of 6', value: 'Full story', detail: { kicker: 'Chapters', value: `${chapters} to read` } },
];
---

<ExperimentLayout lang="en" title="EasyManager (preview)" currentHref={labProjectPath('en', project.slug)} sections={sections}
	itHref={labProjectPath('it', 'easymanager-operazioni-ristorante')} enHref={labProjectPath('en', project.slug)} noindex>
	<Story>
		<Hero eyebrow="iPad app · individual · 2023—2026" title="EasyManager"
			summary="A restaurant’s orders, from the table to the fiscal printer, on the iPads in the room."
			facts={[{ value: project.outcomes[0]?.value ?? '', label: 'Swift modules' }, { value: project.outcomes[1]?.value ?? '', label: 'dependencies' }, { value: '1', label: 'real restaurant' }]}
			actions={[{ label: 'Read the case study ↓', href: '#story', primary: true }, ...(repo ? [{ label: 'View the 2023 code', href: repo }] : [])]}
			image={withBase(project.coverImage)} imageAlt={project.coverAlt} />

		<Section id="highlights" title="The highlights." index={1}>
			<Highlights cards={[
				{ text: 'A real restaurant ran on it: counter, floor and kitchen.', meta: '2023 · Wape S.r.l', tone: 'blue' },
				{ text: 'It talks to a fiscal printer in XML over HTTP.', meta: 'Epson ePOS · SOAP', tone: 'dark' },
				{ text: 'Rebuilt as 31 Swift packages with zero dependencies.', meta: '2026 · Swift 6.3', tone: 'acid' },
				{ text: '“Uncertain” is an answer, not an error.', meta: 'Fiscal layer', tone: 'orange' },
			]} />
		</Section>

		<Statement>An order passes through <b>four pairs of hands</b> and <b>three devices</b>. The last step, a fiscal receipt, <b>can’t be undone with a tap.</b></Statement>

		<Section id="how" title="How it holds together." lead="Three decisions give the 2026 toolkit its shape." index={2}>
			<FeatureGrid tiles={[
				{ title: 'An order is a durable state machine.', text: 'A timeout keeps the uncertainty for the next step instead of silently retrying, which could print a duplicate receipt.', size: 'wide', chips: ['Draft', 'Sent', 'Acknowledged?', 'Reconciled'] },
				{ title: 'The fiscal layer may answer “uncertain”.', text: 'The request leaves, the reply may never come. Not knowing whether the printer printed is not the same as knowing it didn’t.', size: 'tall', tone: 'dark', glyph: '?' },
				{ title: 'Hardware is not just another API.', text: 'One lane per device serialises access with Swift Concurrency: two valid commands become unsafe when interleaved.', size: 'wide', tone: 'violet' },
			]} />
		</Section>

		<Section id="screens" title="Take a closer look." lead="One iPad per station. Every screen reads the same order in real time." index={3}>
			<Gallery shots={[
				{ title: 'Dining room', caption: 'DiningView · tables by state and waiter' },
				{ title: 'Order pad', caption: 'OrderSheetView · courses, variants, VAT' },
				{ title: 'Kitchen', caption: 'CookingView · dishes by course' },
			]} />
		</Section>

		<Section>
			<CodeSplit eyebrow="Deep dive · the fiscal printer" title="A receipt is an XML document, sent once."
				text="The app wraps each receipt in a SOAP envelope and posts it to the Epson printer in the room: one line per dish with its VAT department, one total per payment method."
				file="fpmate.cgi · request" language="XML"
				code={'<beginFiscalReceipt />\n<printRecItem description="Risotto"\n  quantity="2" unitPrice="14.00"\n  department="1" />\n<printRecTotal payment="Cash"\n  amount="28.00" />\n<endFiscalReceipt />'} />
		</Section>

		<Section title="Built in layers." lead="Feature code depends on narrow contracts, never on the app.">
			<Layers layers={[
				{ label: 'Features', items: ['Dining', 'Kitchen', 'Till'] },
				{ label: 'Contracts', items: ['Order domain', 'Device lanes', 'Fiscal layer'], tone: 'mixed' },
				{ label: 'Foundation', items: ['SQL persistence · DocC on every versioned API'], tone: 'dark' },
			]} />
		</Section>

		<Section id="numbers" title="By the numbers." tone="dark" index={4}>
			<Numbers items={project.outcomes} />
		</Section>

		<Section id="eras" title="Same problem. Two eras." center index={5}>
			<Compare columns={[
				{ title: '2023 · The app', items: ['SwiftUI with MVVM, six shared view models', 'Firestore snapshots keep every iPad in sync', 'Pre-bill, fiscal receipt, X and Z reports', 'Connection errors left to the operator'] },
				{ title: '2026 · The toolkit', items: ['Swift 6.3 packages separated by contract', 'SQL persistence at the boundary, DocC beside every API', 'Outbox, acknowledgement and reconciliation as phases', 'Uncertainty modelled as a domain value'] },
			]} />
		</Section>

		<Section title="How it got here.">
			<Timeline steps={[
				{ when: 'April 2023', title: 'Twenty commits', text: 'A SwiftUI app for a real restaurant: floor, kitchen, till, fiscal printer.' },
				{ when: '2023', title: 'Scope grows', text: 'Loyalty, reservations, shifts, inventory: the seams become visible.' },
				{ when: '2026', title: 'Re-engineering', text: 'Swift 6.3 packages separated by contract.' },
				{ when: '0.1.0', title: 'First release', text: '31 products documented and built, no remote dependencies.' },
			]} />
			<Callout kind="important">The 0.1 source isn’t public yet; the release facts on this page come from a verified checkout.</Callout>
		</Section>

		<Section title="My part.">
			<Specs specs={[
				{ label: 'Role', value: project.role },
				{ label: 'Team', value: 'Individual work' },
				{ label: 'Client', value: 'Wape S.r.l, a working restaurant' },
				{ label: 'Stack', value: project.technologies.join(' · ') },
			]} />
		</Section>

		<Section title="Questions you might ask.">
			<Faq items={[
				{ q: 'Did the restaurant actually use it?', a: 'The 2023 app was written for a real restaurant and its fiscal printer. Device compatibility and fiscal certification of the 2026 toolkit are not demonstrated yet.' },
				{ q: 'Why rebuild instead of fixing the app?', a: 'Six shared view models made local changes carry consequences elsewhere. The re-engineering draws boundaries around orders, devices and the fiscal layer.' },
				{ q: 'Can I read the code?', a: 'The 2023 application is public on GitHub. The 2026 source is not public yet.' },
			]} />
		</Section>

		<Limits proven={['The 2023 repository, readable in full', 'The 0.1 release facts, from a verified checkout']} notProven={['Physical-device compatibility', 'Fiscal certification', 'The unreleased 0.2 work']} />

		<Section title="Explore the work.">
			<Topics groups={[
				{ title: 'Code', links: repo ? [{ label: 'Original application (2023)', href: repo, note: 'My repository · github.com' }] : [] },
				{ title: 'Related projects', links: [{ label: next.title, href: labProjectPath('en', next.slug), note: 'Another system that has to agree across devices' }] },
			]} />
		</Section>

		<FullStory chapters={chapters} index={6}><Content components={{ a: LabContentLink, img: LabContentImage }} /></FullStory>

		<Next title={next.title} href={labProjectPath('en', next.slug)} image={withBase(next.coverImage)} />
	</Story>
</ExperimentLayout>
