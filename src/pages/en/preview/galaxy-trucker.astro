---
/**
 * Anteprima non elencata del racconto di Galaxy Trucker, costruita con le sezioni della seconda
 * serie come quella di PoliVerse. Il filo è una mossa sola, un giocatore che prende una tessera,
 * con tre promesse: decide il server, una volta sola, lo vedono tutti. Il materiale viene dal caso
 * di studio e dai due articoli collegati; le catture dei due client mancano ancora e lo dicono.
 * Fuori dalla sitemap, noindex.
 */
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import {
	Story, Section, AppHero, ProductShot, Statement, ObjectRow, LitText, ScrollIntro, PlusCards, HighlightsGallery,
	FeatureExplorer, MediaCards, Lockup, StickyScenes, ExplainerFigure, ExplodedStack, Contribution, Findings, Stats,
	ThenNow, Callout, StateMachine, Compare, Principles, Limits, TechSpecs, ChangeLog, Sources, Faq, Topics, KeepExploring,
} from '../../../components/story';
import { neighbours, previewCover } from '../../../lib/previews';
import { labPaths, labPostPath, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';

const repo = 'https://github.com/samuelesegrini/ing-sw-2025-segrini-terribile-varricchio-zanca';
const firstGame = labPostPath('en', 'my-first-video-game-was-a-distributed-system');
const rebuild = labPostPath('en', 'rebuilding-galaxy-trucker-with-claude');
const { next, previous } = neighbours('galaxy-trucker');

const sections = [
	{ kicker: 'Chapter 1 of 8', value: 'The problem', detail: { kicker: 'State', value: '4 kinds' } },
	{ kicker: 'Chapter 2 of 8', value: 'Three promises', detail: { kicker: 'In short', value: '4 highlights' } },
	{ kicker: 'Chapter 3 of 8', value: 'One match', detail: { kicker: 'Phases', value: '6' } },
	{ kicker: 'Chapter 4 of 8', value: 'The system', detail: { kicker: 'Events', value: '47' } },
	{ kicker: 'Chapter 5 of 8', value: 'My part', detail: { kicker: 'Commits', value: '121 of 314' } },
	{ kicker: 'Chapter 6 of 8', value: 'A year later', detail: { kicker: 'Days', value: '4' } },
	{ kicker: 'Chapter 7 of 8', value: 'Where it stands', detail: { kicker: 'Clean build', value: 'no' } },
	{ kicker: 'Chapter 8 of 8', value: 'Specs & FAQ', detail: { kicker: 'Tests', value: '63 classes' } },
];
---

<ExperimentLayout lang="en" title="Galaxy Trucker (preview)" currentHref="/en/preview/galaxy-trucker/" sections={sections} itHref={labProjectPath('it', 'galaxy-trucker-progetto-java')} enHref={withBase('/en/preview/galaxy-trucker/')} noindex>
	<Story>
		<AppHero name="Galaxy Trucker" title="A board game, as a distributed system." tint="violet"
			summary="Four of us turned Cranio Creations’ board game into a Java client-server system: one authoritative server, Socket and RMI in the same game, a terminal client and a JavaFX one. Final project of Software Engineering at Politecnico di Milano, 2024–2025."
			meta="Team of four · Java 23 · JavaFX · Socket / RMI · 2025"
			actions={[{ label: 'Read the story', href: '#problem' }, { label: 'Team repository', href: repo }]}>
			<ProductShot slot="shot" priority alt="Illustration: a spaceship built from square tiles joined by pipe connectors, with a laser, engines and an incoming meteor" src="/images/projects/covers/galaxy-trucker.svg" width={1200} height={800}
				captions={[{ title: 'Two clients', text: 'The same ship in the terminal and in JavaFX.', file: 'TUI · GUI' }, { title: 'Two transports', text: 'Socket and RMI in one game.', file: 'network adapters' }, { title: 'One server', text: 'The only place a move becomes real.', file: 'server/core' }]} />
		</AppHero>

		<Section id="problem" index={1}>
			<Statement>A rulebook <b>trusts the players</b> to remember context and correct each other. Software can’t: it needs <b>a decision for every boundary</b>, before the first screen.</Statement>
			<ObjectRow label="Four kinds of state, in one process" items={[
				{ name: 'The tile pool', text: 'Shared by everyone, drawn from at the same time.' },
				{ name: 'Table and hand', text: 'Each player’s ship is public; what they hold is not.' },
				{ name: 'The turn’s cards', text: 'Pirates, planets, meteors: each depends on whose turn it is.' },
				{ name: 'Games at once', text: 'Several matches living in one server.' },
			]} />
		</Section>

		<Section>
			<LitText eyebrow="Galaxy Trucker · The motive" tint="violet" text="I thought a game was rules and a screen. *It was a system first.*" />
		</Section>

		<ScrollIntro id="promises" index={2} tone="ink2" eyebrow="Galaxy Trucker" title="One match." dim="Every screen agrees." />

		<Section tone="ink2">
			<PlusCards label="The three promises" cards={[
				{ eyebrow: 'Promise 1', title: 'The server decides.', text: 'A client asks; only the authoritative server knows what is legal. No player’s screen is the truth.', tone: 'acid', detail: 'Every request is validated against the server’s state, never against the client’s idea of it.', links: [{ label: 'No screen is the truth', href: '#system' }] },
				{ eyebrow: 'Promise 2', title: 'Exactly once.', text: 'Every move is validated once and applied once. One tile drawn is one tile gone.', tone: 'blue', detail: 'Double draws were one of the last bugs fixed before submission.', links: [{ label: 'What only broke together', href: '#fixes' }] },
				{ eyebrow: 'Promise 3', title: 'Everyone sees it.', text: 'Socket or RMI, terminal or JavaFX: the change reaches every player as one event.', tone: 'orange', detail: 'The event is the only way a client learns that the world has changed.', links: [{ label: 'Two transports, two interfaces', href: '#transports' }] },
			]} />
			<HighlightsGallery interval={6000} cards={[
				{ lead: 'Build together.', text: 'Everyone draws from one pool at once. Two hands reach for a tile; one gets it, the other sees it go.', meta: 'Exactly once', name: 'Build together', tone: 'paper', layout: 'split', image: previewCover('galaxy-trucker'), imageAlt: 'Illustration: a ship of tiles with a meteor incoming' },
				{ lead: 'A meteor swarm resolves.', text: 'Shields up, an exposed connector loses a tile, and every ship updates at once.', meta: 'The server decides', name: 'A meteor swarm', tone: 'dark' },
				{ lead: 'Socket and RMI, in one game.', text: 'Two wires, one server. The protocol is a startup setting, not a fork in the code.', meta: 'Everyone sees it', name: 'Two transports', tone: 'violet' },
				{ lead: 'Two interfaces, one state.', text: 'The same ship drawn in text and in JavaFX, from the same event.', meta: 'Everyone sees it', name: 'Two interfaces', tone: 'orange' },
			]} />
		</Section>

		<Section id="match" eyebrow="Galaxy Trucker · A match in it" title="One match," dim="from lobby to score." index={3}>
			<FeatureExplorer label="Phases" device="mac" note="Captures of the JavaFX client to follow" features={[
				{ title: 'Lobby', tint: 'blue', text: 'Pick a game or start one: several matches live side by side on the same server.' },
				{ title: 'Construction', file: 'construction controller', tint: 'acid', text: 'Everyone draws components from the shared pool at once and mounts them, around forbidden positions and connector rules.' },
				{ title: 'Validation', tint: 'violet', text: 'The server checks every ship automatically before it may fly.' },
				{ title: 'Flight', file: 'AdventureCardVisitor · FlightBoard', tint: 'orange', text: 'Pirates, planets, meteor swarms, open space, war zones and epidemics change ships, crews, credits and positions.' },
			]} />
		</Section>

		<Section eyebrow="Galaxy Trucker · The rules" title="The rules," dim="that became code.">
			<MediaCards label="Rules the server enforces" items={[
				{ lead: 'Cannons and batteries.', text: 'Combat strength counts directional cannons, and batteries decide which ones fire.', tone: 'paper' },
				{ lead: 'Shields against meteors.', text: 'A meteor from one side is stopped only by a shield facing it.', tone: 'violet' },
				{ lead: 'Exposed connectors.', text: 'Every open connector on the hull is a place a hit can land.', tone: 'paper' },
				{ lead: 'Cabins for epidemics.', text: 'An epidemic spreads through connected cabins, so the ship’s shape decides who is hit.', tone: 'orange' },
				{ lead: 'No two ships in one place.', text: 'The flight board prevents collisions and works out the leader after every move.', tone: 'paper' },
				{ lead: 'A test flight, and games side by side.', text: 'The two advanced features the team chose on top of the full level II rules.', tone: 'acid' },
			]} />
		</Section>

		<Lockup id="system" index={4} number="04" label="The system" title="No screen" dim="is the truth."
			next={{ label: 'Next: one move, four steps', href: '#move' }}
			facts={[{ label: 'Request types', value: '31', note: '22 + 9 for flight' }, { label: 'Response types', value: '34' }, { label: 'Event types', value: '47', accent: true, note: '32 + 15 for flight' }]}
			factsNote="common/message, at submission">
			A move starts on a client, is validated against the server’s state, and comes back as a response to the player and <b>an event for everyone else</b>. The event is the only way a client learns that the world has changed.
		</Lockup>

		<Section id="move" split eyebrow="Galaxy Trucker · A move" title="One move," dim="four steps."
			lead="A player takes a tile. Here is everything that happens before the other three see it gone.">
			<StickyScenes device="none" label="One move, from click to every screen" steps={[
				{ title: 'The request leaves.', text: 'The client sends a self-contained command: who, which tile, in which game.', code: 'request → server', tint: 'blue' },
				{ title: 'The server checks it.', text: 'Against its own state: is the tile still in the pool, is it this player’s phase?', tint: 'violet' },
				{ title: 'It applies it once.', text: 'The tile leaves the pool and joins the player’s hand. Nowhere else can that happen.', tint: 'acid' },
				{ title: 'One answer, one event.', text: 'The player gets a response; the other three get an event, whatever transport and interface they use.', code: 'response → sender · event → everyone', tint: 'orange' },
			]} />
		</Section>

		<Section id="transports" split eyebrow="Galaxy Trucker · Transports" title="Two transports, two interfaces," dim="one game.">
			<ExplainerFigure image={withBase('/images/projects/explainers/galaxy-authoritative-server.svg')} imageAlt="Four clients with different interfaces connected to one central authoritative server"
				caption="TUI and GUI clients can use Socket or RMI in the same game. Every command converges on the authoritative server."
				notes={[
					{ title: 'Clients', text: 'A terminal client and a JavaFX client, in any mix.', at: [18, 30] },
					{ title: 'Adapters', text: 'SocketNetworkAdapter and RMINetworkAdapter on the client; SocketServerAdapter and RMIServerAdapter on the server.', at: [34, 60] },
					{ title: 'The server', text: 'One authoritative state per game, applied once.', at: [50, 50] },
				]}
				aside="The rest of the system sees one network interface: the protocol is a startup setting, not a fork in the code." />
		</Section>

		<Section tone="dark" split eyebrow="Galaxy Trucker · Architecture" title="server · common ·" dim="client."
			lead="The code is organised by role. The server owns the domain and coordination; common holds the protocol; the client only draws and asks.">
			<ExplodedStack layers={[
				{ name: 'client', tint: 'acid', chips: [{ label: 'TUI' }, { label: 'JavaFX GUI' }, { label: 'network adapters' }], text: 'Draws what the events say, and asks.' },
				{ name: 'common', tint: 'violet', chips: [{ label: 'requests' }, { label: 'responses' }, { label: 'events', accent: true }], text: 'The Command-pattern protocol both sides agree on.' },
				{ name: 'server/core', tint: 'blue', chips: [{ label: 'GameSessionManager' }, { label: 'PlayerSessionRegistry' }, { label: 'ConnectionMonitorService' }], text: 'Games, identities and heartbeats.' },
				{ name: 'model/domain', tint: 'paper', chips: [{ label: 'Ship' }, { label: 'FlightBoard' }, { label: 'AdventureCardVisitor' }], text: 'Ships, crews, cards and the board, with decks loaded from JSON.' },
			]} />
		</Section>

		<Section id="part" eyebrow="Galaxy Trucker · My part" title="121 of 314 commits." dim="Most of them behind the screen." index={5}>
			<Contribution total={314} period="February–July 2025"
				me={{ name: 'Samuele Segrini', initials: 'SS', count: 121, role: 'Developer', text: 'The initial package and model structure, the RMI transport, the command and event system, authentication, the heartbeat, the session registry for several games, the construction controller and the game-data loading.', tags: ['RMI', 'commands and events', 'sessions', 'heartbeat', 'construction'] }}
				others={[{ name: 'Manuela Terribile', initials: 'MT', tone: 'violet' }, { name: 'Alessandra Varricchio', initials: 'AV', tone: 'blue' }, { name: 'Diego Zanca', initials: 'DZ', tone: 'orange' }]}
				shared="Rules, interfaces, tests and delivery." note="These are my contributions, not a claim of authorship over the whole." />
		</Section>

		<Section id="fixes" split eyebrow="Galaxy Trucker · Integration" title="What only broke" dim="when it all ran together."
			lead="The final weeks of commits are almost all fix(…): the phase in which a distributed system shows errors no single class would have.">
			<Findings columns={['Severity', 'What broke', 'Where it showed', 'The fix']} note="Severity 1 breaks a promise in play; severity 2 breaks a screen or a rule." items={[
				{ severity: 1, title: 'Double draws.', text: 'A draw could be applied twice.', impact: { label: 'Construction, under load' }, fix: 'One draw, applied once on the server' },
				{ severity: 1, title: 'Listeners and serialisation.', text: 'The listener structure and message serialisation had to be reworked.', impact: { label: 'Between server and clients' }, fix: 'Listener structure and message serialisation reworked' },
				{ severity: 2, title: 'A player–ship cycle.', text: 'Player and ship depended on each other.', impact: { label: 'The model' }, fix: 'Circular dependency resolved' },
				{ severity: 2, title: 'Timers and colours.', text: 'Timers and player colours needed fixing late.', impact: { label: 'In play' }, fix: 'Fixed in the last weeks before submission' },
			]} />
		</Section>

		<Section id="rebuild" eyebrow="Galaxy Trucker · A year later" title="Alone, with Claude," dim="in four days." index={6}>
			<Stats items={[
				{ label: 'Then', value: '314', text: 'commits, four people, a semester', method: 'git history of main, February–July 2025', note: 1 },
				{ label: 'Now', value: '146', text: 'commits, one person, four days', method: 'the develop branch, August 2026', note: 2, accent: true },
				{ label: 'Client state', value: '~150', text: 'lines, down from 691', method: 'ClientState against LocalGameState', note: 3 },
				{ label: 'Benchmark', value: 'none', text: 'not blind, not controlled', method: 'same repository and documents', note: 4 },
			]}>
				I directed the milestones, judged the architectural proposals and verified behaviour against the published rules. <b>It was not a blind test</b>: documentation and code were available, and no prompt or time was measured.
			</Stats>
		</Section>

		<Section>
			<ThenNow title="Same requirements." dim="A different shape." baseline="The 2025 submission" baselineLabel="The 2026 rebuild, compared with" link={{ label: 'Read the rebuild essay', href: rebuild }} changes={[
				{ icon: 'list', title: 'One serialized queue of commands per game', was: 'handlers across several connections' },
				{ icon: 'swap', title: 'A full current view on reconnect', was: 'replaying every incremental event' },
				{ icon: 'package', title: 'A deeper Ship: place, validate, damage', was: 'callers navigating its grid' },
				{ icon: 'timeline', title: 'Card-specific resolution state machines', was: 'one large visitor' },
			]} />
			<Callout kind="warning" title="Fix before this page ships">The case study says the rebuilt client uses the server’s models directly; the rebuild essay says clients get immutable projections instead of model objects. The grid leaves that row out until the two agree.</Callout>
		</Section>

		<Section split eyebrow="Galaxy Trucker · Phases" title="Six phases," dim="and the move that is never legal."
			lead="Both designs converged here: lobby, construction, validation, crew, flight and scoring are states, and each one allows its own moves.">
			<StateMachine label="A match, phase by phase" forbidden="a move from outside its phase · never"
				before={[{ name: 'Lobby', text: 'Join or start a game.' }, { name: 'Construction', text: 'Draw and mount tiles.' }]}
				fork={[{ name: 'Valid ship', text: 'Crew placement, then flight.', tone: 'blue' }, { name: 'Invalid ship', text: 'Back to fixing it.', tone: 'orange' }]}
				after={[{ name: 'Scoring', text: 'Credits counted when the flight ends.', tone: 'dark' }]}
				labels={{ before: [['ready', 'server checks']], fork: ['passes', 'fails'], join: ['fly the cards', 'fix, then fly'] }} />
		</Section>

		<Section eyebrow="Galaxy Trucker · The client" title="691 lines," dim="or one refresh().">
			<Compare columns={[
				{ title: '2025 · LocalGameState', items: ['691 lines', 'A parallel copy of the game on the client', 'Fifteen conversion methods to keep it in step'] },
				{ title: '2026 · ClientState', items: ['About 150 lines', 'Receives the updated state from the server', 'Asks the views to refresh()'] },
			]} />
		</Section>

		<Section eyebrow="Galaxy Trucker · What I carry forward" title="Five rules," dim="each with its reason.">
			<Principles rules={[
				{ title: 'Write the invariant, and where it is enforced.', text: 'If the answer is “in several places”, the design is asking for trouble.', source: 'My first video game was a distributed system' },
				{ title: 'Integration before class design.', text: 'A command correct locally is not enough when it crosses the network.', source: 'Case study · What I carry forward' },
				{ title: 'Requirements as checkable statements.', text: 'Milestones with exit criteria turn plausible code into code judged by behaviour.', source: 'Rebuilding Galaxy Trucker with Claude' },
				{ title: 'A test covers the rule, not the code just written.', text: 'A passing test that mirrors the implementation proves nothing about the game.', source: 'Rebuilding Galaxy Trucker with Claude' },
				{ title: 'The accelerator is a collaborator; the result stays mine.', text: 'An agent moves fast through a documented system; judgement and scope stay human.', source: 'Case study · One year later' },
			]} />
		</Section>

		<Limits title="Finished, and not reproducible." dim="Both are true." proven={[
			{ text: 'The academic scope, completed and graded', source: 'Software Engineering 2024–2025, group GC26' },
			{ text: '272 source files and 63 JUnit 5 test classes with Mockito', source: 'src/test/java at submission', href: repo },
			{ text: 'The delivered JARs and the protocol documentation', source: 'deliverables/' },
			{ text: 'The 2026 rebuild', source: 'develop branch · 146 commits' },
		]} notProven={[
			{ text: 'A clean build of main', source: 'ClientApp imports newGUI and newUI; only newTUI is in the tree' },
			{ text: 'A measured speed-up from the rebuild', source: 'No frozen protocol, prompts or time split' },
		]} />

		<Section id="specs" tone="sand" index={7}>
			<TechSpecs eyebrow="Galaxy Trucker" meta="Java 23 · JavaFX · Maven · Socket / RMI · JUnit 5 · 2025" groups={[
				{ title: 'The game', items: [{ title: 'Full level II rules', text: 'Construction and flight, with automatic ship validation.' }, { title: 'Advanced features', text: 'The test flight, and simultaneous games on one server.' }] },
				{ title: 'Protocol', counts: [{ value: '31', label: 'request types' }, { value: '34', label: 'responses' }, { value: '47', label: 'events', accent: true }], note: 'Java serialisation carries the messages; Jackson loads configuration and decks.' },
				{ title: 'Team', values: [{ label: 'People', value: '4' }, { label: 'My commits', value: '121 of 314' }, { label: 'Course', value: 'Software Engineering', text: 'Politecnico di Milano, 2024–2025' }] },
				{ title: 'Verification', lead: '63 JUnit 5 test classes', tags: ['Mockito', 'rules', 'ship validation', 'protocol'] },
			]} />
		</Section>

		<Section tone="sand" eyebrow="Galaxy Trucker · How it got here" title="From a board game" dim="to a system, twice.">
			<ChangeLog columns={['When', 'What', 'Changes']} releases={[
				{ version: 'Aug 2026', when: 'Rebuild', changes: [{ kind: 'changed', text: '146 commits in four days on develop, alone, with Claude.' }, { kind: 'note', text: 'Two essays: the first game, and the rebuild.' }] },
				{ version: 'Jul 2025', when: 'Submission', changes: [{ kind: 'fixed', text: 'Double draws, the player–ship cycle, listeners, timers and colours.' }, { kind: 'note', text: 'Completed and graded.' }] },
				{ version: 'Feb 2025', when: 'Start', style: 'outline', changes: [{ kind: 'added', text: 'Package and model structure, then RMI, commands and events.' }] },
			]} />
		</Section>

		<Section tone="sand">
			<Sources eyebrow="Galaxy Trucker" checked="26 September 2026" lead="Every number on the page carries a superscript that lands here." notes={[
				{ title: '314 commits', text: 'Every commit on main, February–July 2025; 121 of them mine.', source: 'git history of the team repository', href: repo },
				{ title: '146 commits in four days', text: 'The develop branch, August 2026.', source: 'git history of develop', href: repo },
				{ title: '691 and ~150 lines', text: 'LocalGameState against ClientState.', source: 'SIMPLE-DIRECT-MODEL-ARCHITECTURE.md' },
				{ title: 'Not a benchmark', text: 'Same repository, documents available, no frozen protocol.', source: 'Rebuilding Galaxy Trucker with Claude', href: rebuild },
			]} />
		</Section>

		<Section id="faq" tone="sand">
			<Faq eyebrow="Galaxy Trucker" title="Questions," dim="answered." open={0} lead="The ones a reviewer asks first." contact={{ label: 'Ask about this project', href: 'mailto:samuele.segrini@gmail.com' }} items={[
				{ q: 'Why not fix the build?', a: 'Changing the shared artifact would make the story cleaner and less accurate. The defect stays visible, next to the scope we delivered.' },
				{ q: 'Which parts are yours?', a: '121 of the 314 commits: RMI, commands and events, sign-in, heartbeat, sessions, the construction controller and game data. Rules, interfaces, tests and delivery were shared.' },
				{ q: 'Was the rebuild a blind test?', a: 'No. The requirements, documents and code were available to Claude, so it shows how an agent uses explicit constraints, not that it rediscovered the design.' },
				{ q: 'Was it faster with Claude?', a: 'The loop was faster where requirements and tests were precise. Without a controlled protocol, how much faster is not something the page can claim.' },
			]} />
		</Section>

		<Section tone="sand">
			<Topics groups={[
				{ title: 'Read more', links: [{ label: 'My first video game was a distributed system', href: firstGame, note: 'The personal account' }, { label: 'Rebuilding Galaxy Trucker with Claude', href: rebuild, note: 'What changed, and how to measure it' }] },
				{ title: 'Code', links: [{ label: 'Team repository', href: repo, note: 'github.com' }] },
			]} />
		</Section>

		<Section tone="sand">
			<KeepExploring next={next} previous={previous}
				all={{ label: 'The archive', title: 'All projects', text: 'Apps, packages, hardware and research, in one list.', href: labPaths.en.work }} />
		</Section>
	</Story>
</ExperimentLayout>

