---
/**
 * Anteprima non elencata di Highway Route Planner. Un progetto piccolo e diretto ha una pagina
 * piccola e diretta: niente promesse né carte, un'affermazione sola e sei sezioni lette come una
 * breve relazione tecnica, con DocHero in apertura, poi specifica, modello, figura annotata, codice a passi, pareggio e costi. Il codice è una traccia ricostruita dal caso di
 * studio, dichiarata come tale finché non c'è il sorgente. Fuori dalla sitemap, noindex.
 */
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import {
	Story, Section, DocHero, Specs, Layers, Callout, ExplainerFigure, CodeSteps, Compare, Numbers, TechSpecs, KeepExploring,
} from '../../../components/story';
import { neighbours } from '../../../lib/previews';
import { labPaths, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';

const { next, previous } = neighbours('highway-route-planner');

// Una traccia di findOptimalPath ricostruita dal caso di studio: non è il sorgente originale.
const outline = `/* Outline of findOptimalPath, rebuilt from the case study */
int step = (to > from) ? +1 : -1;

for (int i = from; i != to; i += step) {
    if (moves[i] == UNREACHED) continue;
    for (int j = i + step; j != to + step; j += step) {
        if (!fleetReaches(i, j)) break;
        int m = moves[i] + 1;
        if (m < moves[j] ||
            (m == moves[j] && dist(i) < dist(prev[j]))) {
            moves[j] = m;
            prev[j] = i;
        }
    }
}

for (int k = to; k != from; k = prev[k]) push(route, k);
printReversed(route, from);`;

const sections = [
	{ kicker: 'Section 1 of 5', value: 'The problem', detail: { kicker: 'Constraints', value: '5' } },
	{ kicker: 'Section 2 of 5', value: 'The model', detail: { kicker: 'Lookup', value: 'binary search' } },
	{ kicker: 'Section 3 of 5', value: 'The graph', detail: { kicker: 'Built', value: 'never' } },
	{ kicker: 'Section 4 of 5', value: 'The tie', detail: { kicker: 'Right answers', value: '1' } },
	{ kicker: 'Section 5 of 5', value: 'The cost', detail: { kicker: 'Time', value: 'O(n²·v)' } },
];
---

<ExperimentLayout lang="en" title="Highway Route Planner (preview)" currentHref="/en/preview/highway-route-planner/" sections={sections} itHref={labProjectPath('it', 'pianificatore-percorsi-autostradali')} enHref={withBase('/en/preview/highway-route-planner/')} noindex>
	<Story>
		<DocHero eyebrow="Algorithms and Data Structures · 2022–2023" title="Highway Route Planner"
			abstract="A C program that plans the fewest-stop journey along a highway, in either direction, while stations are built and demolished and fleets change. The fewest stops, and never an arbitrary one: when routes tie, the specification names the right answer."
			note={{ label: 'Method', text: 'Individual final assignment. One ordered array, binary search, and a graph that is never built.' }}
			image={withBase('/images/projects/covers/highway-route-planner.svg')} imageAlt="A route jumping over unnecessary stations along a highway, from first to last in the fewest stops"
			caption="The route skips every station it can; which ones, when two routes tie, is decided by the specification."
			facts={[{ value: 'C', label: 'language', icon: 'code' }, { value: '5', label: 'commands', icon: 'list' }, { value: '512', label: 'vehicles per station, at most', icon: 'layers' }, { value: 'O(n²·v)', label: 'route planning, worst case', icon: 'gauge' }]} />

		<Section id="problem" index={1} split eyebrow="Highway Route Planner · The specification" title="Fewest stops." dim="And five rules around them."
			lead="A highway is a sequence of service stations, each identified by its distance from the start and holding a fleet of electric vehicles. Stations are built and demolished, vehicles added and scrapped, and journeys planned on whatever the highway is now.">
			<Specs specs={[
				{ label: 'Direction', value: 'A journey never turns back' },
				{ label: 'Vehicles', value: 'A new one rented at every stop' },
				{ label: 'Fleet', value: 'Up to 512 vehicles per station, each with its own range' },
				{ label: 'Goal', value: 'The fewest possible stops' },
				{ label: 'Ties', value: 'One right answer, named by the specification' },
			]} />
		</Section>

		<Section id="model" split eyebrow="Highway Route Planner · The model" title="An ordered array" dim="is the whole index." index={2}
			lead="A vehicle is its range; a station is its distance, its vehicle count and a pointer to its fleet; the highway is a dynamic array of stations kept in ascending distance.">
			<Layers layers={[
				{ label: 'Highway', items: ['dynamic array of stations, sorted by distance'], tone: 'dark' },
				{ label: 'Station', items: ['distance', 'vehicle count', 'fleet pointer'], tone: 'mixed' },
				{ label: 'Vehicle', items: ['driving range'] },
			]} />
			<Callout kind="important" title="The invariant">Stations stay in ascending distance. That is what lets findStationIndexByDistance use binary search, and what makes both directions a plain walk along the array. malloc, realloc, free and memmove keep it true across inserts and removals.</Callout>
		</Section>

		<Section split eyebrow="Highway Route Planner · Route planning" title="The graph is never built." dim="Each edge is checked when needed."
			lead="Stations are nodes; a move exists when at least one vehicle in the departure fleet has the range for it. The highlighted path reaches 50 in the fewest stops.">
			<ExplainerFigure image={withBase('/images/projects/explainers/highway-implicit-graph.svg')} imageAlt="Five highway stations connected by reachability arcs, with the minimum route 20, 30, 50 highlighted"
				caption="Fig. 2 · Stations at distance 20, 30, 40, 45 and 50" legend={[{ label: 'Possible move', mark: 'line' }, { label: 'Chosen route', mark: 'route' }]}
				aside="Worst case O(n² · v), with v ≤ 512 vehicles per station." notes={[
					{ title: 'Stations stay an ordered array.', text: 'Sorted by distance, so every lookup is a binary search.', at: [52.5, 72.5] },
					{ title: 'A move exists only if a car can make it.', text: 'Distance is compared with the ranges in the departure fleet, on demand.', at: [71.2, 32.3] },
					{ title: 'Two arrays remember the way back.', text: 'Minimum moves and the chosen predecessor, updated in travel order.', at: [22.5, 34.9] },
					{ title: 'Ties go to the station nearer the start.', text: 'So 20 → 30 → 50 wins over 20 → 45 → 50, as the specification requires.', at: [90, 78.4] },
				]} />
		</Section>

		<Section id="graph" eyebrow="Highway Route Planner · The heart" title="findOptimalPath," dim="in four steps." index={3}>
			<CodeSteps file="findOptimalPath · outline" lang="c" label="findOptimalPath, in four steps" code={outline}
				note="An outline rebuilt from the case study, not the original source."
				steps={[
					{ title: 'Pick the direction.', text: '+1 when the destination is farther along the highway, −1 when travelling back towards its start.', lines: [2] },
					{ title: 'Test a move against the fleet.', text: 'An edge exists only when a vehicle at the departure station has the range for it. Nothing is stored.', lines: [4, 5, 6, 7] },
					{ title: 'Keep the fewest moves, and the predecessor.', text: 'Two arrays: minimum moves and chosen predecessor. On a tie, the lower distance wins.', lines: [8, 9, 10, 11, 12, 13] },
					{ title: 'Walk back, then print forward.', text: 'The destination is traced through its predecessors and printed from origin to destination.', lines: [17, 18] },
				]}>
			</CodeSteps>
		</Section>

		<Section id="tie" eyebrow="Highway Route Planner · Tied routes" title="Same stops." dim="One right answer." index={4}
			lead="Working backwards from a shared ending, the specification keeps the route whose station is closer to the start of the highway. Distance from the start, not the direction of travel.">
			<Compare columns={[
				{ title: 'Also two stops, rejected', items: ['20 → 45 → 50', 'Ties with the winner on stops', '45 is farther from the start than 30'] },
				{ title: 'The one the rule keeps', items: ['20 → 30 → 50', 'And on the way back: 50 → 30 → 20', 'The lower distance wins every tie'] },
			]} />
		</Section>

		<Section id="cost" split tone="dark" eyebrow="Highway Route Planner · Trade-offs" title="What it costs," dim="and what I’d change." index={5}
			lead="Planning compares pairs of stations and may scan the departure fleet for each move. The solution favours a direct, readable representation over the cleverest structure.">
			<Numbers items={[
				{ value: 'O(n²·v)', label: 'route planning, worst case', method: 'pairs of stations, each scanning the departure fleet' },
				{ value: 'O(log n)', label: 'station lookup', method: 'binary search on the ordered array' },
				{ value: 'O(n)', label: 'memory', method: 'moves, predecessors and the rebuilt route' },
			]} />
		</Section>

		<Section>
			<Callout kind="tip" title="What I’d change today">Separate parsing from domain logic; handle allocation failures the same way everywhere; isolate tie-breaking in one function; test reverse and unreachable routes; cache each station’s maximum range so reachability doesn’t scan a whole fleet.</Callout>
		</Section>

		<Section id="specs" tone="sand">
			<TechSpecs eyebrow="Highway Route Planner" meta="C · dynamic memory · binary search · 2023" groups={[
				{ title: 'Project', values: [{ label: 'Course', value: 'Algorithms and Data Structures', text: '2022–2023 final assignment' }, { label: 'Work', value: 'Individual' }] },
				{ title: 'Commands', lead: 'Five, on a mutable highway', tags: ['build a station', 'demolish a station', 'add a vehicle', 'scrap a vehicle', 'plan a route'] },
				{ title: 'Source', items: [{ title: 'Not linked yet', text: 'Link the repository here, or say it isn’t public.' }] },
			]} />
		</Section>

		<Section tone="sand">
			<KeepExploring next={next} previous={previous}
				all={{ label: 'The archive', title: 'All projects', text: 'Apps, packages, hardware and research, in one list.', href: labPaths.en.work }} />
		</Section>
	</Story>
</ExperimentLayout>
