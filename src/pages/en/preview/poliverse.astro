	.pv-idcard { position: relative; display: grid; align-content: end; gap: 6px; width: 70%; aspect-ratio: 1.58; padding: 12px; border-radius: 10px; background: #cdefff; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-idcard i { position: absolute; left: 12px; top: 12px; width: 22%; height: 22%; border-radius: 4px; background: #e3b84c; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-idcard span { height: 5px; border-radius: 3px; background: #171713; } .pv-idcard span + span { width: 60%; background: #8b877f; }
	.pv-waves { display: flex; gap: 5px; }
	.pv-waves i { width: 8px; height: 8px; border-radius: 50%; background: #171713; opacity: .25; } .pv-waves i + i { opacity: .5; } .pv-waves i + i + i { opacity: .8; }
	.pv-pin { display: flex; gap: 7px; }
	.pv-pin i { width: 12px; height: 12px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px #171713; } .pv-pin i.on { background: #171713; }
	.pv-toast { display: flex; align-items: center; gap: 8px; align-self: center; margin-bottom: 4px; padding: 9px 14px; border-radius: 999px; background: #171713; color: #fffef9; font-size: 11px; font-weight: 600; }
	.pv-toast i { width: 8px; height: 8px; border-radius: 50%; background: #c7ff9f; }
	/* il resto dei quattro schermi dell'accesso: le credenziali sotto SPID e CIE, il tastierino del PIN, l'orario e le schede */
	.pv-or { align-self: center; margin-top: 4px; font-size: 10.5px; color: #5e5a53; }
	.pv-input { display: flex; align-items: center; height: 38px; padding: 0 14px; border-radius: 12px; background: #fffefb; box-shadow: inset 0 0 0 1px #c9c4b8; color: #6f6a61; font-size: 12px; }
	.pv-choice.quiet { height: 40px; background: #e2dfd5; box-shadow: none; color: #5e5a53; }
	.pv-keypad { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; width: 78%; margin-top: auto; }
	.pv-keypad i { display: grid; place-items: center; height: 40px; border-radius: 50%; background: #f4f1e9; font-style: normal; font-size: 17px; font-weight: 600; }
	.pv-keypad i.blank { background: none; }
	.pv-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: auto -7% -6%; padding: 10px 6px 14px; border-top: 1px solid #d6d1c4; background: #fffefb; }
	.pv-tabs i { font-style: normal; font-size: 10px; font-weight: 600; text-align: center; color: #5e5a53; }
	.pv-tabs i.on { color: #171713; font-weight: 800; }

	/* Il contrasto: la stessa carta del corso in modalità scura, etichetta bianca o quasi nera. Il
	   testo dell'etichetta sta nel CSS: è un esempio voluto di contrasto insufficiente, non un testo. */
	.pv-ba { margin-top: clamp(56px, 7vw, 96px); }
	.pv-contrast { display: grid; place-items: center; width: 100%; min-height: 360px; padding: 32px 0; background: #000; }
	/* la carta è centrata: il taglio passa in mezzo all'etichetta, metà bianca e metà quasi nera */
	.pv-contrast-card { display: grid; justify-items: center; gap: 10px; width: min(420px, 84%); padding: 30px 28px; border-radius: 26px; background: #1c1c1e; color: #f4f1e9; text-align: center; }
	.pv-contrast-card .st-mono { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #a9a59b; }
	.pv-contrast-card b { font-size: 22px; letter-spacing: -.03em; }
	.pv-contrast-card .pill { margin-top: 10px; padding: 14px 44px; border-radius: 999px; background: #6badf0; font-size: 17px; font-weight: 700; }
	.pv-contrast-card .pill::before { content: 'Apri il corso'; }
	.pv-contrast-card .pill.white { color: #fff; }
	.pv-contrast-card .pill.black { color: #141414; }

	/* Flavor: un colore diventa la tavolozza, poi la rampa. */
	.pv-flavor { display: grid; gap: 28px; margin: 0; }
	.pv-flavor-row { display: flex; align-items: stretch; justify-content: center; gap: 14px; flex-wrap: wrap; }
	.pv-swatch { display: grid; grid-template-columns: 56px 1fr; column-gap: 14px; align-items: center; min-width: 220px; padding: 14px; border-radius: 22px; background: var(--st-card); box-shadow: inset 0 0 0 1px var(--st-rule); text-align: left; }
	.pv-swatch i { grid-row: 1 / 4; width: 56px; height: 56px; border-radius: 16px; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .2); }
	.pv-swatch b { font-size: 16px; } .pv-swatch .st-mono { font-size: 12px; color: var(--st-muted); } .pv-swatch em { font-style: normal; font-size: 12px; color: var(--st-meta); }
	.pv-arrow { align-self: center; font-size: 22px; color: var(--st-muted); }
	.pv-ramp { display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; margin: 0; padding: 0; list-style: none; }
	.pv-ramp li { display: grid; align-items: end; min-height: 96px; padding: 10px; border-radius: 14px; }
	.pv-ramp .st-mono { font-size: 11px; color: #fff; }
	.pv-flavor figcaption { max-width: 720px; margin: 0 auto; font-size: 16px; line-height: 1.5; color: var(--st-meta); text-wrap: pretty; }
	.pv-flavor figcaption b { color: var(--st-fg); }

	@media (max-width: 720px) {
		.pv-ramp { grid-template-columns: repeat(4, 1fr); }
		.pv-ramp li { min-height: 64px; }
		.pv-arrow { display: none; }
		.pv-swatch { min-width: 0; width: 100%; }
	}
</style>

