	.pv-room b { font: 700 13px var(--mono); } .pv-room span { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; }
	.pv-day { position: relative; height: 8px; margin: -2px 4px 2px; border-radius: 4px; background: #c7ff9f; box-shadow: inset 0 0 0 1px rgba(23, 23, 19, .35); overflow: hidden; }
	.pv-day i { position: absolute; top: 0; bottom: 0; background: #b4b0a6; }
	.pv-group { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; padding: 9px 10px; border-radius: 12px; box-shadow: inset 0 0 0 1.5px rgba(23, 23, 19, .25); }
