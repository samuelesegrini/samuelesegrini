---
/**
 * Anteprima non elencata del racconto di PoliVerse, costruita solo con le sezioni della seconda
 * serie. I numeri vengono dal repository (commit e983281); le schermate sono illustrazioni
 * dichiarate, da sostituire con catture vere. Fuori dalla sitemap, noindex.
 */
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import {
	Story, Section, Device, AppHero, Lockup, HighlightsGallery, FeatureExplorer, Stats, CodeSteps, StateMachine,
	ExplodedStack, TechSpecs, Limits, Declaration, Faq, KeepExploring, PageIndex,
} from '../../../components/story';
import { labPaths, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';

const repo = 'https://github.com/samuelesegrini/PoliVerse';
const icon = withBase('/images/projects/poliverse-icon.svg');
const cover = (name: string) => withBase(`/images/projects/covers/${name}.svg`);

const sections = [
	{ kicker: 'Chapter 1 of 6', value: 'Highlights', detail: { kicker: 'In short', value: '5 highlights' } },
	{ kicker: 'Chapter 2 of 6', value: 'The app', detail: { kicker: 'Tabs', value: 'Today · Courses · Career · Search' } },
	{ kicker: 'Chapter 3 of 6', value: 'Numbers', detail: { kicker: 'Unit tests', value: '1,220' } },
	{ kicker: 'Chapter 4 of 6', value: 'Engineering', detail: { kicker: 'Layers', value: '4 pulled apart' } },
	{ kicker: 'Chapter 5 of 6', value: 'Specs & limits', detail: { kicker: 'Dependencies', value: 'none' } },
	{ kicker: 'Chapter 6 of 6', value: 'Questions', detail: { kicker: 'Answers', value: '4' } },
];

const cieFlow = `web view sees  https://ios.idserver.servizicie.interno.gov.it/…&nextUrl=…
     ↓ cancel
we open        CIEID://https://ios.idserver…&sourceApp=one.wape.PoliVerse
     ↓ student taps the card and enters the PIN
CieID opens    one.wape.PoliVerse://https://idserver.servizicie.interno.gov.it/…
     ↓ onOpenURL → CieIDRouter
we strip to    https://idserver.servizicie.interno.gov.it/…
     ↓ load into the same web view, which holds the session
login continues`;
---

<ExperimentLayout lang="en" title="PoliVerse (preview)" currentHref="/en/preview/poliverse/" sections={sections} itHref={labPaths.it.home} enHref={labPaths.en.home} noindex>
	<Story>
		<AppHero name="PoliVerse" title="Your whole Politecnico, in one app." tint="blue"
			summary="An unofficial SwiftUI client for Politecnico di Milano students: timetable, career, courses, WeBeep materials, rooms and campus, on iPhone, iPad, widgets and Apple Watch — and it works offline."
			meta="Individual work · iOS 27, Swift 6 · September 2026"
			actions={[{ label: 'Read the story', href: '#highlights' }, { label: 'Source on GitHub', href: repo }]}>
			<img slot="mark" src={icon} alt="" width="104" height="104" class="pv-mark" />
			<Fragment slot="devices">
				<Device kind="iphone">
					<div class="pv-today" role="img" aria-label="Illustration of the Today tab: the next lecture, the day's timetable and the next exam">
						<span class="pv-status st-mono">9:41</span>
						<b class="pv-h">Today</b>
						<span class="pv-card now"><span class="st-mono">Now · 10:15</span><b>Software Engineering</b><span>Room 3.1.2 · Leonardo</span></span>
						<span class="pv-row"><i class="violet"></i><span><b>Computer Networks</b><span>12:15 · T.2.1</span></span></span>
						<span class="pv-row"><i class="orange"></i><span><b>Human–Computer Interaction</b><span>14:15 · B.4.2</span></span></span>
						<span class="pv-card exam"><span class="st-mono">Next exam · in 12 days</span><b>Probability</b></span>
						<span class="pv-tabs"><i class="on">Today</i><i>Courses</i><i>Career</i><i>Search</i></span>
					</div>
				</Device>
				<div class="st-ahero-side">
					<Device kind="watch">
						<div class="pv-watch"><span class="st-mono">Next lecture</span><b>Networks</b><span>12:15 · T.2.1</span></div>
					</Device>
					<span class="st-mono">On the wrist: today's lectures and the next exam, sent from the phone.</span>
				</div>
			</Fragment>
		</AppHero>

		<Section id="highlights" tone="ink2" title="The highlights." link={{ label: 'Browse the source', href: repo }} index={1}>
			<HighlightsGallery cards={[
				{ text: 'The Politecnico has no public API. PoliVerse reads the same config the official app does.', meta: 'Service directory · 2026', name: 'No public API', tone: 'blue' },
				{ text: '“Entra con CIE” comes back to the app, not to Safari.', meta: 'CieID hand-off · sourceApp', name: 'CIE login', tone: 'dark' },
				{ text: 'Opens with content, even offline. A failed refresh never clears the screen.', meta: 'Store · offline copy', name: 'Offline first', tone: 'acid' },
				{ text: 'It reads, and never writes: no enrolling, no refusing a mark.', meta: 'Decision · 22 September 2026', name: 'Read-only on purpose', tone: 'orange' },
				{ text: 'Widgets, a Live Activity, controls and a Watch app share one offline store.', meta: 'App group · Shared types', name: 'Outside the app', tone: 'violet' },
			]}>
				<div slot="media-1" class="pv-json st-mono" aria-hidden="true">
					<span>GET …/polimi_app/rest/jaf/public/props → 200</span>
					<span>"iae.base_url": "https://api.polimi.it/iae"</span>
					<span>"libretto.base_url": "…/piano_studente"</span>
					<span>"ws_aule.base_url": "…/ws_aule"</span>
				</div>
				<ol slot="media-2" class="pv-steps st-mono" aria-label="The CIE hand-off in four steps">
					<li>intercept the CieID link</li><li>re-open it with sourceApp</li><li>card + PIN in CieID</li><li class="ok">back in PoliVerse</li>
				</ol>
				<ol slot="media-4" class="pv-nope" aria-label="Actions the app does not perform">
					<li>Enrol in a sitting</li><li>Refuse a mark</li><li>Post in a forum</li><li>Hand in an assignment</li>
				</ol>
			</HighlightsGallery>
		</Section>

		<Section id="app" eyebrow="PoliVerse · Take a closer look" title="Four tabs." dim="Everything a semester needs." index={2}>
			<FeatureExplorer label="Tabs" device="iphone" note="Illustration · screenshots to replace" features={[
				{ title: 'Today', file: 'Features/Calendar', tint: 'blue', text: 'The next lecture with its room, the rest of the day, and the next exam. The same data feeds the widgets and the Watch.' },
				{ title: 'Courses', file: 'Features/WeBeep', tint: 'acid', text: 'Every course of the year with its WeBeep materials, recordings and teachers, cached so it opens instantly.' },
				{ title: 'Career', file: 'Features/Career', tint: 'violet', text: 'The libretto, exam sittings and the study plan, with averages computed from the marks you actually have.' },
				{ title: 'Search', file: 'Features/Search', tint: 'orange', text: 'One field across courses, agenda and exam sittings, plus free rooms, the campus map, news and notices.' },
			]}>
				<div slot="screen-1" class="pv-screen" role="img" aria-label="Illustration: Today"><b class="pv-h">Today</b><span class="pv-card now"><span class="st-mono">Now</span><b>Software Engineering</b><span>Room 3.1.2</span></span><span class="pv-row"><i class="violet"></i><span><b>Computer Networks</b><span>12:15</span></span></span><span class="pv-row"><i class="orange"></i><span><b>HCI</b><span>14:15</span></span></span></div>
				<div slot="screen-2" class="pv-screen" role="img" aria-label="Illustration: Courses"><b class="pv-h">Courses</b>{['acid', 'blue', 'violet', 'orange'].map((t) => <span class={`pv-course tone-${t}`}><i></i><i></i></span>)}</div>
				<div slot="screen-3" class="pv-screen" role="img" aria-label="Illustration: Career"><b class="pv-h">Career</b><span class="pv-avg"><b>27.4</b><span>weighted average · sample data</span></span>{[30, 28, 26, 27].map((m) => <span class="pv-mark-row"><i></i><b class="st-mono">{m}</b></span>)}</div>
				<div slot="screen-4" class="pv-screen" role="img" aria-label="Illustration: Search"><b class="pv-h">Search</b><span class="pv-field">Networks</span><span class="pv-row"><i class="violet"></i><span><b>Computer Networks</b><span>Course</span></span></span><span class="pv-row"><i class="blue"></i><span><b>Free rooms now</b><span>12 on Leonardo</span></span></span></div>
			</FeatureExplorer>
		</Section>

		<Section id="numbers" tone="dark" eyebrow="PoliVerse · The repository" title="Two weeks, one person." dim="Counted, not estimated." index={3}>
			<Stats items={[
				{ label: 'Commits', value: '309', text: 'from 10 to 24 September 2026', method: 'git rev-list on main, all mine', accent: true },
				{ label: 'Unit tests', value: '1,220', text: 'plus 49 UI tests', method: '@Test functions in PoliVerseTests' },
				{ label: 'Swift', value: '89.6', unit: 'k', text: 'lines in 460 files', method: 'app, widgets, Watch and tests' },
				{ label: 'Dependencies', value: '0', text: 'third-party packages', method: 'Apple frameworks only' },
			]} feature={{ label: 'Feature areas', value: '17', text: 'one folder each, from Auth to WeBeep' }}>
				Every <b>Source must supply sample data</b>, derived from one fictional degree so career, timetable and courses agree. The whole app renders without an account, and <b>a screenshot taken in that mode is never mistaken for a real career</b>.
			</Stats>
		</Section>

		<Lockup id="cie" index={4} number="04" label="Signing in" title="CieID doesn’t know who called it." dim="So we tell it."
			deepDive="Deep dive: why the web view must never follow the link" next={{ label: 'Next: the data layer', href: '#data' }}>
			Inside a plain web view, <b>CieID returns the authenticated session to Safari</b> and the login is lost. PoliVerse intercepts the hand-off before the web view follows it, and re-opens it with <b>a sourceApp that brings the student back</b>.
			<Fragment slot="deep-dive"><p>Allow the navigation even once and the hand-off happens without <code>sourceApp</code>, so the return goes to Safari. Both logins, PoliMi OAuth and WeBeep, run on the same <code>AuthWebView</code>, so the handling exists once.</p></Fragment>
		</Lockup>

		<Section eyebrow="PoliVerse · Walkthrough" title="The CIE hand-off," dim="one step at a time.">
			<CodeSteps file="docs/cie-login.md · the flow" code={cieFlow} lang="txt" meta={[{ label: '4 steps', icon: 'lines' }, { label: 'CieIDBridge', icon: 'code' }, { label: 'Card + PIN', icon: 'lock' }]} steps={[
				{ title: 'Catch the link.', text: 'The login page navigates to the CIE identity provider; the web view sees it first.', lines: '1-2' },
				{ title: 'Re-open it with sourceApp.', text: 'The navigation is cancelled and opened in CieID with the app’s URL scheme attached.', lines: '3-4' },
				{ title: 'Come back to the app.', text: 'CieID returns to PoliVerse, and CieIDRouter carries the URL from onOpenURL to the live web view.', lines: '5-6' },
				{ title: 'Finish in the same web view.', text: 'The URL is stripped and loaded where the session lives, so the login simply continues.', lines: '7-9' },
			]} />
		</Section>

		<Section id="data" split eyebrow="PoliVerse · The data layer" title="A stale answer with a date" dim="says more than an empty screen."
			lead="Every Store publishes its cached copy on the first frame, then decides whether a refresh is due. When the refresh fails, what is on screen stays, and the failure is shown beside it.">
			<StateMachine label="A load through a Store" forbidden="clear the screen · never"
				before={[{ name: 'Cached', text: 'The offline copy is published at once.' }, { name: 'Refreshing', text: 'The load window says a fetch is due.' }]}
				fork={[{ name: 'Fresh', text: 'Decoded, cached, published.', tone: 'blue' }, { name: 'Failed', text: 'Reported beside the stale copy.', tone: 'orange' }]}
				after={[{ name: 'On screen', text: 'With a date saying how old it is.', tone: 'dark' }]}
				labels={{ before: [['window due', 'cache first']], fork: ['200', 'error'], join: ['publish', 'keep the old copy'] }} />
		</Section>

		<Section tone="dark" split eyebrow="PoliVerse · Architecture" title="Four layers," dim="pulled apart."
			lead="Screens never talk to the network. Each service is a Source behind a Store; hosts come from the same directory the official app reads.">
			<ExplodedStack layers={[
				{ name: 'Features', tint: 'acid', chips: [{ label: 'Today' }, { label: 'Courses' }, { label: 'Career' }], text: 'Seventeen feature folders, routed by ShellState, drawn with one Theme.' },
				{ name: 'Models', tint: 'violet', chips: [{ label: 'Career' }, { label: 'Agenda' }, { label: 'WeBeep' }], text: 'Feature models compose stores into the shapes screens consume.' },
				{ name: 'Stores', tint: 'blue', chips: [{ label: 'Source → Store → OfflineStore' }], text: 'Cache first, load window, offline copy, and a phase every screen can show.' },
				{ name: 'Services', tint: 'paper', chips: [{ label: 'PoliMi' }, { label: 'WeBeep' }, { label: 'Rooms', accent: true }], text: 'Servizi Online, Manifesti, WeBeep’s Moodle and the public rooms, through one HTTP door.' },
			]} />
		</Section>

		<Section>
			<Declaration project="PoliVerse · 2026" breadcrumb={['PoliVerse', 'The data layer', 'Store']} kind="Class" name="Store"
				abstract="Drives one Source: publishes its cached copy at once, refreshes when its load window says so, and never clears what is already on screen."
				availability={[{ label: 'iOS 27' }, { label: 'Swift 6 · MainActor' }, { label: 'Widgets · Watch' }, { label: 'DocC', muted: true }]}
				declaration="final class Store<S: Source>"
				nav={[{ title: 'The data layer', symbols: [{ name: 'Source', kind: 'P' }, { name: 'Store', kind: 'C', current: true }, { name: 'OfflineStore', kind: 'C' }, { name: 'LoadWindow', kind: 'S' }, { name: 'DataStatus', kind: 'E' }] }, { title: 'Sign-in', symbols: [{ name: 'Session', kind: 'C' }, { name: 'CieIDBridge', kind: 'S' }, { name: 'TokenStore', kind: 'C' }] }]}
				mentioned={[{ label: 'The CIE hand-off', href: '#cie' }, { label: 'A stale answer with a date', href: '#data' }]}>
				<p>A <code>load()</code> reads the cache and publishes it, decides whether a refresh is due, fetches and decodes, then records the outcome in <code>DataStatus</code> so the app can say <b>how old what it is showing is</b>.</p>
			</Declaration>
		</Section>

		<Section id="specs" index={5}>
			<TechSpecs eyebrow="PoliVerse" meta="Swift 6 · SwiftUI · iOS 27 · watchOS · 2026" groups={[
				{ title: 'Platforms', items: [{ title: 'iPhone and iPad', text: 'One column of cards on iPhone, two on a regular-width iPad, capped at a readable measure.' }, { title: 'Widgets and Live Activity', text: 'Next lecture, today, career, free rooms, controls, and a Live Activity for the lecture in progress.' }, { title: 'Apple Watch', text: 'Today’s lectures and the next exam, sent over WatchConnectivity.' }] },
				{ title: 'Code', counts: [{ value: '460', label: 'Swift files' }, { value: '17', label: 'feature areas' }, { value: '0', label: 'dependencies', accent: true }], note: 'Strict concurrency, MainActor by default, synchronized folder groups.' },
				{ title: 'Accessibility', values: [{ label: 'Brand navy on white', value: '13:1' }, { label: 'Navy on dark, before', value: '1.3:1', text: 'so every accent has a dark twin' }, { label: 'Worst pair now', value: '4.7:1', text: 'in either appearance' }] },
				{ title: 'Verification', lead: '1,220 unit tests and 49 UI tests', tags: ['CET/CEST timestamp parsing', 'refresh coalescing', 'exam status mapping', 'authcode extraction', 'accessibility audits', 'launch and hitch metrics'] },
			]} />
		</Section>

		<Limits proven={[
			{ text: 'The whole app renders on sample data', source: 'Session.useMockData · every Source supplies sample()' },
			{ text: 'Source, tests and documentation, readable in full', source: 'github.com/samuelesegrini/PoliVerse', href: repo },
		]} notProven={[
			{ text: 'Login against a live account', source: 'Implemented, still to be tested' },
			{ text: 'Timetable and career on today’s endpoints', source: 'Both return 404 as of September 2026' },
			{ text: 'The Watch app on a device', source: 'Builds against the watchOS SDK only' },
		]} />

		<Section id="faq" index={6}>
			<Faq eyebrow="PoliVerse" title="Questions," dim="answered." open={0} lead="The ones a reviewer asks first." contact={{ label: 'Ask about this project', href: 'mailto:samuele.segrini@gmail.com' }} items={[
				{ q: 'Is it an official app?', a: 'No. PoliVerse is unofficial and not endorsed by Politecnico di Milano; the icon deliberately carries nothing from its identity.' },
				{ q: 'Where does the data come from, without a public API?', a: 'From the private backend behind the official app. PoliVerse reads the same public config for its service hosts, so a moved backend needs no release.' },
				{ q: 'Why can’t I enrol in an exam from it?', a: 'A wrong write costs a student a session; a wrong read costs a refresh. The request shapes are not verified, so writes stay out until they are.' },
				{ q: 'Can I try it without a PoliMi account?', a: 'Yes. Sample data is on by default, and every screen says so while it is.' },
			]} />
		</Section>

		<KeepExploring position={{ current: 1, total: 6 }}
			next={{ label: 'Next', title: 'EasyManager', text: 'A restaurant’s orders, from the table to the fiscal printer.', href: labProjectPath('en', 'easymanager-restaurant-operations'), image: cover('easymanager'), tone: 'blue' }}
			previous={{ label: 'Previous', title: 'SpinGO', href: labProjectPath('en', 'spingo-sustainable-micromobility'), image: cover('spingo'), tone: 'violet' }}
			all={{ label: 'The archive', title: 'All projects', text: 'Apps, packages, hardware and research, in one list.', href: labPaths.en.work }} />

		<Section tone="sand">
			<PageIndex title="PoliVerse" primary={[{ label: 'Highlights', href: '#highlights' }, { label: 'The app', href: '#app' }, { label: 'By the numbers', href: '#numbers' }, { label: 'Signing in', href: '#cie' }, { label: 'Specs', href: '#specs' }, { label: 'Questions', href: '#faq' }]}
				groups={[{ title: 'Code', links: [{ label: 'PoliVerse on GitHub', href: repo, note: 'Source, DocC and docs' }] }, { title: 'More from the portfolio', links: [{ label: 'EasyManager', href: labProjectPath('en', 'easymanager-restaurant-operations') }, { label: 'All projects', href: labPaths.en.work }, { label: 'About me', href: labPaths.en.about, icon: 'person' }] }]} />
		</Section>
	</Story>
</ExperimentLayout>

<style>
	.pv-mark { width: 104px; height: 104px; border-radius: 26px; }
	:global(.st-ahero-mark:has(.pv-mark)) { box-shadow: none; background: none; }
	.pv-today, .pv-screen { display: flex; flex-direction: column; gap: 10px; width: 100%; height: 100%; padding: 14% 7% 6%; background: #f4f1e9; color: #171713; font-size: 12px; text-align: left; }
	.pv-status { position: absolute; top: 3%; left: 12%; font-size: 10px; }
	.pv-h { font-size: 22px; letter-spacing: -.03em; }
	.pv-card { display: grid; gap: 3px; padding: 12px; border-radius: 16px; background: #fffefb; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-card.now { background: #cdefff; }
	.pv-card.exam { background: #ffd4b8; }
	.pv-card .st-mono { font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }
	.pv-card b { font-size: 14px; }
	.pv-row { display: flex; align-items: center; gap: 10px; }
	.pv-row > i { width: 6px; align-self: stretch; border-radius: 3px; }
	.pv-row > span { display: grid; }
	.pv-row span span { color: #5e5a53; font-size: 11px; }
	i.violet { background: #ded1ff; box-shadow: inset 0 0 0 1.5px #171713; } i.orange { background: #ffd4b8; box-shadow: inset 0 0 0 1.5px #171713; } i.blue { background: #cdefff; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-tabs { display: flex; justify-content: space-around; margin-top: auto; padding-top: 10px; border-top: 1px solid #d3d1ca; font-size: 10px; }
	.pv-tabs i { font-style: normal; color: #6b6760; } .pv-tabs i.on { color: #171713; font-weight: 700; }
	.pv-watch { display: flex; flex-direction: column; justify-content: center; gap: 4px; width: 100%; height: 100%; padding: 14%; background: #22221d; color: #f4f1e9; }
	.pv-watch .st-mono { font-size: 9px; color: #a9a59b; text-transform: uppercase; } .pv-watch b { font-size: 18px; } .pv-watch span:last-child { font-size: 11px; color: #c9c5bc; }
	.pv-course { display: grid; gap: 6px; padding: 14px; border-radius: 14px; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-course i { height: 7px; width: 70%; border-radius: 4px; background: #171713; } .pv-course i + i { width: 40%; opacity: .4; }
	.pv-avg { display: grid; padding: 12px; border-radius: 16px; background: #171713; color: #fffef9; } .pv-avg b { font-size: 30px; } .pv-avg span { font-size: 10px; color: #c9c5bc; }
	.pv-mark-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #d3d1ca; }
	.pv-mark-row i { width: 60%; height: 7px; border-radius: 4px; background: #b4b0a6; }
	.pv-field { padding: 10px 12px; border-radius: 12px; background: #fffefb; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-json { display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; font-size: 13px; }
	.pv-json span { padding: 10px 14px; border-radius: 12px; background: #fffefb; box-shadow: inset 0 0 0 1.5px #171713; overflow-wrap: anywhere; }
	.pv-steps { display: flex; flex-wrap: wrap; align-content: flex-end; gap: 10px; margin: 0; padding: 0; list-style: none; font-size: 13px; }
	.pv-steps li { padding: 10px 14px; border-radius: 999px; background: #2c2c26; color: #f4f1e9; }
	.pv-steps li.ok { background: #c7ff9f; color: #171713; }
	.pv-nope { display: flex; flex-wrap: wrap; align-content: flex-end; gap: 10px; margin: 0; padding: 0; list-style: none; }
	.pv-nope li { padding: 12px 18px; border-radius: 999px; background: #fffefb; box-shadow: inset 0 0 0 2px #171713; font-weight: 600; text-decoration: line-through; }
</style>
