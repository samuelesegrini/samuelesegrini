					                      <span style="display: flex; align-items: baseline; gap: 2px; font-family: 'IBM Plex Mono', monospace; font-weight: 600;"><span style="display: flex; font-size: 30px; line-height: 34px;"><span>1</span><span style="display: inline-block; height: 34px; overflow: hidden;"><span class="st-hg-loop" style="display: flex; flex-direction: column; animation: pvk-tick-c 6s cubic-bezier(.22, 1, .36, 1) 4s infinite none;"><span>2</span><span>3</span></span></span></span><span style="font-size: 14px; color: #3b3830;">giorni</span></span>
