---
/**
 * Anteprima non elencata del racconto di PoliVerse, costruita solo con le sezioni della seconda
 * serie. I numeri vengono dal repository (commit e983281) e hanno la loro nota in fondo; le icone
 * sono i file veri dell'app; le schermate sono illustrazioni dichiarate dell'interfaccia italiana,
 * da sostituire con le catture del test ScreenshotSweepUITests. Fuori dalla sitemap, noindex.
 */
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import {
	Story, Section, AppHero, Lockup, HighlightsGallery, FeatureExplorer, Stats,
	ChangeLog, ThenNow, Findings, StateMachine, ExplodedStack, Principles, Limits, TechSpecs,
	Sources, Faq, KeepExploring, ScrollIntro, LitText, StickyScenes, BeforeAfter, ProductShot, Icon, MediaCards,
	Statement, ObjectRow,
} from '../../../components/story';
import { labPaths, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';

const repo = 'https://github.com/samuelesegrini/PoliVerse';
const icon = (name: string) => withBase(`/images/projects/poliverse/icons/${name}.svg`);
const cover = (name: string) => withBase(`/images/projects/covers/${name}.svg`);

// La rampa del Flavor di partenza, dal diagramma DocC flavor-ramp.svg: dal più profondo al più chiaro.
const ramp = ['#11777A', '#13758A', '#157099', '#1767A8', '#195BB8', '#1B4BC7', '#1D37D6', '#1F20E5'];

// I sei servizi che PoliVerse tiene insieme (docs/ del repo dell'app), in orbita attorno all'icona in
// senso orario dall'alto, un giro ogni `lap` secondi. `cos`/`sin` dicono il posto di ciascuno
// sull'orbita da fermo; il giro sono due oscillazioni, una orizzontale e una verticale sfasata di un
// quarto, e `phaseX`/`phaseY` sono i ritardi negativi che le fanno partire proprio da quel posto.
// `dx`/`dy` (in centesimi del disegno) e `r` dicono da dove partono, sparsi.
const lap = 40;
const phase = (degrees: number) => -+(((((degrees % 360) + 360) % 360) / 360) * lap).toFixed(2);
const sources = ([
	{ name: 'Servizi Online', adds: 'courses, career, exams', icon: 'checklist', tint: 'blue', dx: -24, dy: -8, r: -7 },
	{ name: 'WeBeep', adds: 'materials, notices, forum', icon: 'layers', tint: 'acid', dx: 7, dy: -14, r: 6 },
	{ name: 'Recordings', adds: 'recorded lectures', icon: 'play', tint: 'violet', dx: 11, dy: 12, r: -5 },
	{ name: 'Rooms & maps', adds: 'free rooms, floor plans', icon: 'target', tint: 'orange', dx: 22, dy: 6, r: 8 },
	{ name: 'Syllabus', adds: 'what each course covers', icon: 'doc-text', tint: 'blue', dx: -6, dy: 13, r: 7 },
	{ name: 'Manifesto', adds: 'your plan and teachers', icon: 'book', tint: 'acid', dx: -12, dy: -12, r: -6 },
] as const).map((source, i) => {
	const angle = -90 + i * 60;
	const radians = (angle * Math.PI) / 180;
	return { ...source, cos: +Math.cos(radians).toFixed(4), sin: +Math.sin(radians).toFixed(4), phaseX: phase(angle), phaseY: phase(angle + 90) };
});

// Il muro di icone di Personalizza: tutte e 36, ognuna una volta, quattro file da nove. In ogni fila
// si alternano una speciale, un Giorno e un Vicino, e due vicine non hanno mai la stessa forma o lo
// stesso colore. Le file scorrono piano, ciascuna per conto suo, ripetute tre volte per non avere giunte.
const wall = [
	['special-neon', 'dial-mandarin', 'closeup-indigo', 'special-paper', 'dial-sky', 'closeup-raspberry', 'special-hyperspace', 'dial-sage', 'closeup-coffee'],
	['closeup-mint', 'special-leather', 'dial-lavender', 'closeup-coral', 'special-holographic', 'dial-graphite', 'closeup-sky', 'special-circuit', 'dial-classic'],
	['dial-coral', 'closeup-lavender', 'special-heavens', 'dial-indigo', 'closeup-mandarin', 'special-spectrum', 'dial-mint', 'closeup-slate', 'orbit'],
	['special-blueprint', 'dial-raspberry', 'closeup-sage', 'special-observatory', 'dial-coffee', 'closeup-graphite', 'special-soft', 'dial-slate', 'closeup-classic'],
];

// Le piastrelle dei sei posti, ognuna del colore e della storta del suo punto nella prima carta.
const place = (i: number) => `--tint: var(--${sources[i].tint}); --r: ${sources[i].r / 2}deg`;

const sections = [
	{ kicker: 'Chapter 1 of 8', value: 'Why it exists', detail: { kicker: 'Places', value: '6 to check' } },
	{ kicker: 'Chapter 2 of 8', value: 'Highlights', detail: { kicker: 'In short', value: '4 highlights' } },
	{ kicker: 'Chapter 3 of 8', value: 'A day in it', detail: { kicker: 'Tabs', value: '4, one question each' } },
	{ kicker: 'Chapter 4 of 8', value: 'Make it yours', detail: { kicker: 'Icons', value: '36 to choose from' } },
	{ kicker: 'Chapter 5 of 8', value: 'Fifteen days', detail: { kicker: 'Commits', value: '309' } },
	{ kicker: 'Chapter 6 of 8', value: 'What it took', detail: { kicker: 'Public API', value: 'none' } },
	{ kicker: 'Chapter 7 of 8', value: 'The rules', detail: { kicker: 'Written down', value: '6 rules' } },
	{ kicker: 'Chapter 8 of 8', value: 'Specs & FAQ', detail: { kicker: 'Dependencies', value: 'none' } },
];

---

<ExperimentLayout lang="en" title="PoliVerse (preview)" currentHref="/en/preview/poliverse/" sections={sections} itHref={withBase('/it/anteprima/poliverse/')} enHref={withBase('/en/preview/poliverse/')} noindex>
	<Story>
		<AppHero name="PoliVerse" title="Your whole Politecnico. In one app." tint="blue"
			summary="An unofficial app for Politecnico di Milano students: timetable, courses, WeBeep materials, lesson recordings, exams and rooms, on iPhone, iPad, Apple Watch and the Lock Screen. It opens with content, even offline."
			meta="Individual work · SwiftUI · iOS 27 · September 2026"
			actions={[{ label: 'Read the story', href: '#why' }, { label: 'Source on GitHub', href: repo }]}>
			<img slot="mark" src={icon('orbit')} alt="" width="104" height="104" class="pv-mark" />
			<ProductShot slot="shot" priority src="/assets/projects/poliverse-devices.png" alt="Illustration: PoliVerse on iPhone and Apple Watch. The lesson in progress on the Lock Screen, the Today tab with the timetable, and the next exam on the watch." />
		</AppHero>

		<Section id="why" index={1}>
			<Statement>A day at the Politecnico is spread over <b>six places</b>, and <b>the official app leaves some of them out</b>.</Statement>
			<ObjectRow label="The six places a student checks" items={sources.map((source) => ({ name: source.name, text: `For ${source.adds}.` }))}>
				<span slot="object-1" class="pv-place" style={place(0)} aria-hidden="true"><Icon name={sources[0].icon} size={40} stroke={1.8} /></span>
				<span slot="object-2" class="pv-place" style={place(1)} aria-hidden="true"><Icon name={sources[1].icon} size={40} stroke={1.8} /></span>
				<span slot="object-3" class="pv-place" style={place(2)} aria-hidden="true"><Icon name={sources[2].icon} size={40} stroke={1.8} /></span>
				<span slot="object-4" class="pv-place" style={place(3)} aria-hidden="true"><Icon name={sources[3].icon} size={40} stroke={1.8} /></span>
				<span slot="object-5" class="pv-place" style={place(4)} aria-hidden="true"><Icon name={sources[4].icon} size={40} stroke={1.8} /></span>
				<span slot="object-6" class="pv-place" style={place(5)} aria-hidden="true"><Icon name={sources[5].icon} size={40} stroke={1.8} /></span>
			</ObjectRow>
		</Section>

		<Section>
			<LitText eyebrow="PoliVerse · The motive" tint="blue" text="So I built the app I wanted to open: *all six in one place*, on the newest SwiftUI." />
		</Section>

		<ScrollIntro id="highlights" index={2} tone="ink2" eyebrow="PoliVerse" title="Get the highlights." />

		<Section tone="ink2" link={{ label: 'Browse the source', href: repo }}>
			<HighlightsGallery interval={6000} cards={[
				{ text: 'All of it, in one app.', meta: 'What PoliVerse brings together', name: 'All of it, in one app', tone: 'dark' },
				{ lead: 'Your courses, with WeBeep inside.', text: 'Your exam grade, from the study plan.', name: 'Courses with WeBeep inside', tone: 'paper', layout: 'split', dwell: 9000 },
				{ lead: 'Make it yours.', text: 'One colour becomes the whole app, down to the icon.', meta: 'Personalizza, 36 icons', name: 'Make it yours', tone: 'dark', layout: 'overlay' },
				{ lead: 'It opens with your day, even underground.', text: 'Back up, it catches up on its own.', name: 'Offline first', tone: 'paper', layout: 'split', dwell: 8000 },
			]}>
				<div slot="media-1" class="pv-combine" style={`--half: ${lap / 2}s`} aria-hidden="true">
					<span class="pv-ring"></span>
					<span class="pv-core"><img src={icon('orbit')} alt="" width="120" height="120" /></span>
					{sources.map((source, i) => (
						<span class="pv-orbit st-hg-loop" style={`--cos: ${source.cos}; --sin: ${source.sin}; --phase-x: ${source.phaseX}s; --phase-y: ${source.phaseY}s`}>
							<span class="pv-orbit-y st-hg-loop">
								<span class="pv-chip" style={`--dx: ${source.dx}; --dy: ${source.dy}; --r: ${source.r}deg; --d: ${i * 70}ms; --tint: var(--${source.tint})`}>
									<Icon name={source.icon} size={16} stroke={2.2} /><b>{source.name}</b><small>{source.adds}</small>
								</span>
							</span>
						</span>
					))}
				</div>
				<div slot="copy-2" class="st-hg-anim pv-k-copy">
					<p><b class="st-hg-lead">Your courses, with WeBeep inside.</b></p>
					<div class="pv-k-lines">
						<p data-gone style="opacity: 0; animation: pvk-fade-out .3s ease-out 2.2s backwards;">Matched by the course code.</p>
						<div style="animation: pvk-fade-in .4s ease-out 2.45s both;">
							<p class="st-hg-loop" style="animation: pvk-txt-a 6s cubic-bezier(.4, 0, .6, 1) 4s infinite none;">Your exam grade, from the study plan.</p>
							<p class="st-hg-loop" data-gone style="opacity: 0; animation: pvk-txt-b 6s cubic-bezier(.4, 0, .6, 1) 4s infinite none;">Your next lesson, with its room.</p>
							<p class="st-hg-loop" data-gone style="opacity: 0; animation: pvk-txt-c 6s cubic-bezier(.4, 0, .6, 1) 4s infinite none;">Days to your next exam, counted down.</p>
						</div>
					</div>
					<p class="st-hg-body">Each course in your plan opens with its WeBeep data: notices, materials, recordings and forum, with lessons, exams and grade beside it.</p>
				</div>
				<div slot="copy-4" class="st-hg-anim pv-k-copy">
					<p><b class="st-hg-lead">It opens with your day, even underground.</b></p>
