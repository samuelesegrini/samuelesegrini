					                <span style="display: flex; align-items: center; justify-content: center; width: 22px; height: 26px; border-radius: 7px; background: #c7ff9f; box-shadow: inset 0 0 0 1.5px #171713; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; animation: pvk-digit-in 0.28s cubic-bezier(.22, 1, .36, 1) 0.92s both;">4</span>
					                <span style="display: flex; align-items: center; justify-content: center; width: 22px; height: 26px; border-radius: 7px; background: #c7ff9f; box-shadow: inset 0 0 0 1.5px #171713; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; animation: pvk-digit-in 0.28s cubic-bezier(.22, 1, .36, 1) 0.97s both;">3</span>
