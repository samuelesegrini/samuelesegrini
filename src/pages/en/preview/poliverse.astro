	.pv-w em { font-style: normal; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #0f3d6e; }
	.pv-w b { font-size: 15px; line-height: 1.1; } .pv-w span { font-size: 11px; color: #5e5a53; }
	.pv-w.dark { background: #171713; color: #fffef9; } .pv-w.dark em { color: #c7ff9f; } .pv-w.dark b { font-size: 40px; } .pv-w.dark span { color: #c9c5bc; }
