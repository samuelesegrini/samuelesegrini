	/* I disegni nelle carte dei punti salienti. */
	/* La prima: i sei servizi, sparsi, entrano in orbita attorno all'app e ci restano, girando. Senza
	   script o senza movimento si vede già il punto d'arrivo, fermo; con lo script la carta aspetta di
	   essere davanti. */
	.pv-combine { position: relative; container-type: size; }
	.pv-ring { position: absolute; left: 12%; top: 18%; width: 76%; height: 72%; border-radius: 50%; box-shadow: inset 0 0 0 1.5px rgba(244, 241, 233, .22); -webkit-mask: conic-gradient(#000 var(--sweep), transparent 0); mask: conic-gradient(#000 var(--sweep), transparent 0); }
	.pv-core { position: absolute; left: 50%; top: 54%; width: clamp(64px, 13cqw, 116px); translate: -50% -50%; }
	.pv-core::before { content: ''; position: absolute; inset: -70%; border-radius: 50%; background: radial-gradient(closest-side, rgba(107, 173, 240, .34), transparent); }
	.pv-core img { position: relative; display: block; width: 100%; height: auto; filter: drop-shadow(0 12px 28px rgba(0, 0, 0, .45)); }
	/* Ogni servizio sta sull'orbita, l'ellisse dell'anello: 38% del disegno in orizzontale, 36% in
	   verticale, centrata a 50% e 54%. Una scatola lo porta al suo posto in orizzontale, una dentro in
	   verticale; davanti (in basso) cresce del 6% e si schiarisce, dietro rimpicciolisce e si scurisce. */
	.pv-orbit { position: absolute; left: 50%; top: 54%; translate: calc(var(--cos) * var(--rx, 38) * 1cqw) 0; }
	.pv-orbit-y { position: absolute; left: 0; top: 0; translate: 0 calc(var(--sin) * 36cqh); scale: calc(1 + var(--sin) * .06); filter: brightness(calc(.91 + var(--sin) * .09)); }
	.pv-chip { position: absolute; left: 0; top: 0; width: max-content; translate: -50% -50%; display: grid; grid-template-columns: auto auto; align-items: center; column-gap: 10px; padding: 7px 16px 7px 7px; border-radius: 999px; background: #2c2c26; box-shadow: inset 0 0 0 1px rgba(244, 241, 233, .14), 0 10px 24px rgba(0, 0, 0, .35); color: #f4f1e9; white-space: nowrap; }
	.pv-chip :global(.st-icon) { grid-row: span 2; width: 34px; height: 34px; padding: 8px; border-radius: 50%; background: var(--tint); color: #171713; }
	.pv-chip b { font-size: 14px; font-weight: 600; line-height: 1.15; }
	.pv-chip small { font-size: 11.5px; line-height: 1.2; color: #c9c5bc; }
	/* Le pillole intere girano senza toccarsi né uscire dalla carta solo da 860 px in su: sotto, icona e nome. */
	@container (max-width: 860px) {
		.pv-chip { grid-template-columns: auto; justify-items: center; row-gap: 5px; padding: 0; background: none; box-shadow: none; }
		.pv-chip :global(.st-icon) { grid-row: auto; width: 30px; height: 30px; padding: 7px; }
		.pv-chip b { font-size: 11px; }
		.pv-chip small { display: none; }
	}
	/* Sui telefoni più stretti l'orbita si allarga un poco e i nomi si stringono, così passando in basso
	   due servizi vicini non si sovrappongono. */
	@container (max-width: 240px) {
		.pv-ring { left: 8%; width: 84%; }
		.pv-orbit { --rx: 42; }
		.pv-chip :global(.st-icon) { width: 26px; height: 26px; padding: 6px; }
		.pv-chip b { font-size: 10px; }
	}
	@property --sweep { syntax: '<angle>'; inherits: false; initial-value: 360deg; }
	@keyframes pv-chip-in {
		0% { opacity: 0; transform: translate(calc(var(--dx) * 1cqw), calc(var(--dy) * 1cqh)) rotate(var(--r)) scale(.96); }
		14%, 34% { opacity: 1; transform: translate(calc(var(--dx) * 1cqw), calc(var(--dy) * 1cqh)) rotate(var(--r)); }
		100% { opacity: 1; transform: none; }
	}
	@keyframes pv-core-in { 0% { opacity: 0; scale: .6; } 60% { opacity: 1; scale: 1.06; } 100% { opacity: 1; scale: 1; } }
	@keyframes pv-ring-in { from { --sweep: 0deg; } to { --sweep: 360deg; } }
	/* Il giro: le due scatole vanno avanti e indietro con la curva del seno, un quarto di giro l'una
	   dopo l'altra, e insieme disegnano l'ellisse. Solo spostamenti e scale, che ogni browser anima. */
	@keyframes pv-orbit-x { from { translate: calc(var(--rx, 38) * 1cqw) 0; } to { translate: calc(var(--rx, 38) * -1cqw) 0; } }
	@keyframes pv-orbit-y { from { translate: 0 -36cqh; scale: .94; filter: brightness(.82); } to { translate: 0 36cqh; scale: 1.06; filter: brightness(1); } }
	@media (prefers-reduced-motion: no-preference) {
		:global(.st-hgallery[data-bound]) .pv-chip, :global(.st-hgallery[data-bound]) .pv-core { opacity: 0; }
		:global(.st-hgallery[data-bound]) .pv-ring { --sweep: 0deg; }
		:global(.st-hg-card[data-played]) .pv-chip { animation: pv-chip-in 2.4s cubic-bezier(.4, 0, .6, 1) var(--d) both; }
		/* l'orbita gira finché la carta è davanti, anche quando chi legge ha preso i comandi; il tasto di
		   pausa la ferma dov'è (.st-hg-loop), e quando la carta torna riprende da lì */
		:global(.st-hg-card[data-played]) .pv-orbit { animation: pv-orbit-x var(--half) cubic-bezier(.37, 0, .63, 1) var(--phase-x) infinite alternate; }
		:global(.st-hg-card[data-played]) .pv-orbit-y { animation: pv-orbit-y var(--half) cubic-bezier(.37, 0, .63, 1) var(--phase-y) infinite alternate; }
		:global(.st-hg-card[data-played]) .pv-ring { animation: pv-ring-in 1.3s cubic-bezier(.4, 0, .6, 1) 1.2s both; }
		:global(.st-hg-card[data-played]) .pv-core { animation: pv-core-in .9s cubic-bezier(.22, 1, .36, 1) 1.5s both; }
	}
	/* La seconda e la quarta: un disegno in scala fissa (452 × 472, come nel canvas), che lo script
	   rimpicciolisce quanto basta a starci intero (--pv-fit). Le animazioni sono scritte nel disegno. */
	.pv-stage-box { display: flex; align-items: center; justify-content: center; overflow: hidden; }
	.pv-stage { flex: none; scale: var(--pv-fit, 1); color: #171713; font-family: 'Manrope Variable', 'Manrope', system-ui, sans-serif; text-align: left; }
	.pv-stage :global(b) { font-weight: 700; }
	/* la frase della seconda carta cambia con la carta davanti nella pila */
	.pv-k-copy { display: grid; }
