		:global(.st-hgallery[data-inview] .st-hg-card[data-current]) .pv-chip { animation: pv-chip-in 2.4s cubic-bezier(.4, 0, .6, 1) var(--d) both, pv-orbit var(--lap) linear var(--phase) infinite; }
		/* in pausa, o quando chi legge ha preso i comandi, l'orbita si ferma dov'è: l'ingresso finisce comunque */
		:global(.st-hgallery[data-inview][data-playing='false'] .st-hg-card[data-current]) .pv-chip { animation-play-state: running, paused; }
		:global(.st-hgallery[data-inview] .st-hg-card[data-current]) .pv-ring { animation: pv-ring-in 1.3s cubic-bezier(.4, 0, .6, 1) 1.2s both; }
		:global(.st-hgallery[data-inview] .st-hg-card[data-current]) .pv-core { animation: pv-core-in .9s cubic-bezier(.22, 1, .36, 1) 1.5s both; }
	}
