---
/**
 * Anteprima non elencata del racconto di PoliVerse, costruita solo con le sezioni della seconda
 * serie. I numeri vengono dal repository (commit e983281) e hanno la loro nota in fondo; le icone
 * sono i file veri dell'app; le schermate sono illustrazioni dichiarate dell'interfaccia italiana,
 * da sostituire con le catture del test ScreenshotSweepUITests. Fuori dalla sitemap, noindex.
 */
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import {
	Story, Section, AppHero, Lockup, HighlightsGallery, FeatureExplorer, ToggleFigure, Stats,
	ChangeLog, ThenNow, Findings, StateMachine, ExplodedStack, Declaration, Principles, Limits, TechSpecs,
	Sources, Faq, KeepExploring, PageIndex, ScrollIntro, LitText, Bento, StickyScenes, BarCompare, BeforeAfter, ProductShot, Icon, MediaCards,
} from '../../../components/story';
import { labPaths, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';

const repo = 'https://github.com/samuelesegrini/PoliVerse';
const icon = (name: string) => withBase(`/images/projects/poliverse/icons/${name}.svg`);
const cover = (name: string) => withBase(`/images/projects/covers/${name}.svg`);

// I colori in cui escono Giorno e Vicino: gli stessi da cui parte un Flavor (AppIconChoice).
const colours: [string, string][] = [
	['classic', 'Classic'], ['lavender', 'Lavender'], ['indigo', 'Indigo'], ['sky', 'Sky'], ['mint', 'Mint'], ['sage', 'Sage'],
	['mandarin', 'Mandarin'], ['coral', 'Coral'], ['raspberry', 'Raspberry'], ['coffee', 'Coffee'], ['slate', 'Slate'], ['graphite', 'Graphite'],
];
const specials: [string, string][] = [
	['neon', 'Neon'], ['spectrum', 'Spectrum'], ['leather', 'Leather'], ['holographic', 'Holographic'], ['hyperspace', 'Hyperspace'],
	['blueprint', 'Blueprint'], ['circuit', 'Circuit'], ['heavens', 'Heavens'], ['observatory', 'Observatory'], ['soft', 'Soft'], ['paper', 'Paper'],
];
const appearances: [string, string][] = [['orbit', 'Default'], ['orbit-dark', 'Dark'], ['orbit-clear', 'Clear'], ['orbit-tinted', 'Tinted']];

// La rampa del Flavor di partenza, dal diagramma DocC flavor-ramp.svg: dal più profondo al più chiaro.
const ramp = ['#11777A', '#13758A', '#157099', '#1767A8', '#195BB8', '#1B4BC7', '#1D37D6', '#1F20E5'];

// I sei servizi che PoliVerse tiene insieme (docs/ del repo dell'app), in orbita attorno all'icona in
// senso orario dall'alto, un giro ogni `lap` secondi. `angle` è il posto di ciascuno sull'orbita da
// fermo, `phase` il ritardo negativo che fa partire il giro proprio da lì. `dx`/`dy` (in centesimi del
// disegno) e `r` dicono da dove partono, sparsi.
const lap = 40;
const sources = ([
	{ name: 'Servizi Online', adds: 'courses, career, exams', icon: 'checklist', tint: 'blue', dx: -24, dy: -8, r: -7 },
	{ name: 'WeBeep', adds: 'materials, notices, forum', icon: 'layers', tint: 'acid', dx: 7, dy: -14, r: 6 },
	{ name: 'Recordings', adds: 'recorded lectures', icon: 'play', tint: 'violet', dx: 11, dy: 12, r: -5 },
	{ name: 'Rooms & maps', adds: 'free rooms, floor plans', icon: 'target', tint: 'orange', dx: 22, dy: 6, r: 8 },
	{ name: 'Syllabus', adds: 'what each course covers', icon: 'doc-text', tint: 'blue', dx: -6, dy: 13, r: 7 },
	{ name: 'Manifesto', adds: 'your plan and teachers', icon: 'book', tint: 'acid', dx: -12, dy: -12, r: -6 },
] as const).map((source, i) => {
	const angle = -90 + i * 60;
	const radians = (angle * Math.PI) / 180;
	return {
		...source,
		angle,
		phase: -+((((angle + 360) % 360) / 360) * lap).toFixed(2),
		x: +(50 + 38 * Math.cos(radians)).toFixed(1),
		y: +(54 + 36 * Math.sin(radians)).toFixed(1),
	};
});

// Le righe di un corso come le mostra l'app (CourseDetailView): avvisi, materiali e forum da WeBeep,
// le registrazioni da recman, il programma dal Manifesto. "N da vedere" è il conteggio dell'app.
const courseRows = [
	{ title: 'Avvisi', badge: '2 da vedere', icon: 'mail', tile: 'var(--orange)' },
	{ title: 'Materiali', badge: '3 da vedere', icon: 'layers', tile: 'var(--acid)' },
	{ title: 'Registrazioni', icon: 'play', tile: 'var(--violet)' },
	{ title: 'Forum', icon: 'people', tile: 'var(--blue)' },
	{ title: 'Programma', icon: 'book', tile: '#ffd4b8' },
] as const;

// Il muro di icone di Personalizza: Giorno, Vicino e le speciali, intrecciate, quattro file da otto.
const woven = colours.flatMap(([c], k) => [`dial-${c}`, `closeup-${c}`, ...(specials[k] ? [`special-${specials[k][0]}`] : [])]);
const wall = [0, 1, 2, 3].map((r) => woven.slice(r * 8, r * 8 + 8));

// La settimana che l'app ricava dagli insegnamenti scelti (PersonalTimetableView): giorno, ora, aula.
const picks = [
	{ name: 'Reti di Calcolatori', on: true },
	{ name: 'Basi di Dati', on: true },
	{ name: 'Ingegneria del Software', on: true },
	{ name: 'Tecnologie per il Web', on: false },
];
const week = [
	{ day: 1, from: 2, span: 2, room: 'T.2.1', tint: 'violet' },
	{ day: 2, from: 1, span: 2, room: '3.1.2', tint: 'blue' },
	{ day: 3, from: 3, span: 2, room: 'B.4.2', tint: 'orange' },
	{ day: 4, from: 1, span: 2, room: 'T.2.1', tint: 'violet' },
	{ day: 5, from: 2, span: 2, room: '3.1.2', tint: 'blue' },
];

const sections = [
	{ kicker: 'Chapter 1 of 7', value: 'Highlights', detail: { kicker: 'In short', value: '4 highlights' } },
	{ kicker: 'Chapter 2 of 7', value: 'The app', detail: { kicker: 'Tabs', value: 'Today · Courses · Career · Search' } },
	{ kicker: 'Chapter 3 of 7', value: 'Make it yours', detail: { kicker: 'Icons', value: '36 to choose from' } },
	{ kicker: 'Chapter 4 of 7', value: 'Fifteen days', detail: { kicker: 'Commits', value: '309' } },
	{ kicker: 'Chapter 5 of 7', value: 'Under the hood', detail: { kicker: 'Public API', value: 'none' } },
	{ kicker: 'Chapter 6 of 7', value: 'Decisions', detail: { kicker: 'Written down', value: '6 rules' } },
	{ kicker: 'Chapter 7 of 7', value: 'Specs & questions', detail: { kicker: 'Dependencies', value: 'none' } },
];

---

<ExperimentLayout lang="en" title="PoliVerse (preview)" currentHref="/en/preview/poliverse/" sections={sections} itHref={labPaths.it.home} enHref={labPaths.en.home} noindex>
	<Story>
		<AppHero name="PoliVerse" title="Your whole Politecnico. In one app." tint="blue"
			summary="An unofficial app for Politecnico di Milano students: timetable, courses, WeBeep materials, lesson recordings, exams and rooms, on iPhone, iPad, Apple Watch and the Lock Screen. It opens with content, even offline."
			meta="Individual work · SwiftUI · iOS 27 · September 2026"
			actions={[{ label: 'Read the story', href: '#highlights' }, { label: 'Source on GitHub', href: repo }]}>
			<img slot="mark" src={icon('orbit')} alt="" width="104" height="104" class="pv-mark" />
			<ProductShot slot="shot" priority src="/assets/projects/poliverse-devices.png" alt="PoliVerse on iPhone, iPad and Apple Watch" />
		</AppHero>

		<ScrollIntro id="highlights" index={1} tone="ink2" eyebrow="PoliVerse" title="Get the highlights." />

		<Section tone="ink2" link={{ label: 'Browse the source', href: repo }}>
			<HighlightsGallery interval={6000} cards={[
				{ text: 'Six places a student checks. One app.', meta: 'What PoliVerse brings together', name: 'Six places, one app', tone: 'dark' },
				{ lead: 'Your courses, with WeBeep inside.', text: 'Matched by the course code.', meta: 'Del piano · WeBeep', name: 'Courses with WeBeep inside', tone: 'paper', layout: 'split' },
				{ lead: 'Make it yours.', text: 'One colour becomes the whole app, down to the icon.', meta: 'Personalizza · 36 icons', name: 'Make it yours', tone: 'dark', layout: 'overlay' },
				{ lead: 'It opens with content, even offline.', text: 'A failed refresh clears nothing.', meta: 'Store · offline copy', name: 'Offline first', tone: 'acid', layout: 'split' },
			]}>
				<div slot="media-1" class="pv-combine" style={`--lap: ${lap}s`} aria-hidden="true">
					<span class="pv-ring"></span>
					<span class="pv-core"><img src={icon('orbit')} alt="" width="120" height="120" /></span>
					{sources.map((source, i) => (
						<span class="pv-chip" style={`--x: ${source.x}%; --y: ${source.y}%; --pv-angle: ${source.angle}deg; --phase: ${source.phase}s; --dx: ${source.dx}; --dy: ${source.dy}; --r: ${source.r}deg; --d: ${i * 70}ms; --tint: var(--${source.tint})`}>
							<Icon name={source.icon} size={16} stroke={2.2} /><b>{source.name}</b><small>{source.adds}</small>
						</span>
					))}
				</div>
				<div slot="media-2" class="pv-join" aria-hidden="true">
					<span class="pv-src plan"><em>Piano di studi</em><b>Ingegneria del Software</b><span><mark>054321</mark> · 10 CFU</span></span>
					<span class="pv-src webeep"><em>WeBeep</em><b>2026-27 · <mark>054321</mark> · Ing. del Software</b></span>
					<span class="pv-course">
						<span class="pv-course-head"><b>Ingegneria del Software</b><span>Del piano · 10 CFU</span></span>
						{courseRows.map((row, i) => (
							<span class="pv-jrow" style={`--i: ${i}; --tile: ${row.tile}`}><i><Icon name={row.icon} size={14} stroke={2.2} /></i><b>{row.title}</b>{'badge' in row && <em>{row.badge}</em>}</span>
						))}
					</span>
				</div>
				<div slot="media-3" class="pv-wall" aria-hidden="true">
					{wall.map((row, r) => <span class="pv-wall-row" style={`--r: ${r}`}>{row.map((name) => <img src={icon(name)} alt="" width="120" height="120" loading="lazy" />)}</span>)}
				</div>
				<div slot="media-4" class="pv-fresh" role="img" aria-label="Illustration: the timetable still on screen without a connection, with one line at the bottom saying so">
					<span class="pv-fresh-card"><b>12:15</b><span>Reti di Calcolatori</span><em>T.2.1</em></span>
					<span class="pv-fresh-card"><b>14:15</b><span>Basi di Dati</span><em>B.4.2</em></span>
					<span class="pv-fresh-card"><b>16:15</b><span>Probabilità e Statistica</span><em>3.0.1</em></span>
					<span class="pv-fresh-line"><i></i>Senza connessione</span>
				</div>
			</HighlightsGallery>
		</Section>

		<Section>
			<LitText eyebrow="PoliVerse · In one line" tint="blue" text="PoliVerse puts a student’s whole Politecnico in one place: the day, the courses, the career and the campus, *on every screen they carry*, and *still there without a connection*." />
		</Section>

		<Section id="app" eyebrow="PoliVerse · Take a closer look" title="Four tabs." dim="One question each." index={2}>
			<FeatureExplorer label="Tabs" device="iphone" note="Illustrations of the Italian interface · screenshots to follow" features={[
				{ title: 'Today', file: 'Features/Shell', tint: 'blue', text: 'What is on today? The date, the lesson in progress, then what is coming, the timetable, deadlines and exams. Every section can be moved, hidden or redrawn.' },
				{ title: 'Courses', file: 'Features/Home · WeBeep', tint: 'acid', text: 'What is new in my courses? Each course gathers its notices, materials, recordings, sittings, forum and syllabus, with unread counts on the way in.' },
				{ title: 'Career', file: 'Features/Career', tint: 'violet', text: 'What is due? Rebuilt around what closes next rather than what is already true: enrolments closing, marks to decide, sittings, and the average as a line over time.' },
				{ title: 'Search', file: 'Features/Search', tint: 'orange', text: 'Where, and what? One field across courses, agenda and sittings, then rooms with their equipment, free rooms, and the campus map down to floor plans.' },
			]}>
				<div slot="screen-1" class="pv-phone" role="img" aria-label="Illustration: the Today tab">
					<span class="pv-hello">Buona giornata!</span>
					<span class="pv-date"><b>24.09</b><b>GIO</b></span>
					<span class="pv-kicker">Lezione in corso</span>
					<span class="pv-card now"><span class="pv-tag">10:15 – 12:15 · Aula 3.1.2</span><b>Ingegneria del Software</b><span class="pv-bar"><i style="width: 38%"></i></span></span>
					<span class="pv-kicker">Orario</span>
					<span class="pv-row"><i class="c-violet"></i><span><b>Reti di Calcolatori</b><span>12:15 · T.2.1</span></span></span>
					<span class="pv-row"><i class="c-orange"></i><span><b>Basi di Dati</b><span>14:15 · B.4.2</span></span></span>
					<span class="pv-kicker">Esami</span>
					<span class="pv-row"><i class="c-blue"></i><span><b>Probabilità e Statistica</b><span>6 ott · 9:00</span></span></span>
				</div>
				<div slot="screen-2" class="pv-phone" role="img" aria-label="Illustration: the Courses tab">
					<span class="pv-title">Corsi</span>
					<span class="pv-feature"><span class="pv-tag">In evidenza</span><b>Ingegneria del Software</b>
						<span class="pv-chips"><i>Avvisi <em>2</em></i><i>Materiali</i><i>Registrazioni</i><i>Appelli</i></span>
					</span>
					<span class="pv-kicker">Preferiti</span>
					<span class="pv-tiles">
						<span class="c-violet"><b>Reti di Calcolatori</b><em>1 nuovo</em></span>
						<span class="c-orange"><b>Basi di Dati</b></span>
						<span class="c-blue"><b>Probabilità e Statistica</b></span>
						<span class="c-acid"><b>Tecnologie per il Web</b><em>Consegna</em></span>
					</span>
				</div>
				<div slot="screen-3" class="pv-phone" role="img" aria-label="Illustration: the Career tab">
					<span class="pv-title">Carriera</span>
					<span class="pv-due c-orange"><span class="pv-tag">Iscrizioni in chiusura</span><b>Probabilità e Statistica</b><span>chiude tra 2 giorni</span></span>
					<span class="pv-due c-violet"><span class="pv-tag">Voto da decidere</span><b>Basi di Dati</b><span class="pv-grade">27</span></span>
					<span class="pv-due"><span class="pv-tag">Esame in arrivo</span><b>Reti di Calcolatori</b><span>8 ottobre</span></span>
					<span class="pv-avg"><span><b>27,4</b><em>media ponderata · dati di esempio</em></span>
						<svg viewBox="0 0 200 60" aria-hidden="true"><polyline points="0,44 30,40 60,46 90,30 120,34 150,22 200,18" /></svg>
					</span>
				</div>
				<div slot="screen-4" class="pv-phone" role="img" aria-label="Illustration: the Search tab">
					<span class="pv-title">Cerca</span>
					<span class="pv-field">Reti</span>
					<span class="pv-chips"><i>Aule</i><i>Aule libere</i><i>Mappa</i><i>Piano di studi</i></span>
					<span class="pv-kicker">Risultati</span>
					<span class="pv-row"><i class="c-violet"></i><span><b>Reti di Calcolatori</b><span>Corso · 10 CFU</span></span></span>
					<span class="pv-row"><i class="c-blue"></i><span><b>Reti Logiche</b><span>Esame superato · 28</span></span></span>
					<span class="pv-kicker">Aule libere ora</span>
					<span class="pv-rooms"><i>3.0.1</i><i>T.1.3</i><i>B.2.4</i><i>+9</i></span>
				</div>
			</FeatureExplorer>
		</Section>

		<Section eyebrow="PoliVerse · The small things" title="Small things," dim="that save a walk across campus.">
			<MediaCards label="Small things PoliVerse does" items={[
				{ lead: 'A free room, right now.', text: 'Rooms free for the next half hour or longer, campus by campus, with their seats.', note: 'Worked out from booked lessons: an open room can still be locked.', tone: 'paper' },
				{ lead: 'Your week, before the agenda has it.', text: 'Pick the courses you follow and the app builds the week, with rooms and addresses.', tone: 'blue' },
				{ lead: 'Your teacher, for your group.', text: 'Degree and plan come from the Manifesto, so each course shows the lecturer and the syllabus for your alphabetical group.', tone: 'paper' },
				{ lead: 'Deadlines, with the hour that matters.', text: 'WeBeep assignments sit on Today with their course and exact time, so you know whether tonight is still enough.', tone: 'violet' },
				{ lead: 'What closes next, first.', text: 'Enrolments about to close and marks waiting for your decision come before what is already settled.', tone: 'paper' },
				{ lead: 'One search across your courses.', text: 'Courses, lessons and exam sittings from one field, with free rooms and teachers one tap away.', tone: 'acid' },
			]}>
				<div slot="media-1" class="pv-mini" role="img" aria-label="Illustration: free rooms now, with their seats, and one room's free and busy hours">
					<span class="pv-seg"><i>30 min</i><i class="on">1 ora</i><i>2 ore</i></span>
					<b class="pv-mini-title">Libere ora — 12</b>
					<span class="pv-room"><b>3.0.1</b><span><Icon name="people" size={13} stroke={2.2} />120</span></span>
					<span class="pv-day" title="8–20"><i style="left: 0; width: 17%"></i><i style="left: 42%; width: 25%"></i><i style="left: 83%; width: 17%"></i></span>
					<span class="pv-room"><b>T.1.3</b><span><Icon name="people" size={13} stroke={2.2} />80</span></span>
					<span class="pv-room"><b>B.2.4</b><span><Icon name="people" size={13} stroke={2.2} />64</span></span>
				</div>
				<div slot="media-2" class="pv-mini" role="img" aria-label="Illustration: three courses picked, and the week they make, with rooms">
					<span class="pv-pick">{picks.map((pick) => <span class:list={[{ on: pick.on }]}><i>{pick.on && <Icon name="check" size={11} stroke={3} />}</i>{pick.name}</span>)}</span>
					<span class="pv-week">
						{['L', 'M', 'M', 'G', 'V'].map((d, k) => <b style={`grid-column: ${k + 1}`}>{d}</b>)}
						{week.map((slot) => <i style={`grid-column: ${slot.day}; grid-row: ${slot.from + 1} / span ${slot.span}; background: var(--${slot.tint})`}>{slot.room}</i>)}
					</span>
				</div>
				<div slot="media-3" class="pv-mini" role="img" aria-label="Illustration: a course sheet with a lecturer for each alphabetical group, yours marked">
					<b class="pv-mini-title">Basi di Dati</b>
					<span class="pv-kicker">Docenti per scaglione</span>
					<span class="pv-group"><b>A–K</b><span>Prof. A. R.</span></span>
					<span class="pv-group mine"><b>L–Z</b><span>Prof. L. C.</span><em>il tuo</em></span>
					<span class="pv-more">Programma, libri e dettagli<Icon name="chevron-right" size={14} stroke={2.4} /></span>
				</div>
				<div slot="media-4" class="pv-mini" role="img" aria-label="Illustration: two WeBeep deadlines on Today, one due tonight at 23:59">
					<span class="pv-kicker">Scadenze</span>
					<span class="pv-deadline soon"><i class="c-orange"></i><span><b>Consegna del progetto</b><span>Tecnologie per il Web</span></span><em>oggi<br />23:59</em></span>
					<span class="pv-deadline"><i class="c-violet"></i><span><b>Homework 2</b><span>Basi di Dati</span></span><em>ven<br />18:00</em></span>
				</div>
				<div slot="media-5" class="pv-mini" role="img" aria-label="Illustration: an enrolment closing in two days, then a mark to decide, then an exam">
					<span class="pv-due c-orange"><span class="pv-tag">Iscrizioni in chiusura</span><b>Probabilità e Statistica</b><span>chiude tra 2 giorni</span></span>
					<span class="pv-due c-violet"><span class="pv-tag">Voto da decidere</span><b>Basi di Dati</b><span class="pv-grade">27</span></span>
					<span class="pv-due"><span class="pv-tag">Esame in arrivo</span><b>Reti di Calcolatori</b><span>8 ottobre</span></span>
				</div>
				<div slot="media-6" class="pv-mini" role="img" aria-label="Illustration: searching Reti finds a course, a lesson and an exam sitting">
					<span class="pv-field">Reti</span>
					<span class="pv-hit"><em>Corso</em><b>Reti di Calcolatori</b><span>10 CFU</span></span>
					<span class="pv-hit"><em>Lezione</em><b>Reti di Calcolatori</b><span>lun 12:15 · T.2.1</span></span>
					<span class="pv-hit"><em>Appello</em><b>Reti di Calcolatori</b><span>8 ott · 9:00</span></span>
				</div>
			</MediaCards>
		</Section>

		<Section eyebrow="PoliVerse · Beyond the app" title="Everywhere a student looks." dim="Not only inside the app.">
			<Bento label="Beyond the app" tiles={[
				{ eyebrow: 'WidgetKit', title: 'Widgets.', text: 'Next lecture, today, career and free rooms. The free-rooms widget fetches its own data, with a button to refresh it.', tone: 'blue', size: 'large' },
				{ eyebrow: 'ActivityKit', title: 'The Lock Screen.', text: 'A Live Activity follows the lesson in progress, and the exam on the day of the exam.', tone: 'dark', size: 'tall' },
				{ eyebrow: 'watchOS', title: 'Apple Watch.', text: 'Today’s lectures and the next exam, sent from the phone.', tone: 'violet', size: 'tall' },
				{ eyebrow: 'App Intents', title: 'Siri and Spotlight.', text: 'Courses, sittings and rooms are things Siri knows, not only screens it can open.', tone: 'acid', size: 'wide' },
				{ eyebrow: 'AVKit', title: 'Lesson recordings.', text: 'In the system player, resumed where you stopped, and downloadable when the teacher allows it.', tone: 'orange', size: 'wide' },
			]}>
				<div slot="tile-1" class="pv-widgets" aria-hidden="true">
					<span class="pv-w"><em>Prossima</em><b>Reti di Calcolatori</b><span>12:15 · T.2.1</span></span>
					<span class="pv-w dark"><em>Aule libere</em><b>12</b><span>Leonardo</span></span>
				</div>
				<div slot="tile-2" class="pv-live" aria-hidden="true">
					<span class="pv-live-time st-mono">10:41</span>
					<span class="pv-live-card"><span><em>Lezione in corso</em><b>Ingegneria del Software</b></span><span class="pv-live-left st-mono">34 min</span><span class="pv-bar"><i style="width: 72%"></i></span></span>
				</div>
				<div slot="tile-3" class="pv-wrist" aria-hidden="true"><span class="pv-watch small"><span class="st-mono">Esame</span><b>Probabilità</b><span>6 ott · 9:00</span></span></div>
				<div slot="tile-4" class="pv-siri" aria-hidden="true">
					<span class="pv-ask">“Quando è il prossimo esame?”</span>
					<span class="pv-answer"><em>Probabilità e Statistica</em><b>6 ottobre, 9:00</b></span>
				</div>
				<div slot="tile-5" class="pv-player" aria-hidden="true">
					<span class="pv-player-frame"><i></i></span>
					<span class="pv-bar"><i style="width: 46%"></i></span>
					<span class="st-mono">Riprendi da 41:12 · scaricata</span>
				</div>
			</Bento>
		</Section>

		<Section id="personalise" tone="dark" center eyebrow="PoliVerse · Personalizza" title="Make it yours." dim="One colour becomes the whole app." index={3}
