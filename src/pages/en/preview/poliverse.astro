	/* I disegni nelle carte dei punti salienti. */
	/* La prima: i sei servizi, sparsi, entrano in orbita attorno all'app e ci restano, girando. Senza
	   script o senza movimento si vede già il punto d'arrivo, fermo; con lo script la carta aspetta di
	   essere davanti. */
	.pv-combine { position: relative; container-type: size; }
	.pv-ring { position: absolute; left: 12%; top: 18%; width: 76%; height: 72%; border-radius: 50%; box-shadow: inset 0 0 0 1.5px rgba(244, 241, 233, .22); -webkit-mask: conic-gradient(#000 var(--sweep), transparent 0); mask: conic-gradient(#000 var(--sweep), transparent 0); }
	.pv-core { position: absolute; left: 50%; top: 54%; width: clamp(64px, 13cqw, 116px); translate: -50% -50%; }
	.pv-core::before { content: ''; position: absolute; inset: -70%; border-radius: 50%; background: radial-gradient(closest-side, rgba(107, 173, 240, .34), transparent); }
	.pv-core img { position: relative; display: block; width: 100%; height: auto; filter: drop-shadow(0 12px 28px rgba(0, 0, 0, .45)); }
	.pv-chip { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; display: grid; grid-template-columns: auto auto; align-items: center; column-gap: 10px; padding: 7px 16px 7px 7px; border-radius: 999px; background: #2c2c26; box-shadow: inset 0 0 0 1px rgba(244, 241, 233, .14), 0 10px 24px rgba(0, 0, 0, .35); color: #f4f1e9; white-space: nowrap; }
	.pv-chip :global(.st-icon) { grid-row: span 2; width: 34px; height: 34px; padding: 8px; border-radius: 50%; background: var(--tint); color: #171713; }
	.pv-chip b { font-size: 14px; font-weight: 600; line-height: 1.15; }
	.pv-chip small { font-size: 11.5px; line-height: 1.2; color: #c9c5bc; }
	/* Dove seno e coseno si calcolano, ogni servizio sta sull'orbita per angolo, e così ci può girare:
	   davanti cresce del 6% e si schiarisce, dietro rimpicciolisce e si scurisce. */
	@supports (translate: calc(cos(0deg) * 1px)) {
		.pv-chip { left: 50%; top: 54%; translate: calc(-50% + cos(var(--pv-angle)) * var(--rx, 38cqw)) calc(-50% + sin(var(--pv-angle)) * 36cqh); scale: calc(1 + sin(var(--pv-angle)) * .06); filter: brightness(calc(.91 + sin(var(--pv-angle)) * .09)); }
	}
	/* Le pillole intere girano senza toccarsi né uscire dalla carta solo da 860 px in su: sotto, icona e nome. */
	@container (max-width: 860px) {
		.pv-chip { grid-template-columns: auto; justify-items: center; row-gap: 5px; padding: 0; background: none; box-shadow: none; }
		.pv-chip :global(.st-icon) { grid-row: auto; width: 30px; height: 30px; padding: 7px; }
		.pv-chip b { font-size: 11px; }
		.pv-chip small { display: none; }
	}
	/* Sui telefoni più stretti l'orbita si allarga un poco e i nomi si stringono, così passando in basso
	   due servizi vicini non si sovrappongono. */
	@container (max-width: 240px) {
		.pv-ring { left: 8%; width: 84%; }
		.pv-chip { --rx: 42cqw; }
		.pv-chip :global(.st-icon) { width: 26px; height: 26px; padding: 6px; }
		.pv-chip b { font-size: 10px; }
	}
	@property --sweep { syntax: '<angle>'; inherits: false; initial-value: 360deg; }
	@property --pv-angle { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
	@keyframes pv-chip-in {
		0% { opacity: 0; transform: translate(calc(var(--dx) * 1cqw), calc(var(--dy) * 1cqh)) rotate(var(--r)) scale(.96); }
		14%, 34% { opacity: 1; transform: translate(calc(var(--dx) * 1cqw), calc(var(--dy) * 1cqh)) rotate(var(--r)); }
		100% { opacity: 1; transform: none; }
	}
	@keyframes pv-core-in { 0% { opacity: 0; scale: .6; } 60% { opacity: 1; scale: 1.06; } 100% { opacity: 1; scale: 1; } }
	@keyframes pv-ring-in { from { --sweep: 0deg; } to { --sweep: 360deg; } }
	@keyframes pv-orbit { from { --pv-angle: 0deg; } to { --pv-angle: 360deg; } }
	@media (prefers-reduced-motion: no-preference) {
