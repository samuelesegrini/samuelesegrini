---
/**
 * Anteprima non elencata del racconto di PoliVerse, costruita solo con le sezioni della seconda
 * serie. I numeri vengono dal repository (commit e983281) e hanno la loro nota in fondo; le icone
 * sono i file veri dell'app; le schermate sono illustrazioni dichiarate dell'interfaccia italiana,
 * da sostituire con le catture del test ScreenshotSweepUITests. Fuori dalla sitemap, noindex.
 */
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import {
	Story, Section, Device, AppHero, Lockup, HighlightsGallery, FeatureExplorer, MediaCards, ToggleFigure, Stats,
	ChangeLog, ThenNow, Findings, CodeSteps, StateMachine, ExplodedStack, Declaration, Principles, Limits, TechSpecs,
	Sources, Faq, KeepExploring, PageIndex,
} from '../../../components/story';
import { labPaths, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';

const repo = 'https://github.com/samuelesegrini/PoliVerse';
const icon = (name: string) => withBase(`/images/projects/poliverse/icons/${name}.svg`);
const cover = (name: string) => withBase(`/images/projects/covers/${name}.svg`);

// I colori in cui escono Giorno e Vicino: gli stessi da cui parte un Flavor (AppIconChoice).
const colours: [string, string][] = [
	['classic', 'Classic'], ['lavender', 'Lavender'], ['indigo', 'Indigo'], ['sky', 'Sky'], ['mint', 'Mint'], ['sage', 'Sage'],
	['mandarin', 'Mandarin'], ['coral', 'Coral'], ['raspberry', 'Raspberry'], ['coffee', 'Coffee'], ['slate', 'Slate'], ['graphite', 'Graphite'],
];
const specials: [string, string][] = [
	['neon', 'Neon'], ['spectrum', 'Spectrum'], ['leather', 'Leather'], ['holographic', 'Holographic'], ['hyperspace', 'Hyperspace'],
	['blueprint', 'Blueprint'], ['circuit', 'Circuit'], ['heavens', 'Heavens'], ['observatory', 'Observatory'], ['soft', 'Soft'], ['paper', 'Paper'],
];
const appearances: [string, string][] = [['orbit', 'Default'], ['orbit-dark', 'Dark'], ['orbit-clear', 'Clear'], ['orbit-tinted', 'Tinted']];

// La rampa del Flavor di partenza, dal diagramma DocC flavor-ramp.svg: dal più profondo al più chiaro.
const ramp = ['#11777A', '#13758A', '#157099', '#1767A8', '#195BB8', '#1B4BC7', '#1D37D6', '#1F20E5'];

const sections = [
	{ kicker: 'Chapter 1 of 7', value: 'Highlights', detail: { kicker: 'In short', value: '5 highlights' } },
	{ kicker: 'Chapter 2 of 7', value: 'The app', detail: { kicker: 'Tabs', value: 'Today · Courses · Career · Search' } },
	{ kicker: 'Chapter 3 of 7', value: 'Make it yours', detail: { kicker: 'Icons', value: '36 to choose from' } },
	{ kicker: 'Chapter 4 of 7', value: 'Fifteen days', detail: { kicker: 'Commits', value: '309' } },
	{ kicker: 'Chapter 5 of 7', value: 'Under the hood', detail: { kicker: 'Public API', value: 'none' } },
	{ kicker: 'Chapter 6 of 7', value: 'Decisions', detail: { kicker: 'Written down', value: '6 rules' } },
	{ kicker: 'Chapter 7 of 7', value: 'Specs & questions', detail: { kicker: 'Dependencies', value: 'none' } },
];

const cieFlow = `web view sees  https://ios.idserver.servizicie.interno.gov.it/…&nextUrl=…
     ↓ cancel
we open        CIEID://https://ios.idserver…&sourceApp=one.wape.PoliVerse
     ↓ the student taps the card and enters the PIN
CieID opens    one.wape.PoliVerse://https://idserver.servizicie.interno.gov.it/…
     ↓ onOpenURL → CieIDRouter
we strip to    https://idserver.servizicie.interno.gov.it/…
     ↓ load into the same web view, which holds the session
login continues`;
---

<ExperimentLayout lang="en" title="PoliVerse (preview)" currentHref="/en/preview/poliverse/" sections={sections} itHref={labPaths.it.home} enHref={labPaths.en.home} noindex>
	<Story>
		<AppHero name="PoliVerse" title="Your whole Politecnico. In one app." tint="blue"
			summary="An unofficial app for Politecnico di Milano students: timetable, courses, WeBeep materials, lesson recordings, exams and rooms, on iPhone, iPad, Apple Watch and the Lock Screen. It opens with content, even offline."
			meta="Individual work · SwiftUI · iOS 27 · September 2026"
			actions={[{ label: 'Read the story', href: '#highlights' }, { label: 'Source on GitHub', href: repo }]}>
			<img slot="mark" src={icon('orbit')} alt="" width="104" height="104" class="pv-mark" />
			<Fragment slot="devices">
				<Device kind="iphone">
					<div class="pv-phone" role="img" aria-label="Illustration of the Today tab in Italian: the date large, the lesson in progress, what is coming up and the rest of the day">
						<span class="pv-status st-mono">9:41</span>
						<span class="pv-hello">Buona giornata!</span>
						<span class="pv-date"><b>24.09</b><b>GIO</b></span>
						<span class="pv-kicker">Lezione in corso</span>
						<span class="pv-card now"><span class="pv-tag">10:15 – 12:15 · Aula 3.1.2</span><b>Ingegneria del Software</b><span class="pv-bar"><i style="width: 38%"></i></span></span>
						<span class="pv-kicker">In arrivo</span>
						<span class="pv-row"><i class="c-orange"></i><span><b>Probabilità e Statistica</b><span>Esame · tra 12 giorni</span></span></span>
						<span class="pv-row"><i class="c-violet"></i><span><b>Tecnologie per il Web</b><span>Consegna · domani 23:59</span></span></span>
						<span class="pv-accessory"><i></i>Ingegneria del Software · 3.1.2</span>
						<span class="pv-tabs"><i class="on">Oggi</i><i>Corsi</i><i>Carriera</i><i>Cerca</i></span>
					</div>
				</Device>
				<div class="st-ahero-side">
					<Device kind="watch">
						<div class="pv-watch" role="img" aria-label="Illustration of the Watch app: the next lecture"><span class="st-mono">Prossima lezione</span><b>Reti di Calcolatori</b><span>12:15 · T.2.1</span></div>
					</Device>
					<span class="st-mono">Illustrations of the Italian interface. On the wrist: the day and the next exam, sent from the phone.</span>
				</div>
			</Fragment>
		</AppHero>

		<Section id="highlights" tone="ink2" title="The highlights." link={{ label: 'Browse the source', href: repo }} index={1}>
			<HighlightsGallery cards={[
				{ text: 'The Politecnico has no public API. PoliVerse reads the config the official app reads, so a moved backend costs no release.', meta: 'Service directory · 11 September', name: 'No public API', tone: 'blue' },
				{ text: '“Entra con CIE” comes back to the app, not to Safari.', meta: 'CieID hand-off · sourceApp', name: 'CIE login', tone: 'dark' },
				{ text: 'It opens with content, even offline. A failed refresh never clears the screen.', meta: 'Store · offline copy', name: 'Offline first', tone: 'acid' },
				{ text: 'It reads, and never writes. A wrong read costs a refresh; a wrong write costs a session.', meta: 'Decision · 22 September', name: 'Read-only on purpose', tone: 'orange' },
				{ text: 'One colour becomes the whole app, down to the icon on the Home Screen.', meta: 'Personalizza · 36 icons', name: 'Make it yours', tone: 'violet' },
			]}>
				<div slot="media-1" class="pv-json st-mono" aria-hidden="true">
					<span>GET …/polimi_app/rest/jaf/public/props <em>200 · no auth</em></span>
					<span>"iae.base_url": "https://api.polimi.it/iae"</span>
					<span>"libretto.base_url": "…/piano_studente"</span>
					<span>"ws_aule.base_url": "…/ws_aule"</span>
				</div>
				<ol slot="media-2" class="pv-steps st-mono" aria-label="The CIE hand-off in four steps">
					<li>catch the CieID link</li><li>re-open it with sourceApp</li><li>card + PIN in CieID</li><li class="ok">back in PoliVerse</li>
				</ol>
				<div slot="media-3" class="pv-fresh" role="img" aria-label="A cached timetable still on screen, with a line saying it is forty minutes old and the refresh failed">
					<span class="pv-fresh-line st-mono"><i></i>Cached copy · 40 min old · refresh failed</span>
					<span class="pv-fresh-card"><b>12:15</b><span>Reti di Calcolatori</span></span>
					<span class="pv-fresh-card"><b>14:15</b><span>Basi di Dati</span></span>
				</div>
				<ol slot="media-4" class="pv-nope" aria-label="Actions the app does not perform">
					<li>Enrol in a sitting</li><li>Refuse a mark</li><li>Post in a forum</li><li>Hand in an assignment</li>
				</ol>
				<ul slot="media-5" class="pv-icon-strip" aria-label="Six of the app icons">
					{['orbit', 'dial-mint', 'closeup-coral', 'special-neon', 'special-blueprint', 'special-soft'].map((n) => <li><img src={icon(n)} alt="" width="120" height="120" loading="lazy" /></li>)}
				</ul>
			</HighlightsGallery>
		</Section>

		<Section id="app" eyebrow="PoliVerse · Take a closer look" title="Four tabs." dim="One question each." index={2}>
			<FeatureExplorer label="Tabs" device="iphone" note="Illustrations of the Italian interface · screenshots to follow" features={[
				{ title: 'Today', file: 'Features/Shell', tint: 'blue', text: 'What is on today? The date, the lesson in progress, then what is coming, the timetable, deadlines and exams. Every section can be moved, hidden or redrawn.' },
				{ title: 'Courses', file: 'Features/Home · WeBeep', tint: 'acid', text: 'What is new in my courses? Each course gathers its notices, materials, recordings, sittings, forum and syllabus, with unread counts on the way in.' },
				{ title: 'Career', file: 'Features/Career', tint: 'violet', text: 'What is due? Rebuilt around what closes next rather than what is already true: enrolments closing, marks to decide, sittings, and the average as a line over time.' },
				{ title: 'Search', file: 'Features/Search', tint: 'orange', text: 'Where, and what? One field across courses, agenda and sittings, then rooms with their equipment, free rooms, and the campus map down to floor plans.' },
			]}>
				<div slot="screen-1" class="pv-phone" role="img" aria-label="Illustration: the Today tab">
					<span class="pv-hello">Buona giornata!</span>
					<span class="pv-date"><b>24.09</b><b>GIO</b></span>
					<span class="pv-kicker">Lezione in corso</span>
					<span class="pv-card now"><span class="pv-tag">10:15 – 12:15 · Aula 3.1.2</span><b>Ingegneria del Software</b><span class="pv-bar"><i style="width: 38%"></i></span></span>
					<span class="pv-kicker">Orario</span>
					<span class="pv-row"><i class="c-violet"></i><span><b>Reti di Calcolatori</b><span>12:15 · T.2.1</span></span></span>
					<span class="pv-row"><i class="c-orange"></i><span><b>Basi di Dati</b><span>14:15 · B.4.2</span></span></span>
					<span class="pv-kicker">Esami</span>
					<span class="pv-row"><i class="c-blue"></i><span><b>Probabilità e Statistica</b><span>6 ott · 9:00</span></span></span>
				</div>
				<div slot="screen-2" class="pv-phone" role="img" aria-label="Illustration: the Courses tab">
					<span class="pv-title">Corsi</span>
					<span class="pv-feature"><span class="pv-tag">In evidenza</span><b>Ingegneria del Software</b>
						<span class="pv-chips"><i>Avvisi <em>2</em></i><i>Materiali</i><i>Registrazioni</i><i>Appelli</i></span>
					</span>
					<span class="pv-kicker">Preferiti</span>
					<span class="pv-tiles">
						<span class="c-violet"><b>Reti di Calcolatori</b><em>1 nuovo</em></span>
						<span class="c-orange"><b>Basi di Dati</b></span>
						<span class="c-blue"><b>Probabilità e Statistica</b></span>
						<span class="c-acid"><b>Tecnologie per il Web</b><em>Consegna</em></span>
					</span>
				</div>
				<div slot="screen-3" class="pv-phone" role="img" aria-label="Illustration: the Career tab">
					<span class="pv-title">Carriera</span>
					<span class="pv-due c-orange"><span class="pv-tag">Iscrizioni in chiusura</span><b>Probabilità e Statistica</b><span>chiude tra 2 giorni</span></span>
					<span class="pv-due c-violet"><span class="pv-tag">Voto da decidere</span><b>Basi di Dati</b><span class="pv-grade">27</span></span>
					<span class="pv-due"><span class="pv-tag">Esame in arrivo</span><b>Reti di Calcolatori</b><span>8 ottobre</span></span>
					<span class="pv-avg"><span><b>27,4</b><em>media ponderata · dati di esempio</em></span>
						<svg viewBox="0 0 200 60" aria-hidden="true"><polyline points="0,44 30,40 60,46 90,30 120,34 150,22 200,18" /></svg>
					</span>
				</div>
				<div slot="screen-4" class="pv-phone" role="img" aria-label="Illustration: the Search tab">
					<span class="pv-title">Cerca</span>
					<span class="pv-field">Reti</span>
					<span class="pv-chips"><i>Aule</i><i>Aule libere</i><i>Mappa</i><i>Piano di studi</i></span>
					<span class="pv-kicker">Risultati</span>
					<span class="pv-row"><i class="c-violet"></i><span><b>Reti di Calcolatori</b><span>Corso · 10 CFU</span></span></span>
					<span class="pv-row"><i class="c-blue"></i><span><b>Reti Logiche</b><span>Esame superato · 28</span></span></span>
					<span class="pv-kicker">Aule libere ora</span>
					<span class="pv-rooms"><i>3.0.1</i><i>T.1.3</i><i>B.2.4</i><i>+9</i></span>
				</div>
			</FeatureExplorer>
		</Section>

		<Section eyebrow="PoliVerse · Beyond the app" title="Everywhere a student looks." dim="Not only inside the app.">
			<MediaCards label="Beyond the app" items={[
				{ lead: 'Widgets.', text: 'Next lecture, today, career and free rooms. The free-rooms widget fetches its own data, with a button to refresh it.', tone: 'blue', tag: 'WidgetKit' },
				{ lead: 'The Lock Screen.', text: 'A Live Activity follows the lesson in progress, and the exam on the day of the exam.', tone: 'dark', tag: 'ActivityKit' },
				{ lead: 'Apple Watch.', text: 'Today’s lectures and the next exam, sent from the phone over WatchConnectivity.', tone: 'violet', tag: 'watchOS' },
				{ lead: 'Siri and Spotlight.', text: 'Courses, sittings and rooms are things Siri knows, not only screens it can open.', tone: 'acid', tag: 'App Intents' },
				{ lead: 'Lesson recordings.', text: 'In the system player, resumed where you stopped, and downloadable when the teacher allows it.', tone: 'orange', tag: 'AVKit' },
			]}>
				<div slot="media-1" class="pv-widgets" aria-hidden="true">
					<span class="pv-w"><em>Prossima</em><b>Reti di Calcolatori</b><span>12:15 · T.2.1</span></span>
					<span class="pv-w dark"><em>Aule libere</em><b>12</b><span>Leonardo</span></span>
				</div>
				<div slot="media-2" class="pv-live" aria-hidden="true">
					<span class="pv-live-time st-mono">10:41</span>
					<span class="pv-live-card"><span><em>Lezione in corso</em><b>Ingegneria del Software</b></span><span class="pv-live-left st-mono">34 min</span><span class="pv-bar"><i style="width: 72%"></i></span></span>
				</div>
				<div slot="media-3" class="pv-wrist" aria-hidden="true"><span class="pv-watch small"><span class="st-mono">Esame</span><b>Probabilità</b><span>6 ott · 9:00</span></span></div>
				<div slot="media-4" class="pv-siri" aria-hidden="true">
					<span class="pv-ask">“Quando è il prossimo esame?”</span>
					<span class="pv-answer"><em>Probabilità e Statistica</em><b>6 ottobre, 9:00</b></span>
				</div>
				<div slot="media-5" class="pv-player" aria-hidden="true">
					<span class="pv-player-frame"><i></i></span>
					<span class="pv-bar"><i style="width: 46%"></i></span>
					<span class="st-mono">Riprendi da 41:12 · scaricata</span>
				</div>
			</MediaCards>
		</Section>

		<Section id="personalise" tone="dark" center eyebrow="PoliVerse · Personalizza" title="Make it yours." dim="One colour becomes the whole app." index={3}
			lead="Almost nothing in PoliVerse is drawn in a fixed colour. A look starts from one colour; every card, control and typeface reads it, and every colour is checked for contrast before it is drawn.">
			<figure class="pv-flavor">
				<div class="pv-flavor-row">
					<span class="pv-swatch"><i style="background: #0F3D6E"></i><b>Main</b><span class="st-mono">#0F3D6E</span><em>the colour the student picked</em></span>
					<span class="pv-arrow" aria-hidden="true">→</span>
					<span class="pv-swatch"><i style="background: #155B5E"></i><b>Accent</b><span class="st-mono">#155B5E</span><em>hue −0.08 · sat ×0.90 · bri ×0.85</em></span>
					<span class="pv-arrow" aria-hidden="true">→</span>
					<span class="pv-swatch"><i style="background: #0E4D29"></i><b>Extra</b><span class="st-mono">#0E4D29</span><em>hue −0.18 · sat ×0.95 · bri ×0.70</em></span>
				</div>
				<ol class="pv-ramp" aria-label="The ramp a page hands its colours out from, deepest to palest">
					{ramp.map((c) => <li style={`background: ${c}`}><span class="st-mono">{c}</span></li>)}
				</ol>
				<figcaption><b>Flavor.</b> Accent and Extra sit a step and two steps around the wheel from Main; a page hands out the ramp by position. A grey has no hue to move along, so below 0.12 saturation it only deepens. Values from the app’s own documentation.</figcaption>
			</figure>
		</Section>

		<Section tone="dark" center eyebrow="PoliVerse · The icon" title="One planet." dim="Thirty-six ways to wear it."
			lead="A ringed planet, the -Verse of PoliVerse, with one amber moon for what comes next. It avoids the mortarboard every university app reaches for, uses no SF Symbols, and carries nothing from the Politecnico’s identity.">
			<ToggleFigure label="Choose an icon shape" options={[
				{ label: 'Orbita', lead: 'Orbita, the icon that ships.', text: 'In the four appearances iOS asks for: default, dark, clear and tinted.', tone: 'blue' },
				{ label: 'Giorno', lead: 'Giorno, the day as a dial.', text: 'The moon on the rim of the day, in the twelve colours a Flavor starts from.', tone: 'acid' },
				{ label: 'Vicino', lead: 'Vicino, the planet up close.', text: 'The planet filling the corner, in the same twelve colours. Paired with a look, the app picks the nearest one.', tone: 'violet' },
				{ label: 'Special', lead: 'Eleven specials, free for everyone.', text: 'Each a picture of its own rather than a colour of a shape. The icon changes once, when Personalizza closes, because iOS announces every change.', tone: 'orange' },
			]}>
				<ul slot="panel-1" class="pv-icons big">
					{appearances.map(([n, label]) => <li><img src={icon(n)} alt="" width="160" height="160" loading="lazy" /><span>{label}</span></li>)}
				</ul>
				<ul slot="panel-2" class="pv-icons">
					{colours.map(([n, label]) => <li><img src={icon(`dial-${n}`)} alt="" width="96" height="96" loading="lazy" /><span>{label}</span></li>)}
				</ul>
				<ul slot="panel-3" class="pv-icons">
					{colours.map(([n, label]) => <li><img src={icon(`closeup-${n}`)} alt="" width="96" height="96" loading="lazy" /><span>{label}</span></li>)}
				</ul>
				<ul slot="panel-4" class="pv-icons">
					{specials.map(([n, label]) => <li><img src={icon(`special-${n}`)} alt="" width="96" height="96" loading="lazy" /><span>{label}</span></li>)}
				</ul>
			</ToggleFigure>
		</Section>

		<Section id="numbers" eyebrow="PoliVerse · The repository" title="Fifteen days, one person." dim="Counted, not estimated." index={4}>
			<Stats items={[
				{ label: 'Commits', value: '309', text: 'from 10 to 24 September 2026', method: 'every commit on main, all mine', note: 1, accent: true },
				{ label: 'Unit tests', value: '1,220', text: 'plus 49 UI tests', method: 'Swift Testing and XCTest', note: 2 },
				{ label: 'Swift', value: '89.6', unit: 'k', text: 'lines in 460 files', method: 'app, widgets, Watch and tests', note: 3 },
				{ label: 'Dependencies', value: '0', text: 'third-party packages', method: 'Apple frameworks only', note: 4 },
			]} feature={{ label: 'Feature areas', value: '17', text: 'one folder each, from Auth to WeBeep' }}>
				The first commit rebuilt the app from scratch; the <b>2023 prototype was a home-screen mockup with hard-coded data and no networking</b>. Every service now ships with sample data derived from one fictional degree, so the whole app renders without an account, and <b>every screen says so while it does</b>.
			</Stats>
		</Section>

		<Section eyebrow="PoliVerse · Day by day" title="What each day added." dim="Newest first.">
			<ChangeLog columns={['Day', 'Commits', 'Changes']} releases={[
				{ version: '24 Sep', when: '6 commits', changes: [
					{ kind: 'added', text: 'Icons rebuilt in Icon Composer: Orbita, Giorno and Vicino in every colour, and eleven specials.' },
					{ kind: 'added', text: 'Blueprint and Playful, two special Flavors that redraw every tab.' },
					{ kind: 'changed', text: 'Each tab answers one question.' },
				] },
				{ version: '23 Sep', when: '10 commits', changes: [
					{ kind: 'added', text: 'Lesson recordings in the system player, resumed where you stopped, downloadable for offline viewing.' },
					{ kind: 'fixed', text: 'A refreshed token keeps its scope, so the app no longer signs out at every launch.' },
				] },
				{ version: '22 Sep', when: '12 commits', changes: [
					{ kind: 'note', text: 'Reads, never writes: written down as a decision, with its reasons.' },
					{ kind: 'added', text: 'Apple Watch, exams on the Lock Screen, Siri entities, and on-device summaries of long notices.' },
				] },
				{ version: '20–21 Sep', when: '22 commits', changes: [
					{ kind: 'changed', text: 'Every service behind one Store, instead of nineteen copies.' },
					{ kind: 'changed', text: 'Career rebuilt around what is due, not what is already true.' },
				] },
				{ version: '17 Sep', when: '39 commits', changes: [
					{ kind: 'added', text: 'UI tests for navigation, search, lifecycle and accessibility audits.' },
					{ kind: 'changed', text: 'Minimum iOS 27, and 110 model files regrouped by area.' },
				] },
				{ version: '15–16 Sep', when: '81 commits', changes: [
					{ kind: 'added', text: 'The four-tab interface, Personalizza with its gallery of looks, and glass course pages.' },
					{ kind: 'added', text: 'Widgets, controls and a Live Activity, registered in one bundle.' },
				] },
				{ version: '13–14 Sep', when: '58 commits', changes: [
					{ kind: 'added', text: 'Alerts when an exam changes, when WeBeep posts marks or solutions, and before a deadline.' },
					{ kind: 'added', text: 'A personal timetable built in the app until the official one arrives, and an English translation.' },
				] },
				{ version: '12 Sep', when: '38 commits', changes: [
					{ kind: 'added', text: 'Campus map down to floor plans, study plan, grade simulation and reminders.' },
					{ kind: 'fixed', text: 'Stopped re-downloading 13.7 MB on every login.' },
				] },
				{ version: '11 Sep', when: '37 commits', changes: [
					{ kind: 'added', text: 'WeBeep through Moodle web services, news, notifications and free rooms.' },
					{ kind: 'changed', text: 'Service hosts read from the Politecnico’s own config instead of hard-coded.' },
					{ kind: 'fixed', text: 'The CIE login stays in the app instead of being lost to Safari.' },
				] },
				{ version: '10 Sep', when: '6 commits', style: 'outline', changes: [
					{ kind: 'added', text: 'Rebuilt from scratch: a real sign-in layer, calendar, career, search, a disk cache and the first 24 tests.' },
				] },
			]} />
		</Section>

		<Lockup id="backend" index={5} number="05" label="Under the hood" title="There is no public API." dim="So it reads what the official app reads."
			deepDive="Deep dive: how the map was drawn" next={{ label: 'Next: signing in with CIE', href: '#cie' }}
			facts={[{ label: 'Service config', value: '200', note: 'public, no sign-in' }, { label: 'Path exists', value: '401', accent: true }, { label: 'Path gone', value: '404' }]}
			factsNote="Probed 11 September 2026">
			The official web app is a public single-page app, and its bundle carries the route table and every path. On launch the official app fetches <b>one unauthenticated config with every backend’s address</b>. PoliVerse reads the same config, with the current hosts compiled in as fallbacks, so <b>a backend that moves costs a fetch, not a release</b>.
			<Fragment slot="deep-dive"><p>No proxy and no TLS interception: the web bundle, about 8 MB, is served to anyone who asks. Each path found in it was then probed without credentials. A 401 means the path exists and wants a token; a 404 means it is gone.</p></Fragment>
		</Lockup>

