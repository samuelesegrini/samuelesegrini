	.pv-deadline { display: grid; grid-template-columns: 6px 1fr auto; align-items: center; gap: 10px; padding: 10px; border-radius: 14px; box-shadow: inset 0 0 0 1.5px rgba(23, 23, 19, .25); }
	.pv-deadline > i { align-self: stretch; border-radius: 3px; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-deadline > span { display: grid; gap: 1px; } .pv-deadline > span span { font-size: 11px; color: #5e5a53; }
	.pv-deadline em { font: 700 11px/1.25 var(--mono); font-style: normal; text-align: right; }
	.pv-deadline.soon { box-shadow: inset 0 0 0 1.5px #171713; } .pv-deadline.soon em { color: #a3360d; }
	.pv-hit { display: grid; grid-template-columns: 58px 1fr; column-gap: 8px; padding: 8px 2px; border-top: 1px solid rgba(23, 23, 19, .12); }
	.pv-hit em { grid-row: span 2; align-self: start; padding: 2px 0; border-radius: 6px; background: rgba(23, 23, 19, .07); font: 10px var(--mono); font-style: normal; text-align: center; }
	.pv-hit b { font-size: 13px; } .pv-hit span { font-size: 11px; color: #5e5a53; }
	/* La terza entra quando la sua carta è davanti in vista la prima volta, poi resta e scorre. */
	@keyframes pv-slide { from { opacity: 0; translate: calc((var(--r) - 1.5) * -4% + (var(--r) - 1.5) * 12%) 0; } to { opacity: 1; } }
	@media (prefers-reduced-motion: no-preference) {
		:global(.st-hgallery[data-bound]) .pv-wall-row { opacity: 0; }
		:global(.st-hg-card[data-played]) .pv-wall-row { animation: pv-slide 1.4s cubic-bezier(.22, 1, .36, 1) calc(var(--r) * 90ms) both; }
		.pv-wall-track { animation: pv-drift var(--dur) linear infinite var(--dir); }
	}

	/* Le carte "fuori dall'app". */
