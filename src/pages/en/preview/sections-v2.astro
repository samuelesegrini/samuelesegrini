						<g stroke="#e2ddd2" stroke-width="14" stroke-linecap="round"><path d="M-10 130H230M-10 270H230M56 -10V470M160 -10V470" /></g>
						<path d="M46 360c0-50 8-66 40-80s70-20 70-72-6-88 6-112" fill="none" stroke="#171713" stroke-width="13" stroke-linecap="round" />
						<path d="M46 360c0-50 8-66 40-80s70-20 70-72-6-88 6-112" fill="none" stroke="#c7ff9f" stroke-width="7" stroke-linecap="round" />
						<circle cx="46" cy="360" r="9" fill="#171713" /><circle cx="162" cy="96" r="12" fill="#ded1ff" stroke="#171713" stroke-width="3" />
						<rect x="12" y="14" width="188" height="48" rx="14" fill="#fffefb" stroke="#171713" stroke-width="2" />
						<text x="26" y="43" class="mock-svg-title small">Safe route</text>
						<rect x="12" y="386" width="188" height="44" rx="22" fill="#171713" />
						<text x="106" y="413" text-anchor="middle" class="mock-svg-title small light">Start</text>
					</svg>
				</Device>
				<Device slot="media-2" kind="iphone">
					<div class="mock-garage" role="img" aria-label="Illustration: the Garage, with Add a vehicle at the top of the list">
						<b>Garage</b><span class="add">+ Add a vehicle</span>
						{['blue', 'orange', 'violet'].map((t) => <span class="car"><i class={`tone-${t}`}></i><span><i></i><i></i></span></span>)}
					</div>
				</Device>
				<Device slot="media-3" kind="iphone">
					<svg class="mock-fill" viewBox="0 0 212 452" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Illustration: community screen with reports pinned on a map">
						<rect width="212" height="452" fill="#f4f1e9" />
						<g stroke="#e2ddd2" stroke-width="14" stroke-linecap="round"><path d="M-10 110H230M-10 250H230M70 -10V470M150 -10V470" /></g>
						<g stroke="#171713" stroke-width="2.5" stroke-linejoin="round"><path d="M60 80 74 104H46Z" fill="#ffd4b8" /><path d="M140 170 154 194H126Z" fill="#ffd4b8" /><path d="M96 232 110 256H82Z" fill="#ffd4b8" /></g>
						<rect x="0" y="300" width="212" height="152" fill="#fffefb" /><path d="M0 300h212" stroke="#171713" stroke-width="2" />
						<text x="16" y="330" class="mock-svg-title small">Reports nearby</text>
						<rect x="16" y="346" width="180" height="10" rx="5" fill="#e2ddd2" /><rect x="16" y="346" width="120" height="10" rx="5" fill="#171713" />
						<rect x="16" y="382" width="180" height="44" rx="22" fill="#ffd4b8" stroke="#171713" stroke-width="2" />
						<text x="106" y="409" text-anchor="middle" class="mock-svg-title small">New report</text>
					</svg>
				</Device>
				<Device slot="media-4" kind="watch">
					<div class="mock-watch"><span class="st-mono">Next turn</span><svg viewBox="0 0 48 48" width="50" height="50" fill="none" stroke="#c7ff9f" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 42V24a8 8 0 0 1 8-8h18m-8-9 9 9-9 9" /></svg><b>Turn right</b></div>
				</Device>
			</MediaCards>
		</Section>

		<p class="cat-mark"><code>&lt;FeatureExplorer /&gt;</code><span>new · radio list drives one screen</span></p>
		<Section eyebrow="EasyManager · Take a closer look" title="One iPad per station." dim="Every screen reads the same order.">
			<FeatureExplorer label="Stations" note="Illustration · screenshots to replace" features={[
				{ title: 'Dining room', file: 'DiningView.swift', tint: 'acid', text: 'Tables by state and by waiter: free, booked, waiting, occupied. The floor reads it at a glance.' },
				{ title: 'Order pad', file: 'OrderSheetView.swift', tint: 'orange', text: 'Dishes by course, variants with their own price, a VAT department on every line.' },
				{ title: 'Kitchen', file: 'CookingView.swift', tint: 'blue', text: 'The same order, regrouped by course for the people who cook it.' },
				{ title: 'Till', file: 'CashDesk.swift', tint: 'violet', text: 'Pre-bill, payment by method, the fiscal receipt, then X and Z reports at closing.' },
			]}>
				<div slot="screen-1" class="mock-screen mock-dining" role="img" aria-label="Illustration: the dining room, thirteen tables coloured by state, table 7 selected">
					<div class="mock-side"><b>Dining room</b><span class="on">All waiters</span><span>Waiter 01</span><span>Waiter 02</span><span>Waiter 03</span></div>
					<div class="mock-floor">
						<div class="mock-tables">{tables.map((t) => <span class:list={['st-mono', t.s, { round: t.round, wide: t.wide, picked: t.picked }]}>{t.n}</span>)}</div>
						<div class="mock-key"><span><i class="free"></i>Free</span><span><i class="booked"></i>Booked</span><span><i class="waiting"></i>Waiting</span><span><i class="occupied"></i>Occupied</span></div>
					</div>
				</div>
				<div slot="screen-2" class="mock-screen mock-pad" role="img" aria-label="Illustration: the order pad for table 7, risotto for two in the first course">
					<div class="mock-menu">
						<div class="mock-tabs"><span class="on">Course 1</span><span>Course 2</span><span>Course 3</span></div>
						<div class="mock-dishes"><span class="on"><b>Risotto</b><span class="st-mono">14,00</span></span>{Array.from({ length: 5 }, () => <span><i></i><i></i></span>)}</div>
						<span class="st-eyebrow">Variants · priced per choice</span>
					</div>
					<div class="mock-ticket"><b>Table 7</b><span class="st-eyebrow">Course 1</span><span class="row"><span>Risotto × 2</span><span class="st-mono">28,00</span></span><span class="st-mono dept">dept. 1</span><span class="st-eyebrow">Course 2</span><span class="muted">No dishes yet</span><span class="grow"></span><span class="row total"><span>Total</span><span class="st-mono">28,00</span></span><span class="send">Send to kitchen</span></div>
				</div>
				<div slot="screen-3" class="mock-screen mock-kitchen" role="img" aria-label="Illustration: the kitchen view, orders grouped by course">
					<b>Kitchen</b>
					<div class="mock-courses">
						<div><span class="st-eyebrow">Course 1</span><span class="ticket"><b class="st-mono">T7</b><span>Risotto × 2</span></span><span class="ticket done"><b class="st-mono">T2</b><i></i></span></div>
						<div><span class="st-eyebrow">Course 2</span><span class="ticket"><b class="st-mono">T6</b><i></i><i></i></span></div>
						<div><span class="st-eyebrow">Course 3</span><span class="ticket"><b class="st-mono">T11</b><i></i></span></div>
					</div>
				</div>
