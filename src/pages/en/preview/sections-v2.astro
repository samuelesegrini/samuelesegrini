---
/**
 * Il catalogo della seconda serie di sezioni: ogni componente con contenuti veri dei progetti,
 * raggruppato come nel disegno (aperture, vetrina, prove, ingegneria, chiusure). Non elencato,
 * noindex: è il banco di prova per chi scrive le pagine. I disegni dentro gli slot sono
 * illustrazioni dichiarate, da sostituire con le schermate vere.
 */
import { Code } from 'astro:components';
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import {
	Story, Section, Device, MediaHero, AppHero, DocHero, Lockup, HighlightsGallery, MediaCards, FeatureExplorer, ToggleFigure, ExplainerFigure,
	Stats, ThenNow, Lineup, Matrix, Findings, TechSpecs, Limits, Sources, Declaration, CodeSteps, Anatomy, ExplodedStack, Modules, StateMachine,
	ChangeLog, Principles, Contribution, Faq, KeepExploring, PageIndex,
	ScrollIntro, StickyScenes, LitText, Bento, BarCompare, PlusCards, ObjectRow, BeforeAfter,
} from '../../../components/story';
import { labPaths, labPostPath, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';
import { storyDark } from '../../../lib/story-code';

const cover = (name: string) => withBase(`/images/projects/covers/${name}.svg`);
const explainer = (name: string) => withBase(`/images/projects/explainers/${name}.svg`);
const project = (slug: string) => labProjectPath('en', slug);
const repo = {
	easymanager: 'https://github.com/samuelesegrini/easymanager',
	galaxy: 'https://github.com/samuelesegrini/ing-sw-2025-segrini-terribile-varricchio-zanca',
	spingo: 'https://github.com/milenaramosduran/hci-eco',
	spingoSite: 'https://milenaramosduran.github.io/hci-eco/',
};

// il dock fa da indice dei cinque gruppi, come nelle pagine di progetto
const sections = [
	{ kicker: 'Group 1 of 5', value: 'Openers', detail: { kicker: 'Sections', value: '5 openers' } },
	{ kicker: 'Group 2 of 5', value: 'Showcase', detail: { kicker: 'Sections', value: '10 showcases' } },
	{ kicker: 'Group 3 of 5', value: 'Evidence', detail: { kicker: 'Sections', value: '9 proofs' } },
	{ kicker: 'Group 4 of 5', value: 'Engineering', detail: { kicker: 'Sections', value: '8 diagrams' } },
	{ kicker: 'Group 5 of 5', value: 'Closers', detail: { kicker: 'Sections', value: '5 endings' } },
];

const fiscal = `<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">
  <s:Body>
    <printerFiscalReceipt>
      <beginFiscalReceipt operator="1" />
      <printRecItem operator="1" description="Risotto"
        quantity="2" unitPrice="14,00" department="1" />
      <printRecTotal operator="1" description="Cash"
        payment="28,00" paymentType="0" />
      <endFiscalReceipt operator="1" />
    </printerFiscalReceipt>
  </s:Body>
</s:Envelope>`;
const receiptOnly = fiscal.split('\n').slice(3, 9).map((l) => l.slice(6)).join('\n');
const tables = [
	{ n: 1, s: 'free' }, { n: 2, s: 'occupied' }, { n: 3, s: 'booked', round: true }, { n: 4, s: 'waiting' }, { n: 5, s: 'free' },
	{ n: 6, s: 'occupied' }, { n: 7, s: 'occupied', picked: true }, { n: 8, s: 'free', round: true }, { n: 9, s: 'waiting' }, { n: 10, s: 'booked' },
	{ n: 11, s: 'occupied', wide: true }, { n: 12, s: 'free' }, { n: 13, s: 'empty', wide: true },
];
---

<ExperimentLayout lang="en" title="Story sections, second series (catalogue)" currentHref="/en/preview/sections-v2/" sections={sections} itHref={labPaths.it.home} enHref={labPaths.en.home} noindex>
	<Story>
		<!-- 0 · MediaHero -->
		<MediaHero name="EasyManager" title="From the table to the fiscal printer." image={cover('easymanager')}
			imageAlt="An iPad showing a restaurant dining room with tables coloured by state, next to an order ticket"
			meta="iPad app · 2023–2026" detail="Individual work, real restaurant" action={{ label: 'See the catalogue', href: '#openers' }}
			back={{ label: 'All projects', href: labPaths.en.work }} position={{ current: 1, total: 5 }} />
		<p class="cat-mark"><code>&lt;MediaHero /&gt;</code><span>new · opener, dock section 0</span></p>

		<!-- 1 · Aperture -->
		<div class="cat-divider" id="openers" data-section="1">
			<span class="st-mono">01 / 05</span>
			<h2>Openers</h2>
			<p>Four ways to start a page: a tinted cover, an app promise, a technical abstract, and the opener of a chapter.</p>
		</div>

		<p class="cat-mark"><code>&lt;AppHero /&gt;</code><span>new · opener</span></p>
		<AppHero id="hero-app" index={null} name="SpinGO" title="Research before code."
			summary="109 answers, 4 interviews and 7 usability sessions took a micromobility app to an 88% task success rate and a SUS score of 89.2."
			meta="Team of five · HCI, Politecnico di Milano · 2025–2026"
			actions={[{ label: 'Read the case study', href: '#findings' }, { label: 'Project website', href: repo.spingoSite }, { label: 'Team repository', href: repo.spingo }]}>
			<svg slot="mark" viewBox="0 0 64 64" fill="none" stroke="#171713" stroke-width="5" stroke-linecap="round" aria-hidden="true"><path d="M16 48c0-12 32-8 32-22 0-6-4-10-10-10" /><circle cx="16" cy="48" r="5" fill="#c7ff9f" /><circle cx="38" cy="16" r="5" fill="#fffef9" /></svg>
			<Fragment slot="devices">
				<Device kind="iphone">
					<svg class="mock-fill" viewBox="0 0 276 596" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Illustration of the route screen: a safe route drawn on a map, with a start button">
						<rect width="276" height="596" fill="#f4f1e9" />
						<rect x="148" y="96" width="150" height="170" rx="42" fill="#e3f5d2" />
						<g stroke="#e2ddd2" stroke-width="18" stroke-linecap="round" fill="none"><path d="M-10 170H290M-10 350H290M72 -10V610M204 -10V610M-10 520 140 420" /></g>
						<path d="M62 474c0-66 10-86 52-106s92-26 92-96-8-116 8-150" fill="none" stroke="#171713" stroke-width="17" stroke-linecap="round" />
						<path d="M62 474c0-66 10-86 52-106s92-26 92-96-8-116 8-150" fill="none" stroke="#c7ff9f" stroke-width="10" stroke-linecap="round" />
						<circle cx="62" cy="474" r="11" fill="#171713" /><circle cx="62" cy="474" r="4" fill="#fffef9" />
						<circle cx="214" cy="122" r="15" fill="#ded1ff" stroke="#171713" stroke-width="3.5" /><circle cx="214" cy="122" r="5" fill="#171713" />
						<rect x="16" y="20" width="244" height="64" rx="18" fill="#fffefb" stroke="#171713" stroke-width="2.5" />
						<text x="34" y="48" class="mock-svg-title">Start a safe route</text>
						<text x="34" y="68" class="mock-svg-mono">TASK 1 · NAVIGATION</text>
						<rect x="0" y="498" width="276" height="98" fill="#fffefb" /><path d="M0 498h276" stroke="#171713" stroke-width="2.5" />
						<rect x="18" y="522" width="176" height="48" rx="24" fill="#171713" />
						<text x="106" y="552" text-anchor="middle" class="mock-svg-title light">Start</text>
						<rect x="206" y="522" width="52" height="48" rx="24" fill="#ffd4b8" stroke="#171713" stroke-width="2.5" />
						<path d="M232 536v10M232 552v.5" stroke="#171713" stroke-width="3" stroke-linecap="round" />
					</svg>
				</Device>
				<div class="st-ahero-side">
					<Device kind="watch">
						<div class="mock-watch"><span class="st-mono">Next turn</span><svg viewBox="0 0 48 48" width="50" height="50" fill="none" stroke="#c7ff9f" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 42V24a8 8 0 0 1 8-8h18m-8-9 9 9-9 9" /></svg><b>Turn right</b></div>
					</Device>
					<span class="st-mono">Companion on the wrist: next turn, haptics, quick reports.</span>
				</div>
			</Fragment>
		</AppHero>

		<p class="cat-mark"><code>&lt;DocHero /&gt;</code><span>new · opener</span></p>
		<DocHero id="hero-doc" index={null} eyebrow="Case study · Digital logic · 2026" title="Priority Task Queue Manager"
			abstract="A VHDL component that keeps up to 31 tasks ordered by priority in external RAM, driven by a 15-state finite-state machine and a strict START–DONE handshake with its master."
			note={{ text: 'Cycle counts and the 603 MHz estimate come from post-synthesis analysis in Vivado.' }}
			image={explainer('priority-queue-insertion')} imageAlt="Before-and-after comparison of a task inserted after an existing item with the same priority"
			caption="Insertion shifts only lower priorities; equal ones keep their arrival order."
			facts={[{ value: '15 states', label: 'Two-process FSM', icon: 'graph' }, { value: '68 cycles', label: 'Worst-case insertion', icon: 'clock' }, { value: '31 max', label: 'Tasks in a 64 KB RAM', icon: 'table' }, { value: '10 of 10', label: 'Functional tests passed', icon: 'check' }]}
			back={{ label: 'All projects', href: labPaths.en.work }} position={{ current: 4, total: 5 }} />

		<p class="cat-mark"><code>&lt;Lockup /&gt;</code><span>new · chapter opener, paper</span></p>
		<Lockup id="fiscal-printer" number="03" label="The fiscal printer" title="A receipt is sent once." dim="It can’t be undone."
			deepDive="Deep dive: the fpmate.cgi request" next={{ label: 'Next: the device lanes', href: '#dark-lockup' }}>
			The app wraps every receipt in a SOAP envelope and posts it to the Epson printer in the room: <b>one line per dish with its VAT department, one total per payment method.</b> When the reply never comes, the 2023 app left the decision to the operator. <b>The 2026 toolkit keeps that uncertainty as a value</b> and reconciles it on the next step.
			<Fragment slot="deep-dive">
				<p>The request goes to <code>fpmate.cgi</code> on the printer’s address in the room. Everything between <code>beginFiscalReceipt</code> and <code>endFiscalReceipt</code> becomes one fiscal document; the payment type on each total is cash, cheque, electronic payment or meal voucher.</p>
				<p>The walkthrough below builds the same request one step at a time.</p>
			</Fragment>
		</Lockup>

		<p class="cat-mark"><code>&lt;Lockup tone="dark" center marker /&gt;</code><span>new · chapter opener, ink</span></p>
		<Lockup id="dark-lockup" center tone="dark" eyebrow="Galaxy Trucker · Architecture" title="Validated once. Applied once." marker="Seen by everyone."
			facts={[{ label: 'Request types', value: '31', note: '22 general, 9 during flight' }, { label: 'Response types', value: '34', note: 'Sent back to the requester only' }, { label: 'Events', value: '47', note: '32 general, 15 during flight', accent: true }]}
			factsNote="Counted in common/message, at submission">
			A request reaches the server and is checked against authoritative state. <b>The sender gets a response, everyone else an event,</b> and the event is the only way a client learns that the world has changed.
		</Lockup>

		<p class="cat-mark"><code>&lt;ScrollIntro /&gt;</code><span>new · pinned title, 1.3× to 0.8× while the next block arrives</span></p>
		<ScrollIntro eyebrow="EasyManager · Take a closer look" title="One order." dim="Every station reads it." />

		<!-- 2 · Vetrina -->
		<div class="cat-divider" id="showcase" data-section="2">
			<span class="st-mono">02 / 05</span>
			<h2>Showcase</h2>
			<p>Show the product before explaining it: a gallery, captioned cards, one screen driven by a list, a before and after, a diagram with notes, then the third series: scenes pinned while you scroll, a paragraph that lights up, a bento, the family in a row and a draggable comparison.</p>
		</div>

		<p class="cat-mark"><code>&lt;HighlightsGallery /&gt;</code><span>v2 of Highlights</span></p>
		<Section id="highlights" tone="ink2" title="The highlights." link={{ label: 'View the 2023 code', href: repo.easymanager }}>
			<HighlightsGallery cards={[
				{ text: 'A real restaurant ran on it: counter, floor and kitchen.', meta: '2023 · Wape S.r.l', name: 'A real restaurant', tone: 'blue', image: cover('easymanager'), imageAlt: 'An iPad showing the dining room with tables coloured by state, beside an order ticket' },
				{ text: 'It talks to a fiscal printer in XML over HTTP.', meta: 'Epson ePOS · SOAP', name: 'The fiscal printer', tone: 'dark' },
				{ text: 'Rebuilt as 31 Swift packages with zero remote dependencies.', meta: '2026 · Swift 6.3', name: '31 packages', tone: 'acid' },
				{ text: '“Uncertain” is an answer, not an error.', meta: 'Fiscal layer', name: 'Uncertain is an answer', tone: 'orange' },
				{ text: 'One lane per device, so two valid commands never interleave.', meta: 'Swift Concurrency', name: 'One lane per device', tone: 'violet' },
			]}>
				<div slot="media-2" class="mock-printer">
					<figure class="mock-code">
						<figcaption class="st-mono"><span>fpmate.cgi · request, abridged</span><span>XML</span></figcaption>
						<Code code={receiptOnly} lang="xml" theme={storyDark} />
					</figure>
					<div class="st-receipt st-receipt-paper mock-tilted" aria-hidden="true">
						<div class="head">DOCUMENTO COMMERCIALE</div><div class="rule"></div>
						<div class="row"><span>RISOTTO</span><span>2 × 14,00</span></div><div class="right">28,00</div><div class="rule"></div>
						<div class="row strong"><span>TOTALE</span><span>28,00</span></div><div class="row"><span>CONTANTE</span><span>28,00</span></div>
						<div class="barcode"></div>
					</div>
				</div>
				<div slot="media-3" class="mock-packages">
					<div class="mock-grid" role="img" aria-label="31 package products, three of them the order domain, device lanes and fiscal layer, and no remote dependencies">
						{Array.from({ length: 31 }, (_, k) => <span class:list={{ core: k < 3 }}></span>)}<span class="none st-mono">0</span>
					</div>
					<ul class="mock-legend" aria-hidden="true"><li><span class="core"></span>Order domain, device lanes, fiscal layer</li><li><span></span>Package products</li><li><span class="none"></span>Remote dependencies</li></ul>
				</div>
				<div slot="media-4" class="mock-states">
					<ol class="mock-flow-line" aria-label="Draft, Sent, Acknowledged or not, then Reconciled">
						<li class="st-state big">Draft</li><li aria-hidden="true">→</li><li class="st-state big">Sent</li><li aria-hidden="true">→</li><li class="st-state big maybe">Acknowledged</li><li aria-hidden="true">→</li><li class="st-state big dark">Reconciled</li>
					</ol>
					<p>A timeout keeps the question open for the next step instead of retrying a mutation that could print a second receipt.</p>
				</div>
				<div slot="media-5" class="mock-lanes">
					<div><span class="st-eyebrow">Without a lane</span><span class="mock-lane loose" role="img" aria-label="Two commands overlap"><span class="st-mono dark">receipt</span><span class="st-mono">X report</span><span class="st-mono warn">!</span></span></div>
					<div><span class="st-eyebrow">Printer lane</span><span class="mock-lane" role="img" aria-label="Pre-bill, then receipt, then X report, one at a time"><span class="st-mono dark">pre-bill</span>→<span class="st-mono dark">receipt</span>→<span class="st-mono">X report</span><span class="st-mono note">one at a time</span></span></div>
				</div>
			</HighlightsGallery>
		</Section>

		<p class="cat-mark"><code>&lt;MediaCards /&gt;</code><span>new · captioned carousel</span></p>
		<Section eyebrow="SpinGO · Design" title="Three tasks." dim="One companion on the wrist." link={{ label: 'Try the prototypes on the project site', href: repo.spingoSite }}>
			<MediaCards label="Design tasks" items={[
				{ lead: 'Plan and start a safe route.', text: 'Navigation reached a 93% success rate and 6.5 out of 7 on the Single Ease Question.', tone: 'violet' },
				{ lead: 'Manage vehicles in the Garage.', text: 'The weakest task, 82% and 4.2 out of 7: two people edited a vehicle because Add sat at the bottom of the list.', tone: 'acid', tag: 'Add moved to the top' },
				{ lead: 'Report to the community.', text: 'One rider’s report becomes everyone’s knowledge of the street; 89% success, 5.8 out of 7.', tone: 'blue' },
				{ lead: 'Keep the phone in the pocket.', text: 'The watch carries the next turn, haptic feedback and a one-tap report.', tone: 'orange' },
			]}>
