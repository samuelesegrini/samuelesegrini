---
/** Archivio articoli: le sezioni sono i temi ricorrenti, presi dai tag dei post. */
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import { getPortfolioContent, postPath } from '../../lib/portfolio';

const lang = 'it' as const;
const { posts } = await getPortfolioContent();
const pubblicati = getPublishedPosts(posts, lang);

// I temi sono i tag che ricorrono, dal più frequente. Un articolo può stare in più temi.
const frequenza = new Map<string, number>();
pubblicati.forEach((post) => post.tags.forEach((tag) => frequenza.set(tag, (frequenza.get(tag) ?? 0) + 1)));
const temi = [...frequenza.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.slice(0, 4)
	.map(([tag]) => tag);

const maiuscola = (testo: string) => testo.charAt(0).toUpperCase() + testo.slice(1);
const conta = (n: number) => `${n} ${n === 1 ? 'articolo' : 'articoli'}`;

const sezioni = temi.map((tema, i) => {
	const dentro = pubblicati.filter((post) => post.tags.includes(tema));
	return {
		id: tema.replace(/[^a-z0-9]+/gi, '-').toLowerCase(),
		occhiello: `Sezione ${String(i + 1).padStart(2, '0')}`,
		kicker: 'Tema',
		value: maiuscola(tema),
		articoli: dentro,
		detail: { kicker: maiuscola(tema), value: conta(dentro.length) },
	};
});
---

<ExperimentLayout
	title="Banco di prova — archivio articoli"
	currentHref="/lab/articoli/"
	sections={sezioni.map(({ kicker, value, detail }) => ({ kicker, value, detail }))}
>
	<header class="home-section hero" id="inizio" data-section="0">
		<span class="section-kicker">Archivio</span>
		<h1>Scrittura, <em>per argomento.</em></h1>
		<p>{conta(pubblicati.length)} pubblicati, raccolti attorno ai temi che tornano più spesso. Un articolo può comparire in più temi: sono etichette, non cartelle.</p>
		<span class="hero-hint" aria-hidden="true">Scorri, oppure usa la barra</span>
		<i class="section-rule" aria-hidden="true"></i>
	</header>

	{sezioni.map((sezione, i) => (
		<section class="home-section" id={sezione.id} data-section={i + 1}>
			<span class="section-kicker">{sezione.occhiello}</span>
			<h1>{sezione.value}</h1>
			<p>{conta(sezione.articoli.length)} su questo tema.</p>
			<ul class="elenco">
				{sezione.articoli.map((post) => (
					<li>
						<a href={postPath(post)}>
							<strong>{post.title}</strong>
							<span>{post.excerpt}</span>
						</a>
					</li>
				))}
			</ul>
			<i class="section-rule" aria-hidden="true"></i>
		</section>
	))}
</ExperimentLayout>
