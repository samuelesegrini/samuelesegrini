---
import { render } from 'astro:content';
import Project from '../../../../../components/style-lab/sites/monograph/Project.astro';
import { getLabSiteContent } from '../../../../../lib/lab-sites';
import LabSiteLayout from '../../../../../layouts/LabSiteLayout.astro';
const content = await getLabSiteContent();
const { Content } = await render(content.projectDocument);
---

<LabSiteLayout theme="monograph" page="project" title={`${content.projectDocument.data.title} — Monograph`} description={content.projectDocument.data.excerpt}>
	<Project content={content}>
		<Content slot="body" />
	</Project>
</LabSiteLayout>
