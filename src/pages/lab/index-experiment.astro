---
/** Banco di prova per la nuova home. Sostituirà it/index.astro quando sarà pronta. */
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getFeaturedProjects, getPublishedPosts } from '../../lib/content';
import { getPortfolioContent, postPath, projectPath } from '../../lib/portfolio';
import { siteConfig } from '../../config/site';

const lang = 'it' as const;
const { projects, posts } = await getPortfolioContent();
const featured = getFeaturedProjects(projects, lang);
const published = getPublishedPosts(posts, lang);
const pubblicati = projects.filter((project) => project.locale === lang && !project.draft);
const conta = (n: number, uno: string, molti: string) => `${n} ${n === 1 ? uno : molti}`;

const sezioni = [
	{ id: 'lavoro', kicker: 'Sezione', value: 'Lavoro', occhiello: 'Sezione 01',
		testo: 'I progetti selezionati, con il ragionamento che c’è dietro invece della sola schermata finale.',
		detail: { kicker: 'Progetti', value: conta(pubblicati.length, 'pubblicato', 'pubblicati') } },
	{ id: 'scrittura', kicker: 'Sezione', value: 'Scrittura', occhiello: 'Sezione 02',
		testo: 'Note tecniche su ciò che ho dovuto capire davvero: sistemi, vincoli, errori utili.',
		detail: { kicker: 'Articoli', value: conta(published.length, 'pubblicato', 'pubblicati') } },
	{ id: 'percorso', kicker: 'Sezione', value: 'Percorso', occhiello: 'Sezione 03',
		testo: 'Come ci sono arrivato — gli strumenti, le persone e i problemi che mi hanno formato.',
		detail: { kicker: 'Esperienza', value: '4 anni' } },
	{ id: 'contatto', kicker: 'Sezione', value: 'Contatto', occhiello: 'Sezione 04',
		testo: 'Aperto a opportunità. Risposta entro 24 ore, fuso orario italiano.',
		detail: { kicker: 'Risposta', value: 'Entro 24 ore' } },
];
---

<ExperimentLayout
	title="Banco di prova — nuova home"
	currentHref="/lab/index-experiment/"
	sections={sezioni.map(({ kicker, value, detail }) => ({ kicker, value, detail }))}
>
	<header class="home-section hero" id="inizio" data-section="0">
		<span class="section-kicker">{siteConfig.name}</span>
		<h1>Software engineer, <em>Swift e sistemi affidabili.</em></h1>
		<p>Progetto e costruisco prodotti iOS in cui la logica regge quanto l’interfaccia. Questa barra è il prototipo del menu: naviga la pagina e racconta dove sei.</p>
		<span class="hero-hint" aria-hidden="true">Scorri, oppure usa la barra</span>
		<i class="section-rule" aria-hidden="true"></i>
	</header>

	<section class="home-section" id="lavoro" data-section="1">
		<span class="section-kicker">{sezioni[0].occhiello}</span>
		<h1>Lavoro</h1>
		<p>{sezioni[0].testo}</p>
		<ul class="elenco">
			{featured.map((project) => (
				<li><a href={projectPath(project)}><strong>{project.title}</strong><span>{project.excerpt}</span></a></li>
			))}
		</ul>
		<a class="collegamento" href="/lab/progetti/">Tutti i progetti →</a>
		<i class="section-rule" aria-hidden="true"></i>
	</section>

	<section class="home-section" id="scrittura" data-section="2">
		<span class="section-kicker">{sezioni[1].occhiello}</span>
		<h1>Scrittura</h1>
		<p>{sezioni[1].testo}</p>
		<ul class="elenco">
			{published.slice(0, 3).map((post) => (
				<li><a href={postPath(post)}><strong>{post.title}</strong><span>{post.excerpt}</span></a></li>
			))}
		</ul>
		<a class="collegamento" href="/lab/articoli/">Tutti gli articoli →</a>
		<i class="section-rule" aria-hidden="true"></i>
	</section>

	<section class="home-section" id="percorso" data-section="3">
		<span class="section-kicker">{sezioni[2].occhiello}</span>
		<h1>Percorso</h1>
		<p>{sezioni[2].testo}</p>
		<a class="collegamento" href="/lab/chi-sono/">Chi sono →</a>
		<i class="section-rule" aria-hidden="true"></i>
	</section>

	<section class="home-section" id="contatto" data-section="4">
		<span class="section-kicker">{sezioni[3].occhiello}</span>
		<h1>Contatto</h1>
		<p>{sezioni[3].testo}</p>
		<a class="collegamento" href={`mailto:${siteConfig.email}`}>Scrivimi →</a>
		<i class="section-rule" aria-hidden="true"></i>
	</section>
</ExperimentLayout>
