---
/** Profilo: la barra indicizza le tre domande a cui la pagina risponde. */
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getPortfolioContent } from '../../lib/portfolio';
import { siteConfig } from '../../config/site';

const lang = 'it' as const;
const { projects, aboutDocuments } = await getPortfolioContent();
const profilo = aboutDocuments.find((page) => page.data.locale === lang && !page.data.draft);
const pubblicati = projects.filter((project) => project.locale === lang && !project.draft);

const sezioni = [
	{ id: 'percorso', occhiello: 'Sezione 01', kicker: 'Sezione', value: 'Percorso',
		testo: 'Dai sistemi distribuiti allo sviluppo iOS: vincoli espliciti, verifiche concrete, attenzione al prodotto.',
		detail: { kicker: 'Esperienza', value: '4 anni' } },
	{ id: 'strumenti', occhiello: 'Sezione 02', kicker: 'Sezione', value: 'Strumenti',
		testo: 'Swift e iOS come ancoraggio, più tutto quello che serve perché un sistema resti corretto quando la rete non collabora.',
		detail: { kicker: 'Progetti', value: `${pubblicati.length} in archivio` } },
	{ id: 'contatto', occhiello: 'Sezione 03', kicker: 'Sezione', value: 'Contatto',
		testo: 'Aperto a opportunità. Risposta entro 24 ore, fuso orario italiano.',
		detail: { kicker: 'Risposta', value: 'Entro 24 ore' } },
];
---

<ExperimentLayout
	title="Banco di prova — chi sono"
	currentHref="/lab/chi-sono/"
	sections={sezioni.map(({ kicker, value, detail }) => ({ kicker, value, detail }))}
>
	<header class="home-section hero" id="inizio" data-section="0">
		<span class="section-kicker">{siteConfig.name}</span>
		<h1>{profilo?.data.title ?? 'Chi sono'}</h1>
		<p>{profilo?.data.excerpt ?? 'Profilo in preparazione.'}</p>
		<span class="hero-hint" aria-hidden="true">Scorri, oppure usa la barra</span>
		<i class="section-rule" aria-hidden="true"></i>
	</header>

	{sezioni.map((sezione, i) => (
		<section class="home-section" id={sezione.id} data-section={i + 1}>
			<span class="section-kicker">{sezione.occhiello}</span>
			<h1>{sezione.value}</h1>
			<p>{sezione.testo}</p>
			{sezione.id === 'contatto' && (
				<a class="collegamento" href={`mailto:${siteConfig.email}`}>Scrivimi →</a>
			)}
			<i class="section-rule" aria-hidden="true"></i>
		</section>
	))}
</ExperimentLayout>
