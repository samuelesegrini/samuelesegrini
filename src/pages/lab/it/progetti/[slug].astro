---
import LabProjectDetail from '../../../../components/lab/LabProjectDetail.astro';
import { getPortfolioContent } from '../../../../lib/portfolio';

export async function getStaticPaths() {
	const { projects } = await getPortfolioContent();
	return projects
		.filter((entry) => entry.locale === 'it' && !entry.draft)
		.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
---

<LabProjectDetail lang="it" slug={slug!} />
