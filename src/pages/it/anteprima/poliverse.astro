	/* Le carte "fuori dall'app". */
	.pv-widgets { display: flex; gap: 12px; align-items: center; justify-content: center; height: 100%; }
	.pv-w { display: grid; align-content: space-between; width: 128px; aspect-ratio: 1; padding: 14px; border-radius: 28px; background: #fffefb; box-shadow: 0 10px 24px rgba(23, 23, 19, .16), inset 0 0 0 1.5px #171713; color: #171713; }
	.pv-w em { font-style: normal; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #0f3d6e; }
	.pv-w b { font-size: 15px; line-height: 1.1; } .pv-w span { font-size: 11px; color: #5e5a53; }
	.pv-w.dark { background: #171713; color: #fffef9; } .pv-w.dark em { color: #c7ff9f; } .pv-w.dark b { font-size: 40px; } .pv-w.dark span { color: #c9c5bc; }
	.pv-live { display: grid; align-content: center; justify-items: center; gap: 14px; height: 100%; padding: 0 16px; }
	.pv-live-time { font-size: 44px; font-weight: 700; color: #fffef9; }
	.pv-live-card { display: grid; grid-template-columns: 1fr auto; gap: 10px; width: min(100%, 300px); padding: 14px; border-radius: 22px; background: rgba(255, 254, 251, .12); color: #fffef9; }
	.pv-live-card em { display: block; font-style: normal; font-size: 10px; color: #c7ff9f; text-transform: uppercase; letter-spacing: .05em; }
	.pv-live-card b { font-size: 14px; } .pv-live-left { align-self: center; font-size: 13px; }
	.pv-live-card .pv-bar { grid-column: 1 / -1; background: rgba(255, 254, 251, .2); } .pv-live-card .pv-bar i { background: #c7ff9f; }
	.pv-wrist { display: grid; place-items: center; height: 100%; }
	.pv-watch.small { width: 132px; height: 158px; border-radius: 38px; box-shadow: 0 0 0 9px #171713, 0 16px 30px rgba(23, 23, 19, .3); }
	.pv-siri { display: flex; flex-direction: column; justify-content: center; gap: 10px; height: 100%; padding: 0 18px; }
	.pv-ask { align-self: flex-end; padding: 10px 14px; border-radius: 18px 18px 4px 18px; background: #171713; color: #fffef9; font-size: 13px; }
	.pv-answer { display: grid; align-self: flex-start; padding: 12px 14px; border-radius: 18px 18px 18px 4px; background: #fffefb; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-answer em { font-style: normal; font-size: 11px; color: #5e5a53; } .pv-answer b { font-size: 16px; }
	.pv-player { display: grid; align-content: center; gap: 10px; height: 100%; padding: 0 18px; }
	.pv-player-frame { display: grid; place-items: center; aspect-ratio: 16 / 9; border-radius: 14px; background: #171713; }
	.pv-player-frame i { width: 0; height: 0; border-left: 18px solid #fffef9; border-top: 11px solid transparent; border-bottom: 11px solid transparent; margin-left: 4px; }
	.pv-player .st-mono { font-size: 11px; }

	/* Le scene dell'accesso con CIE: pagina di accesso, passaggio a CieID, carta e PIN, ritorno. */
	.pv-url { align-self: center; padding: 5px 12px; border-radius: 999px; background: #e2dfd5; font-size: 9.5px; color: #5e5a53; }
	.pv-signin { gap: 12px; }
	.pv-signin .pv-title { margin-top: 18px; }
	.pv-choice { position: relative; display: grid; place-items: center; height: 46px; margin-top: 6px; border-radius: 14px; background: #fffefb; box-shadow: inset 0 0 0 1.5px #171713; font-size: 13px; font-weight: 700; }
	.pv-choice.on { background: #171713; color: #fffef9; }
	.pv-choice.on i { position: absolute; right: 22%; bottom: -12px; width: 26px; height: 26px; border-radius: 50%; background: rgba(205, 239, 255, .55); box-shadow: 0 0 0 6px rgba(205, 239, 255, .3); }
