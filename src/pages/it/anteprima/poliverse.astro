	.pv-k-copy .st-hg-body { margin-top: 16px; }
	/* L'apertura, finché non c'è la foto: i tre schermi disegnati e fermi, adattati al palco intero. */
	.pv-shot { display: flex; align-items: center; justify-content: center; gap: 56px; }
