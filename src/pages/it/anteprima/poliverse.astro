	.pv-room b { font: 700 13px var(--mono); } .pv-room span { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; }
	.pv-day { position: relative; height: 8px; margin: -2px 4px 2px; border-radius: 4px; background: #c7ff9f; box-shadow: inset 0 0 0 1px rgba(23, 23, 19, .35); overflow: hidden; }
	.pv-day i { position: absolute; top: 0; bottom: 0; background: #b4b0a6; }
	.pv-pick { display: grid; gap: 5px; }
	.pv-pick > span { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #5e5a53; }
	.pv-pick > span.on { color: #171713; font-weight: 600; }
	.pv-pick i { display: grid; place-items: center; width: 16px; height: 16px; border-radius: 5px; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-pick .on i { background: #171713; color: #c7ff9f; }
	.pv-week { display: grid; grid-template-columns: repeat(5, 1fr); grid-template-rows: auto repeat(4, 24px); gap: 3px; margin-top: 4px; padding-top: 8px; border-top: 1px solid rgba(23, 23, 19, .12); }
	.pv-week b { grid-row: 1; font: 10px var(--mono); text-align: center; color: #5e5a53; }
	.pv-week i { display: grid; place-items: center; border-radius: 7px; box-shadow: inset 0 0 0 1.5px #171713; font: 700 9.5px var(--mono); font-style: normal; }
	.pv-group { display: grid; grid-template-columns: 44px 1fr auto; align-items: center; padding: 9px 10px; border-radius: 12px; box-shadow: inset 0 0 0 1.5px rgba(23, 23, 19, .25); }
	.pv-group b { font: 700 13px var(--mono); }
	.pv-group.mine { background: #cdefff; box-shadow: inset 0 0 0 1.5px #171713; }
