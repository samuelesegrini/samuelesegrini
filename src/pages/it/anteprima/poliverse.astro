---
/**
 * Il racconto di PoliVerse in italiano, gemello di /en/preview/poliverse: stesse sezioni, stessi
 * disegni e stesse note; cambia solo il testo. Anteprima non elencata, costruita solo con le sezioni
 * della seconda serie. I numeri vengono dal repository (commit e983281) e hanno la loro nota in fondo; le icone
 * sono i file veri dell'app; le schermate sono illustrazioni dichiarate dell'interfaccia italiana,
 * da sostituire con le catture del test ScreenshotSweepUITests. Fuori dalla sitemap, noindex.
 */
import ExperimentLayout from '../../../layouts/ExperimentLayout.astro';
import {
	Story, Section, AppHero, Lockup, HighlightsGallery, FeatureExplorer, ToggleFigure, Stats,
	ChangeLog, ThenNow, Findings, StateMachine, ExplodedStack, Declaration, Principles, Limits, TechSpecs,
	Sources, Faq, KeepExploring, PageIndex, ScrollIntro, LitText, Bento, StickyScenes, BeforeAfter, ProductShot, Device, Icon, MediaCards,
	Statement, ObjectRow, PlusCards,
} from '../../../components/story';
import { labPaths, labProjectPath } from '../../../components/lab/chrome';
import { withBase } from '../../../lib/base';

const repo = 'https://github.com/samuelesegrini/PoliVerse';
const icon = (name: string) => withBase(`/images/projects/poliverse/icons/${name}.svg`);
const cover = (name: string) => withBase(`/images/projects/covers/${name}.svg`);

// I colori in cui escono Giorno e Vicino: gli stessi da cui parte un Flavor (AppIconChoice).
const colours: [string, string][] = [
	['classic', 'Classica'], ['lavender', 'Lavanda'], ['indigo', 'Indaco'], ['sky', 'Cielo'], ['mint', 'Menta'], ['sage', 'Salvia'],
	['mandarin', 'Mandarino'], ['coral', 'Corallo'], ['raspberry', 'Lampone'], ['coffee', 'Caffè'], ['slate', 'Ardesia'], ['graphite', 'Grafite'],
];
const specials: [string, string][] = [
	['neon', 'Neon'], ['spectrum', 'Spettro'], ['leather', 'Pelle'], ['holographic', 'Olografico'], ['hyperspace', 'Iperspazio'],
	['blueprint', 'Blueprint'], ['circuit', 'Circuito'], ['heavens', 'Cielo'], ['observatory', 'Osservatorio'], ['soft', 'Morbido'], ['paper', 'Carta'],
];
const appearances: [string, string][] = [['orbit', 'Predefinita'], ['orbit-dark', 'Scura'], ['orbit-clear', 'Trasparente'], ['orbit-tinted', 'Colorata']];

// La rampa del Flavor di partenza, dal diagramma DocC flavor-ramp.svg: dal più profondo al più chiaro.
const ramp = ['#11777A', '#13758A', '#157099', '#1767A8', '#195BB8', '#1B4BC7', '#1D37D6', '#1F20E5'];

// I sei servizi che PoliVerse tiene insieme (docs/ del repo dell'app), in orbita attorno all'icona in
// senso orario dall'alto, un giro ogni `lap` secondi. `cos`/`sin` dicono il posto di ciascuno
// sull'orbita da fermo; il giro sono due oscillazioni, una orizzontale e una verticale sfasata di un
// quarto, e `phaseX`/`phaseY` sono i ritardi negativi che le fanno partire proprio da quel posto.
// `dx`/`dy` (in centesimi del disegno) e `r` dicono da dove partono, sparsi.
const lap = 40;
const phase = (degrees: number) => -+(((((degrees % 360) + 360) % 360) / 360) * lap).toFixed(2);
const sources = ([
	{ name: 'Servizi Online', adds: 'corsi, carriera, esami', icon: 'checklist', tint: 'blue', dx: -24, dy: -8, r: -7 },
	{ name: 'WeBeep', adds: 'materiali, avvisi, forum', icon: 'layers', tint: 'acid', dx: 7, dy: -14, r: 6 },
	{ name: 'Registrazioni', adds: 'lezioni registrate', icon: 'play', tint: 'violet', dx: 11, dy: 12, r: -5 },
	{ name: 'Aule e mappe', adds: 'aule libere, planimetrie', icon: 'target', tint: 'orange', dx: 22, dy: 6, r: 8 },
	{ name: 'Programmi', adds: 'cosa copre ogni corso', icon: 'doc-text', tint: 'blue', dx: -6, dy: 13, r: 7 },
	{ name: 'Manifesto', adds: 'piano e docenti', icon: 'book', tint: 'acid', dx: -12, dy: -12, r: -6 },
] as const).map((source, i) => {
	const angle = -90 + i * 60;
	const radians = (angle * Math.PI) / 180;
	return { ...source, cos: +Math.cos(radians).toFixed(4), sin: +Math.sin(radians).toFixed(4), phaseX: phase(angle), phaseY: phase(angle + 90) };
});

// Il muro di icone di Personalizza: tutte e 36, ognuna una volta, quattro file da nove. In ogni fila
// si alternano una speciale, un Giorno e un Vicino, e due vicine non hanno mai la stessa forma o lo
// stesso colore. Le file scorrono piano, ciascuna per conto suo, ripetute tre volte per non avere giunte.
const wall = [
	['special-neon', 'dial-mandarin', 'closeup-indigo', 'special-paper', 'dial-sky', 'closeup-raspberry', 'special-hyperspace', 'dial-sage', 'closeup-coffee'],
	['closeup-mint', 'special-leather', 'dial-lavender', 'closeup-coral', 'special-holographic', 'dial-graphite', 'closeup-sky', 'special-circuit', 'dial-classic'],
	['dial-coral', 'closeup-lavender', 'special-heavens', 'dial-indigo', 'closeup-mandarin', 'special-spectrum', 'dial-mint', 'closeup-slate', 'orbit'],
	['special-blueprint', 'dial-raspberry', 'closeup-sage', 'special-observatory', 'dial-coffee', 'closeup-graphite', 'special-soft', 'dial-slate', 'closeup-classic'],
];

// La settimana che l'app ricava dagli insegnamenti scelti (PersonalTimetableView): giorno, ora, aula.
const picks = [
	{ name: 'Reti di Calcolatori', on: true },
	{ name: 'Basi di Dati', on: true },
	{ name: 'Ingegneria del Software', on: true },
	{ name: 'Tecnologie per il Web', on: false },
];
const week = [
	{ day: 1, from: 2, span: 2, room: 'T.2.1', tint: 'violet' },
	{ day: 2, from: 1, span: 2, room: '3.1.2', tint: 'blue' },
	{ day: 3, from: 3, span: 2, room: 'B.4.2', tint: 'orange' },
	{ day: 4, from: 1, span: 2, room: 'T.2.1', tint: 'violet' },
	{ day: 5, from: 2, span: 2, room: '3.1.2', tint: 'blue' },
];

// Le piastrelle dei sei posti, ognuna del colore e della storta del suo punto nella prima carta.
const place = (i: number) => `--tint: var(--${sources[i].tint}); --r: ${sources[i].r / 2}deg`;

const sections = [
	{ kicker: 'Capitolo 1 di 8', value: 'Perché esiste', detail: { kicker: 'Posti', value: '6 da controllare' } },
	{ kicker: 'Capitolo 2 di 8', value: 'Promesse', detail: { kicker: 'Promesse', value: '3, poi 4 punti forti' } },
	{ kicker: 'Capitolo 3 di 8', value: 'Una giornata', detail: { kicker: 'Schede', value: '4, una domanda ciascuna' } },
	{ kicker: 'Capitolo 4 di 8', value: 'Falla tua', detail: { kicker: 'Icone', value: '36 tra cui scegliere' } },
	{ kicker: 'Capitolo 5 di 8', value: 'Quindici giorni', detail: { kicker: 'Commit', value: '309' } },
	{ kicker: 'Capitolo 6 di 8', value: 'Il lavoro', detail: { kicker: 'API pubblica', value: 'nessuna' } },
	{ kicker: 'Capitolo 7 di 8', value: 'Le regole', detail: { kicker: 'Messe per iscritto', value: '6 regole' } },
	{ kicker: 'Capitolo 8 di 8', value: 'Scheda', detail: { kicker: 'Dipendenze', value: 'nessuna' } },
];

---

<ExperimentLayout lang="it" title="PoliVerse (anteprima)" currentHref="/it/anteprima/poliverse/" sections={sections} itHref={withBase('/it/anteprima/poliverse/')} enHref={withBase('/en/preview/poliverse/')} noindex>
	<Story>
		<AppHero name="PoliVerse" title="Tutto il tuo Politecnico. In un’app." tint="blue"
			summary="Un’app non ufficiale per chi studia al Politecnico di Milano: orario, corsi, materiali di WeBeep, registrazioni delle lezioni, esami e aule, su iPhone, iPad, Apple Watch e schermata di blocco. Si apre già piena, anche offline."
			meta="Lavoro individuale · SwiftUI · iOS 27 · settembre 2026"
			actions={[{ label: 'Leggi il racconto', href: '#why' }, { label: 'Codice su GitHub', href: repo }]}>
			<img slot="mark" src={icon('orbit')} alt="" width="104" height="104" class="pv-mark" />
			<ProductShot slot="shot" priority src="/assets/projects/poliverse-devices.png" alt="Illustrazione: PoliVerse sulla schermata di blocco, nella scheda Oggi e su Apple Watch">
				<div class="pv-stage-box" style="width: 100%; height: 100%;">
					<div class="pv-stage pv-shot" style="width: 1100px; height: 444px;">
						<Device kind="iphone" class="pv-shot-lock">
							<div class="pv-live"><span class="pv-live-time st-mono">10:41</span><span class="pv-live-card"><span><em>Lezione in corso</em><b>Ingegneria del Software</b></span><span class="pv-live-left st-mono">34 min</span><span class="pv-bar"><i style="width: 72%"></i></span></span></div>
						</Device>
						<Device kind="iphone" class="pv-shot-today">
							<div class="pv-phone">
								<span class="pv-hello">Buona giornata!</span>
								<span class="pv-date"><b>24.09</b><b>GIO</b></span>
								<span class="pv-kicker">Lezione in corso</span>
								<span class="pv-card now"><span class="pv-tag">10:15 – 12:15 · Aula 3.1.2</span><b>Ingegneria del Software</b><span class="pv-bar"><i style="width: 38%"></i></span></span>
								<span class="pv-kicker">Orario</span>
								<span class="pv-row"><i class="c-violet"></i><span><b>Reti di Calcolatori</b><span>12:15 · T.2.1</span></span></span>
								<span class="pv-row"><i class="c-orange"></i><span><b>Basi di Dati</b><span>14:15 · B.4.2</span></span></span>
							</div>
						</Device>
						<Device kind="watch" class="pv-shot-watch">
							<div class="pv-watch"><span class="st-mono">Esame</span><b>Probabilità</b><span>6 ott · 9:00</span></div>
						</Device>
					</div>
				</div>
			</ProductShot>
		</AppHero>

		<Section id="why" index={1} eyebrow="PoliVerse · Perché esiste" title="Sei posti," dim="prima della prima lezione.">
			<Statement>Una giornata al Politecnico è sparsa in <b>sei posti</b>, e <b>l’app ufficiale ne lascia fuori qualcuno</b>.</Statement>
			<ObjectRow label="I sei posti che uno studente controlla" items={sources.map((source) => ({ name: source.name, text: `${source.adds[0].toUpperCase()}${source.adds.slice(1)}.` }))}>
				<span slot="object-1" class="pv-place" style={place(0)} aria-hidden="true"><Icon name={sources[0].icon} size={40} stroke={1.8} /></span>
				<span slot="object-2" class="pv-place" style={place(1)} aria-hidden="true"><Icon name={sources[1].icon} size={40} stroke={1.8} /></span>
				<span slot="object-3" class="pv-place" style={place(2)} aria-hidden="true"><Icon name={sources[2].icon} size={40} stroke={1.8} /></span>
				<span slot="object-4" class="pv-place" style={place(3)} aria-hidden="true"><Icon name={sources[3].icon} size={40} stroke={1.8} /></span>
				<span slot="object-5" class="pv-place" style={place(4)} aria-hidden="true"><Icon name={sources[4].icon} size={40} stroke={1.8} /></span>
				<span slot="object-6" class="pv-place" style={place(5)} aria-hidden="true"><Icon name={sources[5].icon} size={40} stroke={1.8} /></span>
			</ObjectRow>
		</Section>

		<Section>
			<LitText eyebrow="PoliVerse · Il motivo" tint="blue" text="Così ho costruito l’app che volevo aprire io: *tutti e sei in un posto solo*, sul SwiftUI più recente." />
		</Section>

		<ScrollIntro id="highlights" index={2} tone="ink2" eyebrow="PoliVerse" title="Tre promesse." />

		<Section tone="ink2">
			<PlusCards label="Le tre promesse che PoliVerse mantiene" cards={[
				{ eyebrow: 'Promessa 1', title: 'Tutto.', text: 'Sei posti in un’app, su ogni schermo che uno studente ha con sé.', tone: 'acid',
					detail: 'Servizi Online, WeBeep, le registrazioni, le aule, i programmi e il Manifesto, in quattro schede, su iPhone, iPad, Apple Watch, widget e schermata di blocco, e verificati alla dimensione di testo più grande. Farlo funzionare senza un’API pubblica è il tema del sesto capitolo.',
					links: [{ label: 'Non c’è un’API pubblica', href: '#backend' }, { label: 'CieID non sa chi l’ha chiamata', href: '#cie' }] },
				{ eyebrow: 'Promessa 2', title: 'Mai vuota.', text: 'Si apre con la giornata, anche sottoterra.', tone: 'blue',
					detail: 'L’ultima copia di ogni risposta resta sul telefono, nel gruppo d’app che leggono anche i widget. Senza segnale l’app si apre da lì, e un aggiornamento che fallisce lascia quello che c’è sullo schermo e dice quando è stato scaricato.',
					links: [{ label: 'Una risposta vecchia, con la data', href: '#data' }, { label: 'Quattro strati, separati', href: '#layers' }] },
				{ eyebrow: 'Promessa 3', title: 'Mai finta.', text: 'I dati d’esempio lo dicono, e niente si scrive a occhio.', tone: 'orange',
					detail: 'I dati d’esempio sono attivi di serie e ogni schermata lo dice finché lo sono. Una copia vecchia porta la sua data. L’iscrizione agli esami resta fuori finché le richieste non sono verificate, perché una scrittura sbagliata costa una sessione. E questa pagina finisce su quello che non ha ancora dimostrato.',
					links: [{ label: 'Quattro cose che sembravano bug', href: '#traps' }, { label: 'Le regole', href: '#decisions' }] },
			]}>
				<div slot="media-1" class="pv-pm pv-pm-all" aria-hidden="true">
					<span class="pv-pm-six">{sources.map((source) => <i style={`--tint: var(--${source.tint})`}><Icon name={source.icon} size={15} stroke={2.2} /></i>)}</span>
					<Icon name="arrow-right" size={18} stroke={2.4} />
					<img src={icon('orbit')} alt="" width="56" height="56" />
				</div>
				<div slot="media-2" class="pv-pm pv-pm-empty" aria-hidden="true">
					<span class="pv-pm-card"><b>Oggi</b><span><em>12:15</em>Reti di Calcolatori</span><span><em>14:15</em>Basi di Dati</span></span>
					<span class="pv-pm-pill off">Offline · 8:42</span>
				</div>
				<div slot="media-3" class="pv-pm pv-pm-honest" aria-hidden="true">
					<span class="pv-pm-pill sample">Stai guardando dati di esempio</span>
					<span class="pv-pm-card"><span><em>Orario</em>40 min fa</span></span>
				</div>
			</PlusCards>
		</Section>

		<Section tone="ink2" link={{ label: 'Sfoglia il codice', href: repo }}>
			<HighlightsGallery interval={6000} cards={[
				{ text: 'Sei posti da controllare. Un’app.', meta: 'Quello che PoliVerse tiene insieme', name: 'Sei posti, un’app', tone: 'dark' },
				{ lead: 'I tuoi corsi, con dentro WeBeep.', text: 'Il voto dell’esame, dal piano di studi.', name: 'Corsi con dentro WeBeep', tone: 'paper', layout: 'split', dwell: 9000 },
				{ lead: 'Falla tua.', text: 'Un colore diventa tutta l’app, fino all’icona.', meta: 'Personalizza, 36 icone', name: 'Falla tua', tone: 'dark', layout: 'overlay' },
				{ lead: 'Si apre con la tua giornata, anche sottoterra.', text: 'Tornato su, si rimette in pari da sola.', body: 'PoliVerse tiene sul telefono l’ultima copia della tua giornata. Senza segnale si apre da lì, e quando il segnale torna si aggiorna da sola, cambi d’aula compresi.', name: 'Prima offline', tone: 'paper', layout: 'split', dwell: 8000 },
			]}>
				<div slot="media-1" class="pv-combine" style={`--half: ${lap / 2}s`} aria-hidden="true">
					<span class="pv-ring"></span>
					<span class="pv-core"><img src={icon('orbit')} alt="" width="120" height="120" /></span>
					{sources.map((source, i) => (
						<span class="pv-orbit st-hg-loop" style={`--cos: ${source.cos}; --sin: ${source.sin}; --phase-x: ${source.phaseX}s; --phase-y: ${source.phaseY}s`}>
							<span class="pv-orbit-y st-hg-loop">
								<span class="pv-chip" style={`--dx: ${source.dx}; --dy: ${source.dy}; --r: ${source.r}deg; --d: ${i * 70}ms; --tint: var(--${source.tint})`}>
									<Icon name={source.icon} size={16} stroke={2.2} /><b>{source.name}</b><small>{source.adds}</small>
								</span>
							</span>
						</span>
					))}
				</div>
				<div slot="copy-2" class="st-hg-anim pv-k-copy">
					<p><b class="st-hg-lead">I tuoi corsi, con dentro WeBeep.</b></p>
					<div class="pv-k-lines">
						<p data-gone style="opacity: 0; animation: pvk-fade-out .3s ease-out 2.2s backwards;">Trovato dal codice del corso.</p>
						<div style="animation: pvk-fade-in .4s ease-out 2.45s both;">
							<p class="st-hg-loop" style="animation: pvk-txt-a 6s cubic-bezier(.4, 0, .6, 1) 4s infinite none;">Il voto dell’esame, dal piano di studi.</p>
							<p class="st-hg-loop" data-gone style="opacity: 0; animation: pvk-txt-b 6s cubic-bezier(.4, 0, .6, 1) 4s infinite none;">La prossima lezione, con la sua aula.</p>
							<p class="st-hg-loop" data-gone style="opacity: 0; animation: pvk-txt-c 6s cubic-bezier(.4, 0, .6, 1) 4s infinite none;">I giorni al prossimo esame, a scalare.</p>
						</div>
					</div>
					<p class="st-hg-body">Ogni corso del tuo piano apre la sua pagina di WeBeep, con accanto lezioni, esami e voto.</p>
				</div>
				<div slot="media-2" class="pv-stage-box" aria-hidden="true">
					<div class="st-hg-anim pv-stage" style="position: relative; width: 452px; height: 472px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
					        <div style="width: 360px; display: flex; flex-direction: column; gap: 12px;">

					          <div style="display: flex; flex-direction: column; gap: 10px; box-sizing: border-box; padding: 12px 14px; border-radius: 16px; background: #f4f1e9; box-shadow: inset 0 0 0 1.5px #171713; animation: pvk-in-up 0.45s cubic-bezier(.22, 1, .36, 1) 0s both, pvk-click 0.36s cubic-bezier(.22, 1, .36, 1) 1.15s none;">
					            <div style="display: flex; align-items: center; gap: 10px;">
					              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg>
					              <span style="flex-grow: 1; font-size: 13.5px; font-weight: 600; white-space: nowrap;">Ingegneria del Software</span>
					              <span style="font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #5e5a53;">WeBeep</span>
					            </div>
					            <div style="position: relative; display: flex; align-items: center; gap: 10px; height: 36px; margin: 0 -6px; padding: 0 6px; border-top: 1px solid rgba(23, 23, 19, 0.12); border-radius: 10px; animation: pvk-lock-flash 0.6s ease-out 1.15s none;">
					              <span style="width: 52px; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #5e5a53;">Piano</span>
					              <span style="display: flex; gap: 4px;">
					                <span style="display: flex; align-items: center; justify-content: center; width: 22px; height: 26px; border-radius: 7px; background: #c7ff9f; box-shadow: inset 0 0 0 1.5px #171713; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; animation: pvk-digit-in 0.28s cubic-bezier(.22, 1, .36, 1) 0.82s both;">0</span>
					                <span style="display: flex; align-items: center; justify-content: center; width: 22px; height: 26px; border-radius: 7px; background: #c7ff9f; box-shadow: inset 0 0 0 1.5px #171713; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; animation: pvk-digit-in 0.28s cubic-bezier(.22, 1, .36, 1) 0.87s both;">5</span>
					                <span style="display: flex; align-items: center; justify-content: center; width: 22px; height: 26px; border-radius: 7px; background: #c7ff9f; box-shadow: inset 0 0 0 1.5px #171713; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; animation: pvk-digit-in 0.28s cubic-bezier(.22, 1, .36, 1) 0.92s both;">4</span>
					                <span style="display: flex; align-items: center; justify-content: center; width: 22px; height: 26px; border-radius: 7px; background: #c7ff9f; box-shadow: inset 0 0 0 1.5px #171713; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; animation: pvk-digit-in 0.28s cubic-bezier(.22, 1, .36, 1) 0.97s both;">3</span>
					                <span style="display: flex; align-items: center; justify-content: center; width: 22px; height: 26px; border-radius: 7px; background: #c7ff9f; box-shadow: inset 0 0 0 1.5px #171713; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; animation: pvk-digit-in 0.28s cubic-bezier(.22, 1, .36, 1) 1.02s both;">2</span>
					                <span style="display: flex; align-items: center; justify-content: center; width: 22px; height: 26px; border-radius: 7px; background: #c7ff9f; box-shadow: inset 0 0 0 1.5px #171713; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; animation: pvk-digit-in 0.28s cubic-bezier(.22, 1, .36, 1) 1.07s both;">1</span>
