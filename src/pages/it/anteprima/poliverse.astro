	.pv-hit { display: grid; grid-template-columns: 58px 1fr; column-gap: 8px; padding: 8px 2px; border-top: 1px solid rgba(23, 23, 19, .12); }
	.pv-hit em { grid-row: span 2; align-self: start; padding: 2px 0; border-radius: 6px; background: rgba(23, 23, 19, .07); font: 10px var(--mono); font-style: normal; text-align: center; }
	.pv-hit b { font-size: 13px; } .pv-hit span { font-size: 11px; color: #5e5a53; }
	/* La terza entra quando la sua carta è davanti in vista la prima volta, poi resta e scorre. */
	@keyframes pv-slide { from { opacity: 0; translate: calc((var(--r) - 1.5) * -4% + (var(--r) - 1.5) * 12%) 0; } to { opacity: 1; } }
