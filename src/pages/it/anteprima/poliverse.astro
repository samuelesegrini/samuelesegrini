	.pv-shot .pv-live-card b { font-size: 12.5px; } .pv-shot .pv-live-left { display: none; }
	.pv-shot .pv-phone { font-size: 10.5px; }
	/* Le promesse: un pezzo d'interfaccia per carta, in basso, disegnato come il resto della pagina. */
	.pv-pm { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; color: #171713; font-size: 13px; }
	.pv-pm-six { display: grid; grid-template-columns: repeat(3, auto); gap: 6px; }
	.pv-pm-six i { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 11px; background: var(--tint); box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-pm-all img { width: 56px; height: 56px; filter: drop-shadow(0 8px 14px rgba(23, 23, 19, .25)); }
	.pv-pm-empty, .pv-pm-honest { flex-direction: column; gap: 10px; }
	.pv-pm-card { display: grid; gap: 6px; width: min(100%, 220px); padding: 12px 14px; border-radius: 14px; background: #fffefb; box-shadow: inset 0 0 0 1.5px #171713; }
	.pv-pm-card b { font-size: 14px; }
	.pv-pm-card span { display: flex; gap: 10px; }
	.pv-pm-card em { font-style: normal; font-weight: 700; }
	.pv-pm-pill { padding: 6px 12px; border-radius: 999px; background: #171713; color: #fffef9; font-size: 12px; font-weight: 600; }
	.pv-pm-pill.off::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: #ffb27a; }
	.pv-pm-pill.sample { background: #fffefb; color: #171713; box-shadow: inset 0 0 0 1.5px #171713; }
	/* La frase del perché, più vicina al suo titolo: il margine di serie è per una frase da sola. */
	:global(#why .st-statement) { margin-top: 40px !important; }
	/* Perché esiste: i sei posti in fila, ognuno una piastrella del suo colore, appena storta. */
	.pv-place { display: grid; place-items: center; width: min(112px, 86%); aspect-ratio: 1; border-radius: 28%; background: var(--tint); box-shadow: inset 0 0 0 1.5px #171713, 0 14px 28px rgba(23, 23, 19, .12); color: #171713; rotate: var(--r); }
	/* La terza: il muro di icone, di sbieco, che sfuma sotto il testo e scorre piano, una fila per verso. */
	.pv-wall { --icon: clamp(58px, 8.4vw, 104px); --gap: clamp(12px, 1.8vw, 20px); position: relative; isolation: isolate; display: grid; align-content: start; gap: var(--gap); padding-top: clamp(150px, 15vw, 190px); overflow: hidden; }
	/* la sfumatura sotto il testo è un velo del colore della carta: una maschera sul muro in Safari taglia le file che scorrono */
	.pv-wall::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(to bottom, var(--ink) 22%, rgb(23 23 19 / 0) 46%); }
	.pv-wall-row { display: flex; rotate: -8deg; translate: calc((var(--r) - 1.5) * -4%) 0; }
	.pv-wall-track { display: flex; flex: none; gap: var(--gap); margin-left: calc(-3 * (var(--icon) + var(--gap))); }
	.pv-wall-track img { flex: none; width: var(--icon); height: auto; filter: drop-shadow(0 10px 18px rgba(0, 0, 0, .45)); }
	@keyframes pv-drift { to { transform: translateX(calc(-9 * (var(--icon) + var(--gap)))); } }
	/* Le carte piccole: un pezzo d'interfaccia per carta, sempre con lo stesso taglio. */
	.pv-mini { display: grid; align-content: start; align-self: center; translate: 0 -30px; gap: 9px; width: min(296px, 86%); padding: 16px; border-radius: 22px; background: #fffefb; box-shadow: inset 0 0 0 1.5px #171713, 0 20px 40px -26px rgba(23, 23, 19, .45); color: #171713; font-size: 12.5px; text-align: left; }
	.pv-mini-title { font-size: 17px; letter-spacing: -.02em; }
	.pv-seg { display: flex; gap: 4px; padding: 3px; border-radius: 999px; background: rgba(23, 23, 19, .07); }
