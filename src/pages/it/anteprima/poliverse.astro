<script>
	// I disegni in scala fissa si rimpiccioliscono quanto serve a starci interi, senza scatti.
	document.querySelectorAll<HTMLElement>('.pv-stage-box').forEach((box) => {
		const stage = box.querySelector<HTMLElement>('.pv-stage');
		if (!stage) return;
		new ResizeObserver(() => {
			const fit = Math.min(1, box.clientWidth / stage.offsetWidth, box.clientHeight / stage.offsetHeight);
			stage.style.setProperty('--pv-fit', String(fit));
		}).observe(box);
	});

	// Le frasi accanto ai corsi girano con la pila: se un browser le lascia scivolare, le rimette sul suo tempo.
	const lines = document.querySelector('.pv-k-lines');
	const card = lines?.closest('.st-hg-card');
	const lead = card?.querySelector<HTMLElement>('.pv-stage [style*="pvk-rev-a"]');
	if (lines && card && lead) {
		const clock = () => lead.getAnimations().find((a) => (a as CSSAnimation).animationName === 'pvk-rev-a');
		window.setInterval(() => {
			const time = clock()?.currentTime;
			if (typeof time !== 'number' || !card.hasAttribute('data-current')) return;
			lines.querySelectorAll('.st-hg-loop').forEach((line) => {
				line.getAnimations().forEach((a) => {
					if (typeof a.currentTime === 'number' && Math.abs(a.currentTime - time) > 60) a.currentTime = time;
				});
			});
		}, 500);
	}
</script>
