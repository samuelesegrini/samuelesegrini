---
/**
 * Guscio condiviso dalle pagine del banco di prova: documento, stili di pagina e barra.
 * Ogni pagina passa le proprie sezioni; la barra le usa come indice.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/lab-primitives.css';
import ExperimentToolbar from '../components/lab/ExperimentToolbar.astro';
import LabSipario from '../components/lab/LabSipario.astro';
import LabPiede from '../components/lab/LabPiede.astro';
import type { LabLocale, ToolbarSection } from '../components/lab/chrome';
import { experimentLanguages, experimentRoutes, labPaths, mailHref } from '../components/lab/chrome';
import { getLabCopy, riempi } from '../lib/lab-copy';
import { withBase } from '../lib/base';
import { pageTitle } from '../lib/page-title';
import { siteConfig } from '../config/site';

interface Props {
	lang: LabLocale;
	title: string;
	currentHref: string;
	sections: ToolbarSection[];
	/** La stessa pagina nell'altra lingua: il selettore ci porta lì, non alla home. */
	itHref: string;
	enHref: string;
}

const { lang, title, currentHref, sections, itHref, enHref } = Astro.props;
const copy = await getLabCopy(lang);
const labels = { ...copy.toolbar, mail: riempi(copy.toolbar.mail) };

// La radice serve la home italiana: il canonico manda a /it/, così le due non si contendono.
const percorso = Astro.url.pathname;
const assoluto = (href: string) => new URL(href, Astro.site).href;
const canonico = assoluto(percorso === withBase('/') ? labPaths.it.home : percorso);
const titolo = pageTitle(title, siteConfig.name);
const lingue = { it: 'it_IT', en: 'en_GB' } as const;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="description" content={copy.description} />
		<meta name="author" content={siteConfig.name} />
		<meta name="theme-color" content="#f4f1e9" />
		<link rel="canonical" href={canonico} />

		<!-- la stessa pagina nell'altra lingua: l'italiano fa da default per chi non combacia -->
		<link rel="alternate" hreflang="it" href={assoluto(itHref)} />
		<link rel="alternate" hreflang="en" href={assoluto(enHref)} />
		<link rel="alternate" hreflang="x-default" href={assoluto(itHref)} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={titolo} />
		<meta property="og:description" content={copy.description} />
		<meta property="og:url" content={canonico} />
		<meta property="og:locale" content={lingue[lang]} />
		<meta property="og:locale:alternate" content={lingue[lang === 'it' ? 'en' : 'it']} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={titolo} />
		<meta name="twitter:description" content={copy.description} />

		<title>{titolo}</title>
		<!-- navigazione senza ricaricare: il documento viene sostituito, non richiesto da capo -->
		<ClientRouter />
	</head>
	<body>
		<LabSipario label={copy.common.label} ready={copy.common.ready} mark="SS" />
		<main class="stage" aria-label={title}>
			<div class="page-sheet" data-lab-page>
				<!-- le sezioni viaggiano con la pagina: la barra sopravvive allo scambio e le rilegge qui -->
				<script type="application/json" id="lab-sections" is:inline set:html={JSON.stringify(sections)}></script>
				<slot />
				<LabPiede lang={lang} copy={copy} variante="impronta" />
			</div>
			<ExperimentToolbar
				lang={lang}
				name={siteConfig.name}
				ticker={copy.ticker}
				routes={experimentRoutes(lang, currentHref, copy.nav)}
				sections={sections}
				languages={experimentLanguages(lang, itHref, enHref)}
				cv={{ ...copy.cv, href: withBase('/cv.pdf') }}
				labels={labels}
				mailHref={mailHref}
			/>
		</main>

		<script>
			document.addEventListener('astro:before-swap', (event) => {
				event.newDocument.documentElement.dataset.labClientArrival = '';
			});
		</script>

		<style is:global>
			:root { --slot: #242424; --ease: cubic-bezier(.22,1,.36,1); --transizione: 760ms; }
			body { overflow-x: hidden; }
			::view-transition-group(root) { z-index: 0; }
			::view-transition-group(labtoolbar) { z-index: 50; }
			::view-transition-old(root), ::view-transition-new(root) { mix-blend-mode: normal; }
			::view-transition-old(root) { animation: lab-root-forward-out var(--transizione) cubic-bezier(.87,0,.13,1) both; }
			::view-transition-new(root) { animation: lab-root-forward-in var(--transizione) cubic-bezier(.87,0,.13,1) both; }
			[data-astro-transition="back"]::view-transition-old(root) { animation-name: lab-root-back-out; }
			[data-astro-transition="back"]::view-transition-new(root) { animation-name: lab-root-back-in; }
			@keyframes lab-root-forward-out { to { opacity: .58; transform: translateY(-72px) scale(.975); } }
			@keyframes lab-root-forward-in { from { transform: translateY(100vh); } }
			@keyframes lab-root-back-out { to { opacity: .58; transform: translateY(72px) scale(.975); } }
			@keyframes lab-root-back-in { from { transform: translateY(-100vh); } }
			@keyframes lab-toolbar-hide { from, to { opacity: 0; } }
			@keyframes lab-toolbar-hold { from, to { opacity: 1; } }
			.stage { position: relative; width: 100%; min-height: 100%; background: var(--paper); }
			.page-sheet { position: relative; z-index: 0; min-height: 100vh; overflow: clip; isolation: isolate; background: var(--paper); }
			.page-sheet:after { content: ''; position: fixed; z-index: -2; inset: 0; background: radial-gradient(circle at 50% 110%, #ffffff 0, transparent 42%), var(--paper); }
			.page-sheet:before { content: ''; position: fixed; z-index: -1; inset: 0; background-image: linear-gradient(#0808080a 1px, transparent 1px), linear-gradient(90deg, #0808080a 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, transparent 0, #000 100%); opacity: .3; }
			.home-section { display: grid; min-height: 108vh; align-content: center; gap: 44px; padding: 12vh max(24px, 7vw); }
			/* la barra copre la parte bassa della viewport: l'ultima sezione le lascia spazio */
			/* l'ultima sezione chiude sul piede, che è lui a lasciare spazio alla barra */
			.home-section:last-of-type:not(.hero) { min-height: 100vh; }
			/* su schermi larghi il testo tiene la colonna sinistra e le voci occupano la destra,
			   invece di lasciare vuota metà pagina */
			@media (min-width: 1040px) {
				.home-section:has(> .sezione-testo) { padding-bottom: max(12vh, 150px); grid-template-columns: minmax(0, 34ch) minmax(0, 1fr); gap: clamp(48px, 6vw, 96px); align-items: start; }
				.sezione-testo { position: sticky; top: 22vh; }
				.home-section .sezione-testo h1 { font-size: clamp(44px, 5.2vw, 74px); }
				.home-section .sezione-testo p { font-size: 16.5px; }
			}
			.sezione-testo { display: grid; align-content: start; gap: 0; }
			.sezione-testo h1 { max-width: none; }
			.home-section.hero { min-height: 100vh; }
			/* --- hero passo 1: solo impianto e movimento, il riquadro è ancora grigio --- */
			.home-section.hero { position: relative; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto minmax(0, 1fr); align-content: stretch; justify-content: stretch; gap: 0; padding: 84px max(24px, 4vw) 128px; }
			.hero-meta { display: flex; flex-wrap: wrap; gap: 10px 48px; }
			.vetrina { position: relative; display: grid; align-content: center; gap: 26px; min-height: 100vh; padding: 0 max(24px, 4vw); }
			@media (max-width: 767px) { .vetrina { min-height: 0; padding-block: 4vh 12vh } }
			/* La misura di partenza è una misura, non una proporzione: fra 494 e 624px su qualsiasi
			   schermo, ma non più alta della fascia libera fra l'intro e il marchio — 16:9 vuol dire
			   1.78 volte l'altezza. La scala si ricava dividendo quella misura per la larghezza
			   piena: tan(atan2()) è il modo di dividere due lunghezze in CSS. */
			.hero-media {
				--richiamo: calc(-100vh - 15px);
				--piena: calc(100vw - 2 * max(24px, 4vw));
				--misura: min(clamp(494px, 52vw, 624px), calc((100vh - 480px) * 1.7778));
				--piccola: .42;
				width: 100%; aspect-ratio: 16 / 9; border-radius: 28px; overflow: hidden; will-change: transform;
			}
			/* il ripiego .42 qui sopra non può vincere da solo: una custom property invalida non
			   ricade sulla dichiarazione precedente, quindi la proporzione va chiesta a parte */
			@supports (scale: tan(atan2(1px, 1px))) {
				.hero-media { --piccola: clamp(.3, tan(atan2(var(--misura), var(--piena))), .78) }
			}
			.hero-media-fill { width: 100%; height: 100%; background: #dcd8ce; }

			.home-section.hero .hero-marchio { align-self: end; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 2vw; margin: 0; max-width: none; font-size: clamp(42px, 8.4vw, 132px); line-height: .82; letter-spacing: -.055em; text-transform: uppercase; }
			.home-section p.hero-intro { justify-self: end; max-width: 46ch; margin: 14px 0 0; text-align: right; font-size: 15.5px; }
			.hero-marchio .marchio-riga { white-space: nowrap; }
			
			/* la sequenza di ingresso: ogni pezzo sale dalla sua feritoia, il grigio scende nel riquadro */
			@keyframes sale { from { transform: translateY(105%) } to { transform: translateY(0) } }
			@keyframes scopre { from { transform: translateY(-100%) } }
			/* Lo sfalsamento è --ritardo e sta dentro la scorciatoia insieme all'attesa: tenerlo in
			   una regola a parte obbligava a scriverla dopo, o la scorciatoia lo azzerava.
			   Arrivando da un'altra pagina la transizione copre i primi 760ms, e l'attesa è tarata
			   perché il marchio parta dopo che ha chiuso (418 + 400 = 818ms): sotto quella soglia
			   comincia a salire sotto lo snapshot, dove non si vede, e riappare a metà strada. */
			:is(.hero, .vetrina) .mascherina > * {
				animation: sale 1000ms cubic-bezier(.165, .84, .44, 1) calc(var(--ritardo, 0ms) + var(--attesa, 0ms)) backwards;
			}
			/* la discesa è sul riempimento, la crescita sul riquadro: sono due animazioni con due
			   vite diverse, e spegnere l'ingresso non deve spegnere lo scroll */
			.hero-media-fill {
				--ritardo: 260ms;
				animation: scopre 1000ms var(--ease) calc(var(--ritardo, 0ms) + var(--attesa, 0ms)) backwards;
			}
			.hero-meta .mascherina:nth-child(1) > * { --ritardo: 100ms }
			.hero-meta .mascherina:nth-child(2) > * { --ritardo: 200ms }
			.hero-marchio > .mascherina:nth-child(1) > * { --ritardo: 400ms }
			.hero-marchio > .mascherina:nth-child(2) > * { --ritardo: 500ms }
			.hero-intro .mascherina > * { --ritardo: 600ms }
			html[data-lab-client-arrival] { --attesa: calc(var(--transizione) * .55); }
			/* il riquadro è il pezzo più pesante da comporre: arrivando da un'altra pagina
			   aspetta che la transizione abbia chiuso del tutto (418 + 460 = 878ms contro i
			   760 della transizione) invece di partirle dentro. Al caricamento pieno resta
			   dov'era, subito dopo la riga dei dati. */
			html[data-lab-client-arrival] .hero-media-fill { --ritardo: 460ms; }
			@media (prefers-reduced-motion: reduce) {
				:is(.hero, .vetrina) .mascherina > *, .hero-media-fill { animation: none }
			}
			/* --- movimento allo scroll: la hero si apre e si allontana mentre esce --- */
			/* le animazioni d'ingresso usano transform, queste usano translate/scale/opacity:
			   proprietà diverse, quindi si compongono invece di annullarsi */
			@keyframes deriva-sinistra { to { translate: -14vw 0 } }
			@keyframes deriva-destra { to { translate: 14vw 0 } }
			@keyframes cresce { to { translate: 0 0; scale: 1 } }
			@keyframes sfuma { to { opacity: 0 } }
			@supports (animation-timeline: scroll()) {
				.hero-media, .hero-meta, .hero-intro,
				.hero-marchio > .mascherina {
					animation-timeline: scroll(root block);
					animation-range: 0 100vh;
					animation-timing-function: linear;
					animation-fill-mode: both;
					animation-duration: auto;
				}
				/* piccolo e tirato su è lo stato di partenza scritto sull'elemento, non nel
				   fotogramma: senza var() nei keyframe l'animazione può stare sul compositore */
				@media (min-width: 768px) {
					.hero-media { translate: 0 var(--richiamo); scale: var(--piccola); animation-name: cresce }
				}
				.hero-marchio > .mascherina:nth-child(1) { animation-name: deriva-sinistra; animation-range: 7vh 100vh }
				.hero-marchio > .mascherina:nth-child(2) { animation-name: deriva-destra; animation-range: 7vh 100vh }
				.hero-meta, .hero-intro { animation-name: sfuma; animation-range: 0 62vh }
				@media (max-width: 767px) {
					/* il marchio qui va a capo: allontanare due righe impilate non vuol dire niente */
					.hero-marchio > .mascherina,
					.hero-marchio > .mascherina:nth-child(1),
					.hero-marchio > .mascherina:nth-child(2) { animation-name: none; animation-timeline: auto }
				}
			}
			@media (prefers-reduced-motion: reduce) {
				/* stessa forma dei selettori qui sopra, altrimenti il nome dell'animazione sopravvive */
				.hero-media, .hero-meta, .hero-intro,
				.hero-marchio > .mascherina,
				.hero-marchio > .mascherina:nth-child(1),
				.hero-marchio > .mascherina:nth-child(2) { animation: none; animation-timeline: auto }
				.hero-media { translate: none; scale: none }
			}
			/* ogni pezzo entra da sotto la propria feritoia */
			.mascherina { display: block; overflow: hidden; }
			.mascherina > * { display: block; }
			@media (max-width: 1039px) {
				.hero-intro { position: static; max-width: 46ch; margin-top: 22px; text-align: left; }
				/* una riga sola assorbe lo spazio libero: con tutte auto e align-content: stretch
				   il gonfiore si spalmava su ogni riga */
				.home-section.hero { grid-template-rows: auto auto minmax(0, 1fr); gap: 26px; padding-bottom: 172px; }
			}
			/* sul telefono la hero non è una schermata piena: senza il riquadro al centro
			   resterebbe un vuoto, quindi si accorcia e la vetrina arriva subito dopo */
			@media (max-width: 767px) {
				.home-section.hero { min-height: 0; padding-bottom: 44px; }

			}
			.section-kicker { font: 10px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: #8b877f; }
			.home-section h1 { max-width: 14ch; margin: 16px 0 0; font-size: clamp(56px, 11vw, 132px); line-height: .86; letter-spacing: -.075em; }
			.home-section.hero h1:not(.hero-marchio) { max-width: 19ch; font-size: clamp(46px, 6.6vw, 96px); }
			.home-section.hero h1 em { font-family: var(--serif); font-weight: 430; font-style: italic; color: #5f8d3f; }
			.home-section p { max-width: 52ch; margin: 26px 0 0; color: #6b6760; font-size: clamp(16px, 2vw, 20px); line-height: 1.55; }
			.section-rule { width: 96px; height: 10px; margin-top: 34px; border-radius: 6px; }
			#inizio .section-rule { background: #111; }
			#scrittura .section-rule { background: var(--violet); }
			#percorso .section-rule { background: var(--acid); }
			#contatto .section-rule { background: var(--blue); }
			.elenco { display: grid; gap: 10px; max-width: 62ch; margin: 0; padding: 0; list-style: none; }
			.elenco a { display: grid; gap: 7px; padding: 18px 20px; border: 1px solid #d3d1ca; border-radius: 18px; background: #fffefb; transition: border-color 180ms ease, transform 180ms ease; }
			.elenco a:hover { border-color: #b4b0a6; transform: translateY(-2px); }
			.elenco strong { font-size: 19px; letter-spacing: -.035em; }
			.elenco span { color: #6b6760; font-size: 13.5px; line-height: 1.5; }
			/* la riga di contesto: quello che il progetto o l'articolo dichiara di sé */
			.voce-meta { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 2px; }
			.voce-meta i { padding: 4px 9px; border-radius: 999px; background: #efece4; color: #56534b; font: 9px var(--mono); font-style: normal; letter-spacing: .06em; text-transform: uppercase; }
			.voce-meta i:first-child { background: #14140f; color: #f7f5ee; }
			.prosa { max-width: 64ch; margin-top: 28px; color: #3b3830; font-size: clamp(15px, 1.7vw, 18px); line-height: 1.65; }
			.prosa :is(h2, h3) { margin: 34px 0 10px; font-size: clamp(20px, 2.4vw, 27px); letter-spacing: -.03em; line-height: 1.15; }
			.prosa p { max-width: none; margin: 14px 0 0; color: inherit; font-size: inherit; }
			.prosa :is(ul, ol) { margin: 14px 0 0; padding-left: 20px; }
			.prosa li { margin-top: 6px; }
			.prosa a { text-decoration: underline; text-underline-offset: 3px; }
			.prosa :is(pre, code) { font-family: var(--mono); font-size: .88em; }
			.prosa pre { overflow-x: auto; margin: 18px 0 0; padding: 15px 17px; border-radius: 14px; background: #14140f; color: #f3f1ea; }
			.prosa blockquote { margin: 20px 0 0; padding-left: 16px; border-left: 3px solid var(--acid); color: #55524b; }
			.tappe { display: grid; gap: 0; max-width: 62ch; margin: 0; padding: 0; list-style: none; }
			.tappe li { border-top: 1px solid #ddd9d0; }
			.tappe li:last-child { border-bottom: 1px solid #ddd9d0; }
			.tappe a { display: grid; grid-template-columns: 3ch minmax(0, 1fr); gap: 20px; padding: 20px 2px; transition: background-color 180ms ease; }
			.tappe a:hover { background: #f1eee6; }
			.tappe b { color: #97938a; font: 11px var(--mono); font-weight: 400; letter-spacing: .06em; }
			.tappe strong { display: block; font-size: 17px; letter-spacing: -.03em; }
			.tappe em { display: block; margin-top: 6px; max-width: 46ch; color: #6b6760; font-size: 13.5px; font-style: normal; line-height: 1.5; }
			.canali { display: grid; gap: 10px; max-width: 62ch; margin: 0; padding: 0; list-style: none; }
			.canali a { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; padding: 17px 20px; border: 1px solid #d3d1ca; border-radius: 18px; background: #fffefb; transition: border-color 180ms ease, transform 180ms ease; }
			.canali a:hover { border-color: #b4b0a6; transform: translateY(-2px); }
			.canali b { font: 10px var(--mono); font-weight: 400; letter-spacing: .07em; text-transform: uppercase; color: #97938a; }
			.canali span { color: #14140f; font-size: 15px; letter-spacing: -.02em; overflow-wrap: anywhere; }
			.collegamento { display: inline-flex; width: max-content; margin-top: 26px; padding: 12px 18px; border-radius: 999px; background: #111; color: #fffef9; font-size: 14px; font-weight: 700; }
			/* La barra entra una volta sola, quando il sipario si ritira. Il segno sta sulla
			   barra stessa e se lo toglie appena finita: la barra sopravvive allo scambio di
			   pagina, e spostare un nodo fa ripartire le animazioni che ha addosso. */
			@keyframes barra-entra { from { transform: translateY(150%); opacity: 0 } }
			.toolbar-shell[data-entra] { animation: barra-entra 820ms var(--ease) 120ms backwards; }

			/* --- sipario del primo caricamento --- */
			.sipario { position: fixed; z-index: 100; inset: 0; display: none; grid-template-rows: auto 1fr; padding: 84px max(24px, 4vw) 68px; background: var(--paper); }
			html[data-caricando] .sipario,
			.sipario[data-uscita] { display: grid; }
			.sipario-alto, .sipario-basso { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
			.sipario-basso { align-items: end; }
			.sipario-marchio { font-size: 22px; font-weight: 700; letter-spacing: -.06em; }
			.sipario-conta { font: 600 clamp(64px, 13vw, 168px)/.82 var(--mono); letter-spacing: -.06em; font-variant-numeric: tabular-nums; }
			.sipario-barra { position: absolute; left: max(24px, 4vw); right: max(24px, 4vw); bottom: 30px; height: 2px; background: #ddd9d0; overflow: hidden; }
			.sipario-barra b { display: block; height: 100%; background: #14140f; transform-origin: left; transform: scaleX(.02); }
			/* si ritira verso l'alto, come la tendina del riquadro al contrario */
			@keyframes sipario-via { to { transform: translateY(-100%) } }
			.sipario[data-uscita] { animation: sipario-via var(--transizione) var(--ease) forwards; }
			/* l'ingresso della hero resta fermo al primo fotogramma finché il sipario copre */
			html[data-caricando] :is(.hero, .vetrina) .mascherina > *,
			html[data-caricando] .hero-media-fill { animation-play-state: paused; }
			@media (max-width: 620px) { .home-section { min-height: 118vh; } }
		</style>
	</body>
</html>
