---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
	lang: 'it' | 'en';
	title: string;
	description: string;
	translationURL: string;
	canonicalPath?: string;
	alternateIt?: string;
	alternateEn?: string;
	ogType?: 'website' | 'article';
	image?: string;
	imageAlt?: string;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	noIndex?: boolean;
}

const {
	lang,
	title,
	description,
	translationURL,
	canonicalPath = Astro.url.pathname,
	alternateIt = '/it/',
	alternateEn = '/en/',
	ogType = 'website',
	image,
	imageAlt,
	structuredData,
	noIndex = false,
} = Astro.props;
const canonicalURL = new URL(canonicalPath, siteConfig.siteURL);
const imageURL = image ? new URL(image, siteConfig.siteURL) : undefined;
const feedURL = new URL(lang === 'it' ? '/it/rss.xml' : '/en/rss.xml', siteConfig.siteURL);
const labels =
	lang === 'it'
		? {
			projects: 'Progetti',
			writing: 'Articoli',
			about: 'Chi sono',
			contact: 'Scrivimi',
			skip: 'Vai al contenuto',
			language: 'English',
			menu: 'Menu',
		}
		: {
			projects: 'Projects',
			writing: 'Writing',
			about: 'About',
			contact: 'Contact me',
			skip: 'Skip to content',
			language: 'Italiano',
			menu: 'Menu',
		};
const routeBase = lang === 'it' ? '/it' : '/en';
const projectURL = lang === 'it' ? '/it/progetti/' : '/en/projects/';
const writingURL = lang === 'it' ? '/it/articoli/' : '/en/writing/';
const aboutURL = lang === 'it' ? '/it/chi-sono/' : '/en/about/';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="it" href={new URL(alternateIt, siteConfig.siteURL)} />
		<link rel="alternate" hreflang="en" href={new URL(alternateEn, siteConfig.siteURL)} />
		<link rel="alternate" hreflang="x-default" href={new URL(alternateIt, siteConfig.siteURL)} />
		<link rel="alternate" type="application/rss+xml" title={lang === 'it' ? 'Articoli — RSS' : 'Writing — RSS'} href={feedURL} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
		{imageURL && <meta property="og:image" content={imageURL} />}
		{imageURL && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
		{imageURL && <meta name="twitter:image" content={imageURL} />}
		<meta name="twitter:card" content="summary_large_image" />
		{structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
		<ClientRouter fallback="swap" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">{labels.skip}</a>
		<header class="site-header" data-site-header>
			<a class="wordmark" href={`${routeBase}/`} aria-label={`${siteConfig.name}, home`}>
				<span>{siteConfig.name}</span>
				<small>{siteConfig.role}</small>
			</a>
			<nav class="desktop-nav" aria-label={lang === 'it' ? 'Navigazione principale' : 'Primary navigation'}>
				<a href={projectURL}>{labels.projects}</a>
				<a href={writingURL}>{labels.writing}</a>
				<a href={aboutURL}>{labels.about}</a>
				<a class="language-link" href={translationURL}>{labels.language}</a>
				<a class="contact-link" href={`mailto:${siteConfig.email}`}>{labels.contact}</a>
			</nav>
			<details class="mobile-menu">
				<summary>{labels.menu}</summary>
				<nav aria-label={lang === 'it' ? 'Navigazione mobile' : 'Mobile navigation'}>
					<a href={projectURL}>{labels.projects}</a>
					<a href={writingURL}>{labels.writing}</a>
					<a href={aboutURL}>{labels.about}</a>
					<a href={translationURL}>{labels.language}</a>
					<a href={`mailto:${siteConfig.email}`}>{labels.contact}</a>
				</nav>
			</details>
		</header>
		<main id="main">
			<slot />
		</main>
		<slot name="body-fallback" />
		<footer class="site-footer">
			<div>
				<strong>{siteConfig.name}</strong>
				<span>{lang === 'it' ? 'Software pensato con cura.' : 'Software, thoughtfully made.'}</span>
			</div>
			<div class="footer-links">
				<a href={`mailto:${siteConfig.email}`}>Email</a>
				<a href={siteConfig.github}>GitHub</a>
				<a href={siteConfig.linkedin}>LinkedIn</a>
			</div>
		</footer>
		<script>
			import { installPageMotion } from '../scripts/page-motion';

			installPageMotion();
		</script>
		<script is:inline>
			if (!window.__portfolioHeaderInstalled) {
				const updateHeader = () => {
					const header = document.querySelector('[data-site-header]');
					if (header) header.toggleAttribute('data-scrolled', window.scrollY > 12);
				};
				document.addEventListener('scroll', updateHeader, { passive: true });
				document.addEventListener('astro:page-load', updateHeader);
				window.__portfolioHeaderInstalled = true;
			}
			window.requestAnimationFrame(() => {
				const header = document.querySelector('[data-site-header]');
				if (header) header.toggleAttribute('data-scrolled', window.scrollY > 12);
			});
		</script>
	</body>
</html>
