---
/**
 * I numeri, seconda versione di Numbers: ogni valore con la sua etichetta, la frase che lo spiega
 * e il metodo in piccolo, con il rimando alla nota delle fonti (`note`, il numero di Sources).
 * `feature` mette in risalto un numero con un testo accanto (lo slot); `targets` confronta i
 * risultati con gli obiettivi fissati prima di misurare.
 */
import Icon from './Icon.astro';
interface Item { label: string; value: string; unit?: string; text: string; method?: string; note?: number; accent?: boolean }
interface Target { label: string; target: string; value: string; met?: boolean }
interface Props {
	items: Item[];
	feature?: { label: string; value: string; text: string };
	targets?: { title: string; text?: string; rows: Target[] };
}
const { items, feature, targets } = Astro.props;
---
<div class="st-stats">
	<ul class="st-stats-grid" role="list">
		{items.map((s) => (
			<li>
				<span class="st-eyebrow">{s.label}</span>
				<b class:list={{ accent: s.accent }}><span class="st-sr">{s.value}</span><span aria-hidden="true" data-count={s.value}>{s.value}</span>{s.unit && <span class="unit"> {s.unit}</span>}</b>
				<span class="st-stats-text">{s.text}</span>
				{(s.method || s.note) && <span class="st-stats-method st-mono">{s.method}{s.note && <sup><a href={`#note-${s.note}`} aria-label={`Source ${s.note}`}>{s.note}</a></sup>}</span>}
			</li>
		))}
	</ul>
	{feature && <div class="st-stats-feature">
		<div><span class="st-eyebrow">{feature.label}</span><b><span class="st-sr">{feature.value}</span><span aria-hidden="true" data-count={feature.value}>{feature.value}</span></b><span>{feature.text}</span></div>
		<div class="st-stats-lead"><slot /></div>
	</div>}
	{targets && <div class="st-stats-targets">
		<span class="st-stats-target-icon"><Icon name="target" size={26} stroke={2.2} /></span>
		<span class="st-stats-target-copy"><b>{targets.title}</b>{targets.text && <span>{targets.text}</span>}</span>
		<table>
			<caption class="st-sr">{targets.title}</caption>
			<thead class="st-sr"><tr><th scope="col">Measure</th><th scope="col">Target</th><th scope="col">Result</th></tr></thead>
			<tbody>{targets.rows.map((r) => (
				<tr><th scope="row">{r.label}</th><td class="st-mono">target {r.target}</td><td class:list={{ met: r.met !== false }}>{r.value}{r.met === false && <span class="st-sr"> (missed)</span>}</td></tr>
			))}</tbody>
		</table>
	</div>}
</div>

<script>
	// I numeri contano fino al loro valore quando entrano nella finestra, una volta sola.
	// Il valore vero resta nel testo per chi legge con lo screen reader e per chi non ha script.
	interface Count { prefix: string; suffix: string; value: number; decimals: number; dec: string; group: string }
	function leggi(text: string): Count | null {
		const m = text.trim().match(/^([^\d]*)(\d[\d.,]*)(.*)$/);
		if (!m) return null;
		const [, prefix, num, suffix] = m;
		let dec = '', group = '';
		const dot = num.lastIndexOf('.'), comma = num.lastIndexOf(',');
		// tre cifre dopo il separatore sono migliaia (1,220 · 1.220), meno sono decimali (89.6 · 27,4)
		if (dot >= 0 && comma >= 0) { dec = dot > comma ? '.' : ','; group = dec === '.' ? ',' : '.'; }
		else if (comma >= 0) { if (num.length - comma - 1 === 3) group = ','; else dec = ','; }
		else if (dot >= 0) { if (num.length - dot - 1 === 3) group = '.'; else dec = '.'; }
		const plain = (group ? num.split(group).join('') : num).replace(dec || '#', '.');
		const value = Number(plain);
		if (!Number.isFinite(value)) return null;
		return { prefix, suffix, value, decimals: dec ? num.length - num.lastIndexOf(dec) - 1 : 0, dec, group };
	}
	function scrivi(c: Count, v: number) {
		const [int, frac] = v.toFixed(c.decimals).split('.');
		const grouped = c.group ? int.replace(/\B(?=(\d{3})+(?!\d))/g, c.group) : int;
		return `${c.prefix}${grouped}${frac ? c.dec + frac : ''}${c.suffix}`;
	}
	function contaNumeri() {
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
			if (el.dataset.countBound) return;
			el.dataset.countBound = '1';
			const c = leggi(el.dataset.count!);
			// già in vista (una pagina riaperta a metà) o niente da contare: resta com'è
			if (!c || c.value === 0 || el.getBoundingClientRect().top < innerHeight) return;
			const final = el.textContent;
			el.textContent = scrivi(c, 0);
			const io = new IntersectionObserver(([entry]) => {
				if (!entry.isIntersecting) return;
				io.disconnect();
				const start = performance.now();
				const step = (now: number) => {
					const t = Math.min(1, (now - start) / 1200);
					// la curva d'uscita di Apple, cubic-bezier(0, 0, .5, 1), approssimata
					const eased = 1 - Math.pow(1 - t, 3);
					el.textContent = t < 1 ? scrivi(c, c.value * eased) : final;
					if (t < 1) requestAnimationFrame(step);
				};
				requestAnimationFrame(step);
			}, { threshold: 0.6 });
			io.observe(el);
		});
	}
	contaNumeri();
	document.addEventListener('astro:page-load', contaNumeri);
</script>
