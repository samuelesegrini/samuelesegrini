---
/**
 * Un'icona a tratto dei racconti. Decorativa per scelta: accanto c'è sempre un testo che dice
 * la stessa cosa, e il lettore di schermo legge quello. Con `label` diventa un'immagine con nome.
 */
import { icons, type IconName } from './icons';
interface Props { name: IconName; size?: number | string; stroke?: number; label?: string; class?: string }
const { name, size = 18, stroke = 2, label, class: className } = Astro.props;
---
<svg class:list={['st-icon', className]} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false" set:html={icons[name]} />
