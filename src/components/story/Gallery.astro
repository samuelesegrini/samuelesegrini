---
/** Le schermate in una cornice di dispositivo, a carosello. Senza `src` resta un segnaposto dichiarato. */
import { storyLang } from '../../lib/story-lang';
interface Shot { title: string; caption: string; src?: string; alt?: string; device?: 'ipad' | 'iphone' | 'mac' }
interface Props { shots: Shot[]; label?: string }
const it = storyLang(Astro.url) === 'it';
const { shots, label = it ? 'Schermate' : 'Screens' } = Astro.props;
---
<div class="st-rail" data-rail>
	<ul class="st-gallery" role="list" aria-label={label} tabindex="0" data-rail-track>
		{shots.map((s) => (
			<li class={`dev-${s.device ?? 'ipad'}`}>
				<figure>
					<div class="st-device"><div class="st-screen">{s.src ? <img src={s.src} alt={s.alt ?? ''} loading="lazy" /> : <span>[Screenshot · {s.title}]</span>}</div></div>
					<figcaption><b>{s.title}</b><span>{s.caption}</span></figcaption>
				</figure>
			</li>
		))}
	</ul>
	<div class="st-rail-controls"><button type="button" data-rail-prev aria-label={it ? 'Schermata precedente' : 'Previous screen'}>←</button><button type="button" data-rail-next aria-label={it ? 'Schermata successiva' : 'Next screen'}>→</button></div>
</div>
