---
/** La fila di carte "in breve": una frase forte per carta, scorre di lato con i pulsanti. */
import { storyLang } from '../../lib/story-lang';
interface Card { text: string; meta?: string; tone?: 'paper' | 'dark' | 'acid' | 'blue' | 'violet' | 'orange' }
interface Props { cards: Card[]; label?: string }
const it = storyLang(Astro.url) === 'it';
const { cards, label = it ? 'Punti forti' : 'Highlights' } = Astro.props;
---
<div class="st-rail" data-rail>
	<ul class="st-highlights" role="list" aria-label={label} tabindex="0" data-rail-track>
		{cards.map((c) => <li class={`tone-${c.tone ?? 'paper'}`}><p>{c.text}</p>{c.meta && <span class="st-eyebrow">{c.meta}</span>}</li>)}
	</ul>
	<div class="st-rail-controls"><button type="button" data-rail-prev aria-label={it ? 'Carta precedente' : 'Previous card'}>←</button><button type="button" data-rail-next aria-label={it ? 'Carta successiva' : 'Next card'}>→</button></div>
</div>
