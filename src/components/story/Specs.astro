---
/** La scheda tecnica: coppie etichetta e valore, come le specifiche di un prodotto. */
interface Spec { label: string; value: string }
interface Props { specs: Spec[] }
const { specs } = Astro.props;
---
<dl class="st-specs">{specs.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl>
