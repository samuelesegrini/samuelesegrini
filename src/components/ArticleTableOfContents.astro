---
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: readonly Heading[]; lang: 'it' | 'en'; context?: 'article' | 'project' }
const { headings, lang, context = 'article' } = Astro.props;
const label = context === 'project'
	? (lang === 'it' ? 'Indice del progetto' : 'Project contents')
	: (lang === 'it' ? "Indice dell'articolo" : 'In this article');
const title = context === 'project'
	? (lang === 'it' ? 'In questo progetto' : 'In this project')
	: (lang === 'it' ? 'In questo articolo' : 'In this article');
---

<nav class="article-toc" aria-label={label}>
	<p>{title}</p>
	<ol>{headings.map((heading) => <li class:list={{ indent: heading.depth === 3 }}><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ol>
</nav>

<script>
	const readingLine = () => Math.min(window.innerHeight * 0.55, 480);
	const cleanups = new Set<() => void>();

	const initializeTableOfContents = () => {
		document.querySelectorAll<HTMLElement>('.article-toc').forEach((toc) => {
			if (toc.dataset.tocInitialized === 'true') return;

			const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
			const chapters = links.flatMap((link) => {
				const id = decodeURIComponent(link.hash.slice(1));
				const heading = document.getElementById(id);
				return heading ? [{ heading, link }] : [];
			});

			if (chapters.length === 0) return;

			let frame = 0;
			const setCurrent = (current: HTMLAnchorElement) => {
				links.forEach((link) => {
					if (link === current) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				});
			};
			const updateCurrentChapter = () => {
				frame = 0;
				let current = chapters[0];
				for (const chapter of chapters) {
					if (chapter.heading.getBoundingClientRect().top > readingLine()) break;
					current = chapter;
				}
				setCurrent(current.link);
			};
			const scheduleUpdate = () => {
				if (frame === 0) frame = window.requestAnimationFrame(updateCurrentChapter);
			};
			const onLinkClick = (event: Event) => {
				const link = event.currentTarget as HTMLAnchorElement;
				setCurrent(link);
			};

			links.forEach((link) => link.addEventListener('click', onLinkClick));
			window.addEventListener('scroll', scheduleUpdate, { passive: true });
			window.addEventListener('resize', scheduleUpdate);
			toc.dataset.tocInitialized = 'true';
			cleanups.add(() => {
				links.forEach((link) => link.removeEventListener('click', onLinkClick));
				window.removeEventListener('scroll', scheduleUpdate);
				window.removeEventListener('resize', scheduleUpdate);
				if (frame !== 0) window.cancelAnimationFrame(frame);
				frame = 0;
				toc.removeAttribute('data-toc-initialized');
			});
			updateCurrentChapter();
		});
	};

	const cleanupTableOfContents = () => {
		cleanups.forEach((cleanup) => cleanup());
		cleanups.clear();
	};

	initializeTableOfContents();
	document.addEventListener('astro:page-load', initializeTableOfContents);
	document.addEventListener('astro:before-swap', cleanupTableOfContents);
</script>
