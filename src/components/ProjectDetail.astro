---
import { render } from 'astro:content';
import { siteConfig } from '../config/site';
import { findPostDocument, findProjectDocument, getPortfolioContent, postPath, projectPath, type ProjectDocument } from '../lib/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleTableOfContents from './ArticleTableOfContents.astro';
import RelatedWritingList from './RelatedWritingList.astro';

interface Props { document: ProjectDocument }
const { document } = Astro.props;
const project = document.data;
const { projectDocuments, postDocuments } = await getPortfolioContent();
const otherLocale = project.locale === 'it' ? 'en' : 'it';
const translation = findProjectDocument(projectDocuments, project.translationKey, otherLocale);
if (!translation) throw new Error(`Missing translation for project ${project.translationKey}`);
const { Content, headings } = await render(document);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const showTableOfContents = tocHeadings.filter(({ depth }) => depth === 2).length >= 3;
const relatedWriting = project.relatedPosts.flatMap(({ key, reason }) => {
	const related = findPostDocument(postDocuments, key, project.locale);
	return related ? [{ title: related.data.title, reason, href: postPath(related.data) }] : [];
});
const isIt = project.locale === 'it';
const currentPath = projectPath(project);
const translationPath = projectPath(translation.data);
const italianPath = isIt ? currentPath : translationPath;
const englishPath = isIt ? translationPath : currentPath;
const kindLabel = isIt
	? { app: 'App', package: 'Pacchetto', 'open-source': 'Open source', experiment: 'Esperimento' }[project.kind]
	: { app: 'App', package: 'Package', 'open-source': 'Open source', experiment: 'Experiment' }[project.kind];
const lifecycleLabel = (isIt
	? { verified: 'Verificato', archived: 'Archiviato', prototype: 'Prototipo', 'in-progress': 'In corso' }
	: { verified: 'Verified', archived: 'Archived', prototype: 'Prototype', 'in-progress': 'In progress' })[project.lifecycle];
const authorshipLabel = (isIt
	? { individual: 'Lavoro individuale', team: 'Lavoro di squadra', contribution: 'Contributo' }
	: { individual: 'Individual work', team: 'Team work', contribution: 'Contribution' })[project.authorship];
const relationshipLabels = isIt
	? { 'my-repository': 'Repository personale', 'team-repository': 'Repository del team', 'live-demo': 'Demo pubblica', 'write-up': 'Approfondimento', 'course-page': 'Pagina del corso' }
	: { 'my-repository': 'My repository', 'team-repository': 'Team repository', 'live-demo': 'Live demo', 'write-up': 'Write-up', 'course-page': 'Course page' };
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	description: project.excerpt,
	inLanguage: project.locale,
	dateCreated: String(project.year),
	url: currentPath,
};
---

<BaseLayout
	lang={project.locale}
	title={project.seoTitle ?? `${project.title} — Project`}
	description={project.seoDescription ?? project.excerpt}
	translationURL={translationPath}
	canonicalPath={currentPath}
	alternateIt={italianPath}
	alternateEn={englishPath}
	structuredData={structuredData}
	image={project.socialImage ?? project.coverImage}
	imageAlt={project.coverAlt}
>
	<article class="case-study">
		<header class="detail-hero dark-section">
			<a class="back-link" href={isIt ? '/it/progetti/' : '/en/projects/'}>← {isIt ? 'Tutti i progetti' : 'All projects'}</a>
			<div class="detail-title"><div><p class="eyebrow">{kindLabel} · {project.year}</p><h1 tabindex="-1">{project.title}</h1></div><p>{project.excerpt}</p></div>
			<img transition:name={project.translationKey ? `project-art-${project.translationKey}` : undefined} src={project.coverImage} alt={project.coverAlt} width="1200" height="800" />
		</header>
		<div class="detail-grid section">
			<aside aria-label={isIt ? 'Dettagli del progetto' : 'Project details'}>
				{project.outcomes.length > 0 && <div class="project-outcomes"><span>{isIt ? 'Risultati' : 'Outcomes'}</span><dl>{project.outcomes.map((outcome) => <div><dt>{outcome.value}</dt><dd>{outcome.label}{outcome.method && <small>{outcome.method}</small>}</dd></div>)}</dl></div>}
				<div><span>{isIt ? 'Stato' : 'Status'}</span><strong>{lifecycleLabel}</strong></div>
				<div><span>{isIt ? 'Paternità' : 'Authorship'}</span><strong>{authorshipLabel}</strong></div>
				<div><span>{isIt ? 'Anno' : 'Year'}</span><strong>{project.year}</strong></div>
				<div><span>{isIt ? 'Tipo' : 'Type'}</span><strong>{kindLabel}</strong></div>
				<div><span>{isIt ? 'Ruolo' : 'Role'}</span><strong>{project.role}</strong></div>
				<div><span>{isIt ? 'Tecnologie' : 'Technologies'}</span><strong>{project.technologies.join(', ')}</strong></div>
				{project.startingPoint && <div><span>{isIt ? 'Punto di partenza' : 'Starting point'}</span><strong>{project.startingPoint}</strong></div>}
				{relatedWriting.length > 0 && <div class="project-writing"><span>{isIt ? 'Approfondimenti' : 'Go deeper'}</span><RelatedWritingList entries={relatedWriting} lang={project.locale} compact /></div>}
				{project.links.length > 0 && <div class="project-links"><span>{isIt ? 'Collegamenti esterni' : 'External links'}</span><ul>{project.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer"><strong>{link.label}</strong><small>{new URL(link.url).hostname}</small><em>{relationshipLabels[link.relationship]}</em></a></li>)}</ul></div>}
				<div class="project-actions">
					<a class="primary-button project-contact" href={`mailto:${siteConfig.email}`}>{isIt ? 'Parliamone' : "Let's talk"} <span aria-hidden="true">↗</span></a>
				</div>
				{showTableOfContents && <ArticleTableOfContents headings={tocHeadings} lang={project.locale} context="project" />}
			</aside>
			<div class="prose"><Content /></div>
		</div>
	</article>
	{relatedWriting.length > 0 && <section class="section related-section dark-section"><div class="section-heading"><div><p class="eyebrow">{isIt ? 'Approfondimenti' : 'Go deeper'}</p><h2>{isIt ? 'Articoli collegati' : 'Related writing'}</h2></div></div><RelatedWritingList entries={relatedWriting} lang={project.locale} /></section>}
</BaseLayout>
