---
import { getFeaturedProjects, getPublishedPosts, type Locale } from '../lib/content';
import { getPortfolioContent, postPath, projectPath } from '../lib/portfolio';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from './PostCard.astro';
import ProjectCard from './ProjectCard.astro';

interface Props { lang: Locale }

const { lang } = Astro.props;
const { projects, posts } = await getPortfolioContent();
const featured = getFeaturedProjects(projects, lang);
const latestPosts = getPublishedPosts(posts, lang).slice(0, 2);
const isIt = lang === 'it';
const copy = isIt
	? {
		title: `${siteConfig.name} — Software Engineer`,
		description: 'Portfolio bilingue di un Software Engineer: progetti, case study e note tecniche.',
		eyebrow: 'Software Engineer · Italia',
		headline: 'Software affidabile,',
		emphasis: 'dall’interfaccia all’infrastruttura.',
		intro: 'Progetto esperienze di prodotto e i sistemi che restano corretti quando reti, dispositivi e operazioni reali si complicano.',
		cta: 'Email',
		preview: 'Anteprima strutturale',
		previewBody: 'Profilo, altri case study, articoli, GitHub e CV sono ancora da completare prima della pubblicazione.',
		selected: 'Lavori selezionati',
		featured: 'Progetti in evidenza',
		allProjects: 'Vedi tutto l’archivio',
		writing: 'Dal blog',
		latest: 'Ultimi articoli',
		allWriting: 'Tutti gli articoli',
		aboutLabel: 'In breve',
		about: 'Dai sistemi distribuiti allo sviluppo iOS.',
		aboutBody: 'Sto portando nello sviluppo iOS ciò che ho imparato costruendo sistemi, interfacce e progetti collaborativi: vincoli espliciti, verifiche concrete e attenzione al prodotto.',
		aboutLink: 'Scopri chi sono',
	}
	: {
		title: `${siteConfig.name} — Software Engineer`,
		description: 'Bilingual Software Engineer portfolio: projects, case studies, and technical writing.',
		eyebrow: 'Software Engineer · Italy',
		headline: 'Reliable software,',
		emphasis: 'from interface to infrastructure.',
		intro: 'I design product experiences and the systems that stay correct when networks, devices, and real operations get messy.',
		cta: 'Email',
		preview: 'Structural preview',
		previewBody: 'Profile copy, other case studies, articles, GitHub, and résumés still need completing before publication.',
		selected: 'Selected work',
		featured: 'Featured projects',
		allProjects: 'View the complete archive',
		writing: 'From the blog',
		latest: 'Latest articles',
		allWriting: 'All writing',
		aboutLabel: 'In short',
		about: 'From distributed systems to iOS development.',
		aboutBody: 'I am bringing what I learned from systems, interfaces, and collaborative projects into iOS development: explicit constraints, concrete verification, and attention to the product.',
		aboutLink: 'More about me',
	};
const projectArchiveURL = isIt ? '/it/progetti/' : '/en/projects/';
const writingArchiveURL = isIt ? '/it/articoli/' : '/en/writing/';
const aboutURL = isIt ? '/it/chi-sono/' : '/en/about/';
const tones = ['blue', 'lime', 'violet'] as const;
const kindLabels = isIt
	? { app: 'App', package: 'Pacchetto', 'open-source': 'Open source', experiment: 'Esperimento' }
	: { app: 'App', package: 'Package', 'open-source': 'Open source', experiment: 'Experiment' };
const authorshipLabels = isIt
	? { individual: 'Individuale', team: 'Team', contribution: 'Contributo' }
	: { individual: 'Individual', team: 'Team', contribution: 'Contribution' };
const personData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: siteConfig.name,
	jobTitle: siteConfig.role,
	url: new URL(isIt ? '/it/' : '/en/', siteConfig.siteURL).href,
	sameAs: [siteConfig.github, siteConfig.linkedin],
};
---

<BaseLayout
	lang={lang}
	title={copy.title}
	description={copy.description}
	translationURL={isIt ? '/en/' : '/it/'}
	alternateIt="/it/"
	alternateEn="/en/"
	structuredData={personData}
>
	<section class="hero dark-section">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h1>{copy.headline} <em>{copy.emphasis}</em></h1>
		<div class="hero-bottom">
			<p>{copy.intro}</p>
			<a class="primary-button" href={`mailto:${siteConfig.email}`}>{copy.cta} <span aria-hidden="true">↗</span></a>
		</div>
		<div class="hero-orbit" aria-hidden="true"><span>SWIFT</span><span>PRODUCT</span><span>SYSTEMS</span></div>
	</section>

	{siteConfig.isPlaceholder && <div class="preview-notice" role="note"><strong>{copy.preview}</strong><span>{copy.previewBody}</span></div>}

	<section class="section work-section" aria-labelledby="featured-title">
		<div class="section-heading">
			<div><p class="eyebrow dark">{copy.selected}</p><h2 id="featured-title">{copy.featured}</h2></div>
			<a href={projectArchiveURL}>{copy.allProjects} <span aria-hidden="true">↗</span></a>
		</div>
		<div class="project-grid">
			{featured.map((project, index) => (
				<ProjectCard
					rank={project.featuredRank!}
					title={project.title}
					excerpt={project.excerpt}
					kind={kindLabels[project.kind]}
					year={project.year}
					href={projectPath(project)}
					tone={tones[index]}
					lead={index === 0}
					featured
					translationKey={project.translationKey}
					role={project.role}
					authorshipLabel={authorshipLabels[project.authorship]}
					lang={lang}
					coverImage={project.coverImage}
					coverAlt={project.coverAlt}
				/>
			))}
		</div>
	</section>

	<section class="section writing-section dark-section" aria-labelledby="latest-title">
		<div class="section-heading">
			<div><p class="eyebrow">{copy.writing}</p><h2 id="latest-title">{copy.latest}</h2></div>
			<a href={writingArchiveURL}>{copy.allWriting} <span aria-hidden="true">↗</span></a>
		</div>
		<div class="post-grid">
			{latestPosts.map((post) => <PostCard title={post.title} excerpt={post.excerpt} href={postPath(post)} date={post.publishedAt} tags={post.tags} lang={lang} />)}
		</div>
	</section>

	<section class="section about-teaser">
		<p class="eyebrow dark">{copy.aboutLabel}</p>
		<div><h2>{copy.about}</h2><div><p>{copy.aboutBody}</p><a class="text-link" href={aboutURL}>{copy.aboutLink} <span aria-hidden="true">↗</span></a></div></div>
	</section>
</BaseLayout>
