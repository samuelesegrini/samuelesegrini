---
/** Production footer adapted from lab footer. */
import { siteConfig } from '../config/site';

interface Props {
	lang: 'it' | 'en';
}
const { lang } = Astro.props;

// URLs
const routeBase = lang === 'it' ? '/it' : '/en';
const projectURL = lang === 'it' ? '/it/progetti/' : '/en/projects/';
const writingURL = lang === 'it' ? '/it/articoli/' : '/en/writing/';
const aboutURL = lang === 'it' ? '/it/chi-sono/' : '/en/about/';

// Footer copy
const copy = {
	footer: {
		invito: lang === 'it' ? 'Un progetto, una domanda, un’idea.' : 'A project, a question, an idea.',
		scrivimi: lang === 'it' ? 'Scrivimi' : 'Write me',
		navigazione: lang === 'it' ? 'Navigazione' : 'Navigation',
		altrove: lang === 'it' ? 'Altrove' : 'Elsewhere',
		colofone: lang === 'it' ? 'Colofone' : 'Colophon',
		fattoCon: lang === 'it' ? 'Fatto con' : 'Made with',
		caratteri: lang === 'it' ? 'Caratteri open source' : 'Open source characters',
		lingua: lang === 'it' ? 'Lingua' : 'Language',
		diritti: lang === 'it' ? 'Tutti i diritti riservati' : 'All rights reserved',
	}
};

const t = copy.footer;

// Mail href
const mailHref = `mailto:${siteConfig.email}`;

// Navigation items: home, work, writing, about
const navItems = [
	{ href: routeBase, label: lang === 'it' ? 'Home' : 'Home' }, // We might want to translate home, but let's keep as is for now
	{ href: projectURL, label: lang === 'it' ? 'Lavoro' : 'Work' },
	{ href: writingURL, label: lang === 'it' ? 'Scrittura' : 'Writing' },
	{ href: aboutURL, label: lang === 'it' ? 'Chi sono' : 'About' },
];

// Elsewhere links
const altrove = [
	{ label: 'GitHub', href: siteConfig.github },
	{ label: 'LinkedIn', href: siteConfig.linkedin },
	{ label: 'Email', href: mailHref },
];

// Language switcher
const lingue = [
	{ label: 'English', href: lang === 'it' ? '/en/' : '/it/', current: lang === 'en' },
	{ label: 'Italiano', href: lang === 'it' ? '/it/' : '/en/', current: lang === 'it' },
];

const anno = new Date().getFullYear();
---
