---
/**
 * Barra sperimentale: guscio apribile, indice delle sezioni della pagina e strumenti.
 * Il mazzo delle carte e lo scroll spy sono guidati dalle `.home-section` che la pagina espone.
 */
import type { ChromeRoute, ToolbarLanguage, ToolbarSection } from './chrome';

interface Props {
	lang: string;
	name: string;
	ticker: string;
	routes: ChromeRoute[];
	sections: ToolbarSection[];
	languages: readonly [ToolbarLanguage, ToolbarLanguage];
	cv: { kicker: string; long: string; short: string; aria: string; href: string };
	labels: { top: string; topCaption: string; mail: string; mailSending: string; mailSent: string; mailCaption: string; language: string; openMenu: string };
	mailHref: string;
}

const { lang, name, ticker, routes, sections, languages, cv, labels, mailHref } = Astro.props;
---

    <section class="toolbar-shell" id="toolbar" transition:persist={`barra-${lang}`}>
      <nav class="nav-panel" aria-label="Navigazione principale">
        <div class="panel-identity">
          <div class="panel-lingue" role="group" aria-label={labels.language}>
            {languages.map((lingua) => (
              <a href={lingua.href} aria-current={lingua.current ? 'true' : undefined}>{lingua.label}</a>
            ))}
          </div>
          <div class="identity-name">{name} <span id="active-route">{(routes.find((route) => route.current) ?? routes[0]).label}</span></div>
          <div class="ticker" aria-label="Software engineer, Swift e iOS, product engineering, sistemi affidabili">
            <div class="ticker-track"><span>{ticker}</span><span aria-hidden="true">{ticker}</span></div>
          </div>
        </div>
        <ul class="nav-list">
          {routes.map((route) => (
            <li>
              <a class:list={['nav-item', route.current && 'active']} href={route.href} data-page={route.label}>
                <span class:list={['nav-preview', route.preview]} set:html={route.previewHtml ?? ""} />
                <span class="nav-copy"><small>{route.kicker}</small><strong>{route.label}</strong></span>
                <span class="nav-arrow">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="identity-row">
        <a class="identity-mark" href={routes[0].href} aria-label={routes[0].label}>SS</a>
        <div class="slot-row">
          <div class="mode-area">
            <div class="mode-group" data-when="hero">
              <a class="cv-slot" data-when="hero" type="button" aria-label={cv.aria} href={cv.href} download><span><small>{cv.kicker}</small><b><span class="lungo">{cv.long}</span><span class="corto">{cv.short}</span></b></span><i aria-hidden="true">↓</i></a>
            </div>
            <div class="mode-group" data-when="index">
              <button class="slot two shuffle-slot" aria-label={`${sections[0].kicker}: ${sections[0].value}`}></button>
              <div class="widget" data-detail><div><small>{sections[0].detail.kicker}</small><b>{sections[0].detail.value}</b></div></div>
              <button class="top-slot" data-top type="button" aria-label={labels.top}><svg class="top-chevron" viewBox="0 0 24 12" aria-hidden="true"><path d="M3 9 12 3 21 9"/></svg><small>{labels.topCaption}</small></button>
            </div>
          </div>
          <a class="slot one plane-slot span-1 keep-mobile" href={mailHref} aria-label={labels.mail} data-phase="idle" data-label-sending={labels.mailSending} data-label-sent={labels.mailSent}><span class="plane-stage"><i class="plane-shadow"></i><svg class="plane-icon" viewBox="0 0 34 30" aria-hidden="true"><path class="plane-body" d="M3 14.6 31 3 22.1 27.2 16.4 19.4 10.1 22.3 11.7 16.2Z"/><path class="plane-fold" d="M11.7 16.2 31 3 16.4 19.4"/></svg></span><small>{labels.mailCaption}</small></a>
          <div class="widget toggle-square span-1 keep-mobile"><div class="segmented" data-active={languages[1].current ? '1' : '0'} role="group" aria-label={labels.language}><span class="segment-bed" aria-hidden="true"></span><span class="segment-bed bottom" aria-hidden="true"></span><a href={languages[0].href} aria-current={languages[0].current ? "true" : undefined}>{languages[0].label}</a><a href={languages[1].href} aria-current={languages[1].current ? "true" : undefined}>{languages[1].label}</a></div></div>
        </div>
        <button class="menu-toggle" id="menu-toggle" type="button" aria-label={labels.openMenu} aria-expanded="false">
          <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
      </div>
    </section>

<!-- globale: le carte della sezione sono create a runtime, quindi lo scoping di Astro non le raggiungerebbe -->
<style is:global>
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    .toolbar-shell{--active-highlight:var(--acid);position:fixed;z-index:10;left:50%;bottom:24px;width:min(720px,calc(100vw - 36px));height:98px;transform:translateX(-50%);overflow:hidden;border:1px solid #303030;border-radius:27px;background:#121212;color:white;box-shadow:0 28px 85px #0005;transition:height 520ms cubic-bezier(.2,.8,.2,1),border-radius 360ms ease}
    .toolbar-shell.open{height:min(590px,calc(100svh - 48px));border-radius:30px}
    .nav-panel{height:calc(100% - 98px);padding:14px 14px 0;opacity:0;transform:translateY(22px);pointer-events:none;transition:opacity 180ms ease,transform 420ms cubic-bezier(.2,.8,.2,1)}
    .toolbar-shell.open .nav-panel{opacity:1;transform:none;pointer-events:auto;transition-delay:120ms}
    .nav-list{display:grid;gap:7px;margin:0;padding:0;list-style:none}
    .nav-item{position:relative;display:grid;text-decoration:none;width:100%;grid-template-columns:78px 1fr 42px;align-items:center;gap:20px;min-height:90px;padding:7px 13px 7px 7px;border:0;border-radius:19px;background:transparent;color:white;text-align:left;cursor:pointer;transition:background 180ms ease,color 180ms ease}
    .nav-item[data-page="Home"]{--highlight:var(--acid)}.nav-item[data-page="Progetti"]{--highlight:var(--blue)}.nav-item[data-page="Articoli"]{--highlight:var(--violet)}.nav-item[data-page="Chi sono"]{--highlight:var(--orange)}
    .nav-item:hover,.nav-item:focus-visible{outline:0;background:#242424}.nav-item.active{background:var(--highlight);color:var(--ink)}
    .nav-preview{position:relative;display:grid;width:78px;height:76px;place-items:center;overflow:hidden;border-radius:14px;background:#f3f3f1;color:#111}
    .preview-home{font:800 25px var(--sans);letter-spacing:-.07em}
    .preview-projects{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:3px;padding:10px;background:#ece8df}.preview-projects i{width:100%;height:100%;border-radius:5px}.preview-projects i:nth-child(1){grid-row:1/3;background:var(--acid)}.preview-projects i:nth-child(2){background:var(--blue)}.preview-projects i:nth-child(3){background:var(--violet)}
    .preview-writing{display:block;padding:13px;background:var(--blue)}.preview-writing b{font:440 27px/.8 var(--serif)}.preview-writing i{display:block;width:100%;height:2px;margin-top:10px;background:#111}.preview-writing i:nth-of-type(2){width:70%}
    .preview-about{background:#0c0c0c}.preview-about:before,.preview-about:after{content:'';position:absolute;border:1px solid #637d51;border-radius:50%}.preview-about:before{width:56px;height:56px}.preview-about:after{width:27px;height:27px;background:var(--acid)}
    .nav-copy small{display:block;margin-bottom:4px;color:#8f8f8f;font:10px var(--mono);letter-spacing:.09em;text-transform:uppercase}.nav-item.active .nav-copy small{color:#375b24}.nav-copy strong{display:block;font-size:25px;letter-spacing:-.04em}.nav-arrow{display:grid;width:38px;height:38px;place-items:center;border:1px solid #3f3f3f;border-radius:50%;font-size:16px}.nav-item.active .nav-arrow{visibility:hidden}
    .identity-row{position:absolute;left:0;right:0;bottom:0;display:grid;grid-template-columns:78px minmax(0,1fr) 68px;gap:6px;align-items:center;height:98px;padding:10px 12px;border-top:1px solid #262626;background:#121212}
    .identity-mark{position:relative;display:grid;cursor:pointer;text-decoration:none;width:78px;height:76px;place-items:center;border-radius:15px;background:var(--white);color:var(--ink);font:800 22px var(--sans);letter-spacing:-.06em}
    .identity-content{min-width:0;overflow:hidden}.identity-name{display:flex;align-items:center;gap:10px;margin-bottom:7px;font-size:17px;font-weight:750;letter-spacing:-.035em}.identity-name span{color:var(--active-highlight);font:9px var(--mono);letter-spacing:.08em;text-transform:uppercase;transition:color 180ms ease}
    .ticker{position:relative;overflow:hidden;color:#8f8f8f;font:13px var(--mono);letter-spacing:.055em;text-transform:uppercase;white-space:nowrap;mask-image:linear-gradient(90deg,transparent,#000 7%,#000 88%,transparent)}.ticker-track{display:inline-flex;width:max-content;animation:ticker 17s linear infinite}.ticker-track span{padding-right:42px}
    .menu-toggle{display:grid;margin-left:10px;width:58px;height:58px;place-items:center;border:0;border-radius:17px;background:#1d1d1d;color:white;cursor:pointer;transition:background 180ms ease,transform 180ms ease}.menu-toggle:hover{background:#282828}.menu-toggle:active{transform:scale(.96)}
    .menu-icon{position:relative;width:24px;height:18px}.menu-icon i{position:absolute;left:0;width:24px;height:2px;border-radius:4px;background:currentColor;will-change:transform;transition:transform 320ms ease,opacity 140ms ease 170ms}.menu-icon i:nth-child(1){top:1px}.menu-icon i:nth-child(2){top:8px}.menu-icon i:nth-child(3){top:15px}.toolbar-shell.open .menu-icon i{transition:transform 320ms ease,opacity 120ms ease}.toolbar-shell.open .menu-icon i:nth-child(1){transform:translateY(7px) rotate(45deg)}.toolbar-shell.open .menu-icon i:nth-child(2){opacity:0}.toolbar-shell.open .menu-icon i:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
    @keyframes ticker{to{transform:translateX(-50%)}}
    @media(max-width:620px){.toolbar-shell{bottom:12px;width:calc(100vw - 24px);height:86px;border-radius:23px}.toolbar-shell.open{height:min(548px,calc(100svh - 24px));border-radius:25px}.nav-panel{height:calc(100% - 86px);padding:10px 10px 0}.nav-list{gap:5px}.nav-item{grid-template-columns:64px 1fr 34px;gap:14px;min-height:79px;padding:6px 9px 6px 6px;border-radius:16px}.nav-preview{width:64px;height:64px;border-radius:12px}.nav-copy small{font-size:8px}.nav-copy strong{font-size:21px}.nav-arrow{width:32px;height:32px}.identity-row{grid-template-columns:64px minmax(0,1fr) 54px;gap:6px;height:86px;padding:9px}.identity-mark{width:64px;height:66px;border-radius:13px;font-size:19px}.identity-name{font-size:15px}.identity-name span{display:none}.ticker{font-size:11px}.menu-toggle{margin-left:7px;width:50px;height:50px;border-radius:14px}}
    /* --- schermata home: sezioni molto alte, per lavorare su ancore e scroll --- */
    @media(max-width:620px){.home-section{min-height:118vh}.home-section:last-of-type{padding-bottom:170px}}
    /* --- composizione 02: macchine 02 e 05, widget statici, cambio lingua --- */
    .slot{position:relative;height:92px;border:0;border-radius:16px;background:var(--slot);color:#fff;overflow:hidden;cursor:pointer;-webkit-tap-highlight-color:transparent}
.shuffle-slot{perspective:500px;text-align:left}.shuffle-card{position:absolute;inset:1px;padding:13px 14px;border-radius:15px;background:var(--blue);color:#111;transform-origin:50% 100%;transition:transform .55s var(--ease),opacity .25s}.shuffle-card.alt{background:var(--violet);transform:translateY(110%) rotateX(-35deg);opacity:0}.shuffle-slot.swapped .shuffle-card{transform:translateY(-110%) rotateX(40deg);opacity:0}.shuffle-slot.swapped .shuffle-card.alt{transform:none;opacity:1}.shuffle-card small{display:block;font:8px var(--mono);letter-spacing:.08em;text-transform:uppercase;opacity:.55}.shuffle-card b{position:absolute;left:14px;bottom:14px;font-size:18px;letter-spacing:-.045em}.shuffle-notch{position:absolute;right:12px;top:12px;width:8px;height:8px;border-radius:2px;background:#111;box-shadow:0 12px #1118}
.plane-slot{display:grid;place-items:center}.plane-stage{position:relative;width:48px;height:48px}.plane-icon{position:absolute;left:7px;top:5px;width:34px;height:30px;overflow:visible;transform-origin:50% 65%;will-change:transform,opacity}.plane-body{fill:white}.plane-fold{fill:none;stroke:#242424;stroke-width:1.2;stroke-linecap:round;stroke-linejoin:round}.plane-shadow{position:absolute;left:13px;right:13px;bottom:6px;height:5px;border-radius:50%;background:#0009;filter:blur(2px);will-change:transform,opacity}
    .slot-row{display:grid;grid-template-columns:5fr 1fr 1fr;gap:6px;height:78px;min-width:0}
    .mode-area{position:relative;min-width:0}
    .mode-group{position:absolute;inset:0;display:grid;grid-template-columns:2fr 2fr 1fr;gap:6px;transition:opacity .26s ease,transform .42s var(--ease)}
    .mode-group[data-when="hero"]{grid-template-columns:1fr}
    .toolbar-shell[data-mode="hero"] .mode-group[data-when="index"]{opacity:0;transform:translateY(10px) scale(.97);pointer-events:none}
    .toolbar-shell[data-mode="index"] .mode-group[data-when="hero"]{opacity:0;transform:translateY(-10px) scale(.97);pointer-events:none}
    .mode-group>*{min-width:0}
    .slot-row>*{min-width:0}
    .identity-row .slot{width:100%;height:100%;border-radius:14px}
    .span-1{grid-column:span 1}.span-2{grid-column:span 2}
    .widget{position:relative;display:flex;min-width:0;align-items:center;padding:10px 12px;overflow:hidden;border-radius:14px;background:#242424}
    .widget small{display:block;color:#8b8b8b;font:8px var(--mono);letter-spacing:.06em;text-transform:uppercase}
    .widget b{display:block;margin-top:4px;overflow:hidden;font-size:12px;text-overflow:ellipsis;white-space:nowrap}
    .widget.color{color:#111}.widget.color small{color:#526246}.widget.blue{background:var(--blue)}
    .span-5{grid-column:span 5}
    /* due modalità: sulla hero il curriculum, più in basso l'indice delle sezioni */
    .cv-slot{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 16px;border:0;border-radius:14px;background:var(--acid);color:#111;cursor:pointer;text-align:left;font:inherit}
    .cv-slot small{display:block;color:#526246;font:8px var(--mono);letter-spacing:.06em;text-transform:uppercase}
    .cv-slot b{display:block;margin-top:4px;overflow:hidden;font-size:15px;letter-spacing:-.03em;text-overflow:ellipsis;white-space:nowrap}
    .cv-slot .corto{display:none}
    .cv-slot i{display:grid;flex:none;width:34px;height:34px;place-items:center;border-radius:50%;background:#11111a14;font-style:normal;font-size:15px;transition:transform .3s var(--ease)}
    .cv-slot:hover i{transform:translateY(3px)}
    .top-slot{position:relative;display:grid;align-content:center;justify-items:center;border:0;border-radius:14px;background:#242424;color:#fff;cursor:pointer;font:inherit;transition:background .2s ease}
    .top-slot:hover{background:#2f2f2f}
    /* chevron largo e basso invece di una freccia lunga */
    .top-chevron{width:26px;height:13px;margin-bottom:16px;transition:transform .3s var(--ease)}
    .top-chevron path{fill:none;stroke:currentColor;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}
    .top-slot:hover .top-chevron{transform:translateY(-3px)}
    .top-slot small,.plane-slot small{position:absolute;z-index:2;left:0;right:0;bottom:15px;color:#8f8f8f;font:7px var(--mono);letter-spacing:.09em;text-transform:uppercase;text-align:center;white-space:nowrap}
    /* la didascalia sta davanti: l'aereo le vola dietro invece che sopra */
    .plane-slot .plane-stage{z-index:1;margin-bottom:17px}
    .widget[data-detail]>div{transition:opacity .16s ease,transform .22s var(--ease)}
    .widget[data-detail][data-swap="true"]>div{opacity:0;transform:translateY(-5px)}
    .priority:after{content:'P1';position:absolute;right:7px;top:6px;color:#466033;font:6px var(--mono)}
    .shuffle-card b{overflow:hidden;max-width:calc(100% - 26px);text-overflow:ellipsis;white-space:nowrap}
    .shuffle-card[data-pos]{transition:transform .55s var(--ease),opacity .25s}
    .shuffle-card[data-pos="in"]{z-index:2;transform:none;opacity:1}
    .shuffle-card[data-pos="above"]{z-index:1;transform:translateY(-110%) rotateX(40deg);opacity:0}
    .shuffle-card[data-pos="below"]{z-index:0;transform:translateY(110%) rotateX(-35deg);opacity:0}
    .shuffle-index{position:absolute;right:11px;top:50%;display:grid;gap:4px;transform:translateY(-50%)}
    .shuffle-index i{width:6px;height:6px;border-radius:2px;background:#111;opacity:.22;transition:opacity .3s ease,transform .3s ease}
    .shuffle-index i.on{opacity:1;transform:scale(1.3)}
    .toggle-square{justify-content:center;padding:1px;background:transparent}
    .segmented{position:relative;display:grid;width:100%;height:100%;grid-template-rows:1fr 1fr;gap:1px}
    .segment-bed{position:absolute;z-index:0;inset:0 0 auto;height:calc(50% - .5px);border-radius:13px;background:#242424}.segment-bed.bottom{inset:auto 0 0}
    .segmented:before{content:'';position:absolute;z-index:2;inset:0 0 auto;height:calc(50% - .5px);border-radius:13px;background:#fff;pointer-events:none;transition:transform .42s cubic-bezier(.22,1,.36,1)}
    .segmented[data-active="1"]:before{transform:translateY(calc(100% + 1px))}
    .segmented a{position:relative;z-index:3;display:grid;min-width:0;padding:0;place-items:center;border:0;border-radius:13px;background:transparent;color:#888;font:7px var(--mono);text-align:center;text-decoration:none;cursor:pointer;transition:color .22s ease}
    .segmented[data-active="0"] a:first-of-type,.segmented[data-active="1"] a:last-of-type{color:#111}
    .panel-identity{display:grid;gap:7px;margin:2px 6px 13px}
    .panel-lingue{display:none}
    .panel-identity .identity-name{margin:0}
    @media(max-width:620px){
      .slot-row{grid-template-columns:repeat(4,minmax(0,1fr));height:66px}
      .slot-row{grid-template-columns:2fr 1fr}.toggle-square{display:none}
      /* nome e lingue sulla stessa riga e sugli stessi bordi delle schede sotto */
      .panel-identity{grid-template-columns:minmax(0,1fr) auto;align-items:center;margin-right:0;margin-left:0}
      .panel-identity .ticker{grid-column:1/-1}
      .panel-lingue{display:flex;grid-row:1;grid-column:2;align-self:center;gap:4px;padding:3px;border-radius:14px;background:#242424}
      .panel-lingue a{display:grid;place-items:center;width:38px;height:32px;border-radius:11px;color:#8b8b8b;font:9px var(--mono);text-decoration:none;transition:background-color .22s ease,color .22s ease}
      .panel-lingue a[aria-current]{background:#fff;color:#111}
      .mode-group{grid-template-columns:1fr}.mode-group [data-detail],.mode-group .top-slot{display:none}.cv-slot{padding:9px 11px;gap:8px}.cv-slot b{font-size:13px}.cv-slot i{width:26px;height:26px;font-size:13px}.cv-slot .lungo{display:none}.cv-slot .corto{display:inline}
      /* la carta rimpicciolisce per stare in due colonne senza troncare il nome della sezione */
      .shuffle-card{padding:9px 10px}.shuffle-card b{left:10px;bottom:10px;font-size:15px;letter-spacing:-.04em}
      .shuffle-index{right:8px;gap:3px}.shuffle-index i{width:5px;height:5px}
    }
    @media(prefers-reduced-motion:reduce){.segmented:before{transition:none}}
    @media(prefers-reduced-motion:reduce){.toolbar-shell,.nav-panel,.menu-icon i{transition:none}.ticker-track{animation:none}}
</style>

<!-- portato dal prototipo: JS puro, non processato -->
<script is:inline>
// La barra sopravvive alle navigazioni (transition:persist), quindi la sua animazione di
// apertura e chiusura continua mentre il contenuto dietro viene sostituito. Di conseguenza il
// montaggio è in due fasi: ciò che si lega alla barra si lega una volta sola, ciò che dipende
// dalla pagina si rimonta a ogni `astro:page-load`.

const FRAMES_AEREO = [
  {offset:0,transform:'translate3d(0,0,0) rotate(0deg) scale(1)',opacity:1},
  {offset:.073,transform:'translate3d(.55px,-.3px,0) rotate(-.05deg) scale(.997)',opacity:1},
  {offset:.146,transform:'translate3d(3px,-1.7px,0) rotate(-.3deg) scale(.983)',opacity:1},
  {offset:.219,transform:'translate3d(8.4px,-4.7px,0) rotate(-.8deg) scale(.953)',opacity:1},
  {offset:.292,transform:'translate3d(17.2px,-9.6px,0) rotate(-1.6deg) scale(.904)',opacity:1},
  {offset:.364,transform:'translate3d(29.8px,-16.6px,0) rotate(-2.8deg) scale(.834)',opacity:1},
  {offset:.425,transform:'translate3d(44px,-24.5px,0) rotate(-4.1deg) scale(.756)',opacity:1},
  {offset:.462,transform:'translate3d(54px,-30px,0) rotate(-5deg) scale(.7)',opacity:0},
  {offset:.565,transform:'translate3d(-54px,31px,0) rotate(-4.5deg) scale(.68)',opacity:0},
  {offset:.59,transform:'translate3d(-50px,28px,0) rotate(-4deg) scale(.72)',opacity:1},
  {offset:.68,transform:'translate3d(-30px,17px,0) rotate(-3deg) scale(.82)',opacity:1},
  {offset:.8,transform:'translate3d(-13px,7px,0) rotate(-1.5deg) scale(.92)',opacity:1},
  {offset:.91,transform:'translate3d(-4px,2px,0) rotate(-.5deg) scale(.98)',opacity:1},
  {offset:1,transform:'translate3d(0,0,0) rotate(0deg) scale(1)',opacity:1}
]
const FRAMES_OMBRA = [
  {offset:0,transform:'translate(0,0) scale(1)',opacity:.65},
  {offset:.073,transform:'translate(-.15px,.05px) scaleX(1.01) scaleY(.995)',opacity:.645},
  {offset:.146,transform:'translate(-.8px,.3px) scaleX(1.03) scaleY(.97)',opacity:.62},
  {offset:.219,transform:'translate(-2px,.8px) scaleX(1.08) scaleY(.9)',opacity:.57},
  {offset:.292,transform:'translate(-4px,1.5px) scaleX(1.16) scaleY(.79)',opacity:.49},
  {offset:.364,transform:'translate(-7.5px,2.8px) scaleX(1.32) scaleY(.59)',opacity:.34},
  {offset:.425,transform:'translate(-11px,4px) scaleX(1.5) scaleY(.4)',opacity:.16},
  {offset:.462,transform:'translate(-14px,5px) scaleX(1.65) scaleY(.28)',opacity:0},
  {offset:.8,transform:'translate(-8px,3px) scaleX(1.4) scaleY(.5)',opacity:.08},
  {offset:.91,transform:'translate(-3px,1px) scaleX(1.15) scaleY(.8)',opacity:.38},
  {offset:1,transform:'translate(0,0) scale(1)',opacity:.65}
]

const ACCENTI = ['var(--blue)', 'var(--violet)', 'var(--acid)', 'var(--orange)']

/** Si lega una volta sola: questi nodi sopravvivono a ogni navigazione. */
function legaBarra(shell) {
  if (shell.dataset.legata === 'true') return
  shell.dataset.legata = 'true'

  const toggle = shell.querySelector('#menu-toggle')
  const apri = aperta => {
    shell.classList.toggle('open', aperta)
    toggle.setAttribute('aria-expanded', String(aperta))
    toggle.setAttribute('aria-label', aperta ? 'Chiudi menu' : 'Apri menu')
  }
  shell.__apri = apri
  toggle.addEventListener('click', () => apri(!shell.classList.contains('open')))
  document.addEventListener('keydown', evento => { if (evento.key === 'Escape') apri(false) })
  document.addEventListener('pointerdown', evento => {
    if (shell.classList.contains('open') && !shell.contains(evento.target)) apri(false)
  })

  // La voce di menu è un link vero: non lo blocchiamo. Chiudere qui non funzionerebbe: spostare
  // un nodo nel documento nuovo annulla le transizioni in corso, e la chiusura verrebbe troncata.
  // Quindi la barra resta aperta durante lo scambio e si chiude dopo, sul contenuto già nuovo.
  shell.querySelectorAll('.nav-item').forEach(voce => voce.addEventListener('click', () => {
    shell.style.setProperty('--active-highlight', getComputedStyle(voce).getPropertyValue('--highlight'))
    shell.__chiudiDopo = true
  }))

  // macchina 05: volo dell'aereo, identico al motion playground
  shell.querySelectorAll('.plane-slot').forEach(bottone => bottone.addEventListener('click', () => {
    bottone.planeFlight?.cancel(); bottone.planeShadowMotion?.cancel()
    bottone.dataset.phase = 'sending'; bottone.setAttribute('aria-label', bottone.dataset.labelSending ?? 'Sending email')
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      bottone.dataset.phase = 'sent'; bottone.setAttribute('aria-label', bottone.dataset.labelSent ?? 'Email sent'); return
    }
    const aereo = bottone.querySelector('.plane-icon'), ombra = bottone.querySelector('.plane-shadow')
    const volo = aereo.animate(FRAMES_AEREO, { duration: 1350, fill: 'none', easing: 'linear' })
    const moto = ombra.animate(FRAMES_OMBRA, { duration: 1350, fill: 'none', easing: 'linear' })
    bottone.planeFlight = volo; bottone.planeShadowMotion = moto
    volo.finished.then(() => {
      if (bottone.planeFlight === volo) { bottone.dataset.phase = 'sent'; bottone.setAttribute('aria-label', bottone.dataset.labelSent ?? 'Email sent') }
    }).catch(() => {})
  }))

  shell.querySelector('[data-top]')?.addEventListener('click', () => {
    shell.__blocco = Date.now() + 1200
    shell.dataset.mode = 'hero'
    window.scrollTo({ top: 0 })
  })
}

/** Si rimonta a ogni pagina: le sezioni, e quindi il mazzo e il dettaglio, cambiano. */
function montaIndice(shell) {
  const dati = document.querySelector('#lab-sections')
  const sezioni = dati ? JSON.parse(dati.textContent) : []
  const bersagli = [...document.querySelectorAll('.home-section')]
  const carta = shell.querySelector('.shuffle-slot')
  const dettaglio = shell.querySelector('[data-detail]')
  if (!carta || sezioni.length === 0) return

  // i listener della pagina precedente vanno sciolti: la barra è la stessa, la pagina no
  shell.__perPagina?.abort()
  shell.__spia?.disconnect()
  const perPagina = new AbortController()
  shell.__perPagina = perPagina
  const { signal } = perPagina

  // Arrivando su una pagina nuova la barra deve TROVARSI già in modalità hero, non animarsi
  // fin lì: altrimenti il mazzo viene ricostruito mentre l'indice è ancora visibile e si
  // vedono comparire le carte della pagina nuova un istante prima che il gruppo sfumi.
  // Il passaggio animato ha senso solo scorrendo dentro una pagina.
  if (shell.dataset.mode !== 'hero') {
    const gruppi = [...shell.querySelectorAll('.mode-group')]
    gruppi.forEach(gruppo => { gruppo.style.transition = 'none' })
    shell.dataset.mode = 'hero'
    void shell.offsetWidth
    requestAnimationFrame(() => gruppi.forEach(gruppo => { gruppo.style.transition = '' }))
  }

  // arrivati da una voce di menu: ora che il contenuto è quello nuovo, la barra si richiude
  if (shell.__chiudiDopo) {
    shell.__chiudiDopo = false
    requestAnimationFrame(() => shell.__apri?.(false))
  }

  // la rotta attiva la decide l'indirizzo, perché il menu sopravvive alla navigazione
  const percorso = location.pathname
  shell.querySelectorAll('.nav-item').forEach(voce => {
    const attiva = voce.getAttribute('href') === percorso
    voce.classList.toggle('active', attiva)
    if (attiva) {
      shell.querySelector('#active-route').textContent = voce.dataset.page
      shell.style.setProperty('--active-highlight', getComputedStyle(voce).getPropertyValue('--highlight'))
    }
  })

  // una carta per sezione, ognuna con la sua identità
  carta.innerHTML = sezioni.map((sezione, i) => `
    <span class="shuffle-card" data-section="${i}" data-pos="${i === 0 ? 'in' : 'below'}" style="background:${ACCENTI[i % ACCENTI.length]}">
      <small>${sezione.kicker}</small><b>${sezione.value}</b>
      <i class="shuffle-index" aria-hidden="true">${sezioni.map((_, j) => `<i class="${j === i ? 'on' : ''}"></i>`).join('')}</i>
    </span>`).join('')
  const carte = [...carta.querySelectorAll('.shuffle-card')]
  let indice = 0, precedente = null
  shell.__blocco = 0

  const parcheggia = (nodo, posizione) => {
    nodo.style.transition = 'none'
    nodo.dataset.pos = posizione
    void nodo.offsetWidth
    nodo.style.transition = ''
  }
  // il verso segue il movimento: in avanti la carta esce in alto, all'indietro esce in basso
  const disponi = verso => {
    const entra = verso > 0 ? 'below' : 'above'
    const esce = verso > 0 ? 'above' : 'below'
    carte.forEach((nodo, i) => { if (i !== indice && i !== precedente) parcheggia(nodo, entra) })
    if (carte[indice].dataset.pos !== entra) parcheggia(carte[indice], entra)
    requestAnimationFrame(() => {
      carte[indice].dataset.pos = 'in'
      if (precedente !== null && precedente !== indice) carte[precedente].dataset.pos = esce
    })
  }

  let attesa
  const scriviDettaglio = a => {
    const voce = sezioni[a]?.detail
    if (!dettaglio || !voce) return
    dettaglio.querySelector('small').textContent = voce.kicker
    dettaglio.querySelector('b').textContent = voce.value
  }
  const cambiaDettaglio = a => {
    if (!dettaglio || !sezioni[a]?.detail) return
    dettaglio.dataset.swap = 'true'
    clearTimeout(attesa)
    attesa = setTimeout(() => { scriviDettaglio(a); dettaglio.dataset.swap = 'false' }, 170)
  }
  scriviDettaglio(0)

  const mostra = (a, verso) => {
    if (a === indice) return
    const direzione = verso ?? (a > indice ? 1 : -1)
    precedente = indice
    indice = a
    disponi(direzione)
    cambiaDettaglio(a)
    carta.setAttribute('aria-label', `${sezioni[indice].kicker}: ${sezioni[indice].value}`)
  }
  carta.setAttribute('aria-label', `${sezioni[0].kicker}: ${sezioni[0].value}`)

  carta.addEventListener('click', () => {
    const prossima = (indice + 1) % carte.length
    mostra(prossima, 1)
    shell.dataset.mode = 'index'
    // lo scroll programmato attraversa le sezioni intermedie: senza questa pausa
    // l'osservatore farebbe sfogliare il mazzo lungo il tragitto
    shell.__blocco = Date.now() + 1200
    bersagli[prossima + 1]?.scrollIntoView({ block: 'start' })
  }, { signal })

  // la carta segue lo scroll, non solo il contrario
  if (bersagli.length) {
    const quote = new Map()
    const spia = new IntersectionObserver(voci => {
      voci.forEach(voce => quote.set(voce.target, voce.intersectionRatio))
      if (Date.now() < shell.__blocco) return
      let migliore = null, massimo = 0
      quote.forEach((quota, nodo) => { if (quota > massimo) { massimo = quota; migliore = nodo } })
      if (!migliore || massimo <= 0.25) return
      const a = Number(migliore.dataset.section)
      shell.dataset.mode = a === 0 ? 'hero' : 'index'
      if (a > 0) mostra(a - 1)
    }, { threshold: [0, 0.25, 0.5, 0.75, 1] })
    bersagli.forEach(bersaglio => spia.observe(bersaglio))
    shell.__spia = spia
  }
}

function montaBarraSperimentale() {
  const shell = document.querySelector('.toolbar-shell')
  if (!shell) return
  legaBarra(shell)
  montaIndice(shell)
}

if (!window.__barraSperimentale) {
  window.__barraSperimentale = true
  document.addEventListener('astro:page-load', montaBarraSperimentale)
}
</script>
