---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getFeaturedProjects, getPublishedPosts } from '../../lib/content';
import { getPortfolioContent } from '../../lib/portfolio';
import { siteConfig } from '../../config/site';
import { labPaths, labPostPath, labProjectPath, type LabLocale } from './chrome';

interface Props { lang: LabLocale }
const { lang } = Astro.props;
const isIt = lang === 'it';
const { projects, posts } = await getPortfolioContent();
const featured = getFeaturedProjects(projects, lang);
const published = getPublishedPosts(posts, lang);
const inArchivio = projects.filter((p) => p.locale === lang && !p.draft);
const conta = (n: number, uno: string, molti: string) => `${n} ${n === 1 ? uno : molti}`;

const t = isIt
	? { title: 'Banco di prova — nuova home', kicker: 'Sezione', headline: 'Software engineer,', em: 'Swift e sistemi affidabili.',
		intro: 'Progetto e costruisco prodotti iOS in cui la logica regge quanto l’interfaccia. Questa barra è il prototipo del menu: naviga la pagina e racconta dove sei.',
		hint: 'Scorri, oppure usa la barra',
		work: 'Lavoro', workText: 'I progetti selezionati, con il ragionamento che c’è dietro invece della sola schermata finale.', allWork: 'Tutti i progetti →',
		writing: 'Scrittura', writingText: 'Note tecniche su ciò che ho dovuto capire davvero: sistemi, vincoli, errori utili.', allWriting: 'Tutti gli articoli →',
		path: 'Percorso', pathText: 'Come ci sono arrivato — gli strumenti, le persone e i problemi che mi hanno formato.', aboutLink: 'Chi sono →',
		contact: 'Contatto', contactText: 'Aperto a opportunità. Risposta entro 24 ore, fuso orario italiano.', mail: 'Scrivimi →',
		projects: 'Progetti', articles: 'Articoli', experience: 'Esperienza', years: '4 anni', reply: 'Risposta', within: 'Entro 24 ore',
		one: 'pubblicato', many: 'pubblicati' }
	: { title: 'Experiment — new home', kicker: 'Section', headline: 'Software engineer,', em: 'Swift and reliable systems.',
		intro: 'I design and build iOS products where the logic holds up as well as the interface. This bar is the menu prototype: it navigates the page and tells you where you are.',
		hint: 'Scroll, or use the bar',
		work: 'Work', workText: 'Selected projects, with the reasoning behind them rather than the final screen alone.', allWork: 'All projects →',
		writing: 'Writing', writingText: 'Technical notes on what I actually had to understand: systems, constraints, useful mistakes.', allWriting: 'All articles →',
		path: 'Path', pathText: 'How I got here — the tools, the people and the problems that shaped me.', aboutLink: 'About me →',
		contact: 'Contact', contactText: 'Open to opportunities. Reply within 24 hours, Italian time zone.', mail: 'Email me →',
		projects: 'Projects', articles: 'Articles', experience: 'Experience', years: '4 years', reply: 'Reply', within: 'Within 24 hours',
		one: 'published', many: 'published' };

const sezioni = [
	{ kicker: t.kicker, value: t.work, detail: { kicker: t.projects, value: conta(inArchivio.length, t.one, t.many) } },
	{ kicker: t.kicker, value: t.writing, detail: { kicker: t.articles, value: conta(published.length, t.one, t.many) } },
	{ kicker: t.kicker, value: t.path, detail: { kicker: t.experience, value: t.years } },
	{ kicker: t.kicker, value: t.contact, detail: { kicker: t.reply, value: t.within } },
];
---

<ExperimentLayout lang={lang} title={t.title} currentHref={labPaths[lang].home} sections={sezioni}
	itHref={labPaths.it.home} enHref={labPaths.en.home}>
	<header class="home-section hero" id="inizio" data-section="0">
		<span class="section-kicker">{siteConfig.name}</span>
		<h1>{t.headline} <em>{t.em}</em></h1>
		<p>{t.intro}</p>
		<span class="hero-hint" aria-hidden="true">{t.hint}</span>
		<i class="section-rule" aria-hidden="true"></i>
	</header>

	<section class="home-section" id="lavoro" data-section="1">
		<span class="section-kicker">{t.kicker} 01</span>
		<h1>{t.work}</h1>
		<p>{t.workText}</p>
		<ul class="elenco">
			{featured.map((project) => (
				<li><a href={labProjectPath(lang, project.slug)}><strong>{project.title}</strong><span>{project.excerpt}</span></a></li>
			))}
		</ul>
		<a class="collegamento" href={labPaths[lang].work}>{t.allWork}</a>
		<i class="section-rule" aria-hidden="true"></i>
	</section>

	<section class="home-section" id="scrittura" data-section="2">
		<span class="section-kicker">{t.kicker} 02</span>
		<h1>{t.writing}</h1>
		<p>{t.writingText}</p>
		<ul class="elenco">
			{published.slice(0, 3).map((post) => (
				<li><a href={labPostPath(lang, post.slug)}><strong>{post.title}</strong><span>{post.excerpt}</span></a></li>
			))}
		</ul>
		<a class="collegamento" href={labPaths[lang].writing}>{t.allWriting}</a>
		<i class="section-rule" aria-hidden="true"></i>
	</section>

	<section class="home-section" id="percorso" data-section="3">
		<span class="section-kicker">{t.kicker} 03</span>
		<h1>{t.path}</h1>
		<p>{t.pathText}</p>
		<a class="collegamento" href={labPaths[lang].about}>{t.aboutLink}</a>
		<i class="section-rule" aria-hidden="true"></i>
	</section>

	<section class="home-section" id="contatto" data-section="4">
		<span class="section-kicker">{t.kicker} 04</span>
		<h1>{t.contact}</h1>
		<p>{t.contactText}</p>
		<a class="collegamento" href={`mailto:${siteConfig.email}`}>{t.mail}</a>
		<i class="section-rule" aria-hidden="true"></i>
	</section>
</ExperimentLayout>
