---
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import LabProjects from './LabProjects.astro';
import '../../styles/lab-home-chapters.css';
import { getFeaturedProjects, getPublishedPosts } from '../../lib/content';
import { getPortfolioContent } from '../../lib/portfolio';
import { siteConfig } from '../../config/site';
import { getLabCopy } from '../../lib/lab-copy';
import { labPaths, labPostPath, labProjectPath, type LabLocale } from './chrome';

interface Props { lang: LabLocale }
const { lang } = Astro.props;
const { projects, posts } = await getPortfolioContent();
const featured = getFeaturedProjects(projects, lang);
const published = getPublishedPosts(posts, lang);
const inArchivio = projects.filter((p) => p.locale === lang && !p.draft);
const dataBreve = (quando: Date) => quando.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { year: 'numeric', month: 'short' });
const conta = (n: number, uno: string, molti: string) => `${n} ${n === 1 ? uno : molti}`;

const copy = await getLabCopy(lang);
const parole = copy.home.headline.replace(/[,.]$/, '').split(/\s+/);
const meta = Math.ceil(parole.length / 2);
const parola = { prima: parole.slice(0, meta).join(' '), seconda: parole.slice(meta).join(' ') };
const anni = inArchivio.map((p) => p.year);
const arco = anni.length && Math.min(...anni) !== Math.max(...anni)
	? `’${String(Math.min(...anni)).slice(2)}—’${String(Math.max(...anni)).slice(2)}`
	: `’${String(anni[0] ?? new Date().getFullYear()).slice(2)}`;
const t = { ...copy.home, kicker: copy.common.section, em: copy.home.emphasis,
	one: copy.common.one, many: copy.common.many };

const sezioni = [
	{ kicker: t.kicker, value: t.work, detail: { kicker: t.projects, value: conta(inArchivio.length, t.one, t.many) } },
	{ kicker: t.kicker, value: t.writing, detail: { kicker: t.articles, value: conta(published.length, t.one, t.many) } },
	{ kicker: t.kicker, value: t.path, detail: { kicker: t.experience, value: t.years } },
];
---

<ExperimentLayout lang={lang} title={t.title} currentHref={labPaths[lang].home} sections={sezioni}
	itHref={labPaths.it.home} enHref={labPaths.en.home}>
	<header class="home-section hero" id="inizio" data-section="0">
		<div class="hero-meta">
			<span class="mascherina"><span class="section-kicker">{siteConfig.name}</span></span>
			<span class="mascherina"><span class="section-kicker">{siteConfig.role}</span></span>
		</div>

		<p class="hero-intro"><span class="mascherina"><span>{t.intro}</span></span></p>

		<h1 class="hero-marchio">
			<span class="mascherina"><span class="marchio-riga">{parola.prima}</span></span>
			<span class="mascherina"><span class="marchio-riga">{parola.seconda}</span></span>
		</h1>

	</header>

	<LabProjects lang={lang} projects={featured} total={inArchivio.length} years={arco} copy={copy} />

	<!-- 02 · Scrittura: le note che si impilano scorrendo -->
	<section class="home-section home-chapter chapter-writing scene" data-scene="writing" aria-labelledby="scrittura-title" id="scrittura" data-section="2">
		<div class="sezione-testo chapter-opening">
			<h2 id="scrittura-title"><span>{t.writing}</span></h2>
			<p>{t.writingText}</p>
			<a class="collegamento" href={labPaths[lang].writing}>{t.allWriting}</a>
			<span class="ventaglio ventaglio-fogli chapter-ventaglio" aria-hidden="true"><i></i><i></i><i></i></span>
		</div>
		<ol class="pila chapter-pages" role="list">
			{published.slice(0, 4).map((post, index) => (
				<li class="pila-foglio" style={`--i: ${index}`}>
					<a href={labPostPath(lang, post.slug)} class="scheda nota">
						<span class="nota-filigrana" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
						<span class="scheda-kicker"><span>{lang === 'it' ? 'Nota' : 'Note'} / {String(index + 1).padStart(2, '0')}</span><span>{dataBreve(post.publishedAt)}</span></span>
						<span class="nota-corpo">
							<h3>{post.title}</h3>
							<span class="nota-estratto">{post.excerpt}</span>
						</span>
						<span class="nota-piede">
							<span class="voce-meta">{post.tags.slice(0, 3).map((tag) => <i>{tag}</i>)}</span>
							<span class="freccia-scambio" aria-hidden="true"><span>↗</span><span>↗</span></span>
						</span>
					</a>
				</li>
			))}
		</ol>
	</section>

	<!-- 03 · Percorso: una rotta che si disegna scorrendo, con le tappe e il sigillo degli anni -->
	<section class="home-section home-chapter chapter-path scene" data-scene="path" aria-labelledby="percorso-title" id="percorso" data-section="3">
		<div class="sezione-testo chapter-opening">
			<h2 id="percorso-title"><span>{t.path}</span></h2>
			<p>{t.pathText}</p>
			<a class="collegamento" href={labPaths[lang].about}>{t.aboutLink}</a>
			<div class="sigillo chapter-sigillo" aria-hidden="true">
				<svg viewBox="0 0 100 100"><defs><path id="percorso-anello" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs><text><textPath href="#percorso-anello" textLength="236" lengthAdjust="spacing">{`${t.experience} — ${t.years} — ${siteConfig.role} — `}</textPath></text></svg>
				<b>{t.years.split(' ')[0]}</b>
			</div>
		</div>
		<ol class="rotta chapter-steps" role="list">
			<span class="rotta-linea" aria-hidden="true"><i></i></span>
			{t.milestones.map((tappa, i) => (
				<li class="tappa">
					<a href={tappa.project ? labProjectPath(lang, tappa.project) : labPaths[lang].about}>
						<span class="tappa-nodo" aria-hidden="true"></span>
						<b class="tappa-numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</b>
						<span class="tappa-testo"><strong>{tappa.label}</strong><em>{tappa.text}</em></span>
						<span class="tappa-dettaglio"><span>{tappa.year}</span><span>{tappa.where}</span></span>
						<i class="step-arrow" aria-hidden="true">↗</i>
					</a>
				</li>
			))}
			<li class="tappa tappa-oggi" aria-hidden="true"><span class="tappa-nodo"></span><b class="tappa-numero">{lang === 'it' ? 'Oggi' : 'Now'}</b><span class="tappa-testo"><strong>{siteConfig.role}</strong></span></li>
		</ol>
	</section>

</ExperimentLayout>

<script>
  // One-shot masked entrances, scoped to these scenes and reset on Astro navigation.
  let cleanupChapters: (() => void) | undefined;
  function initChapters() {
    cleanupChapters?.();
    const scenes = [...document.querySelectorAll<HTMLElement>('.home-chapter')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) {
        entry.target.classList.add('chapter-entered');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.08 });
    if (!reduced.matches) scenes.forEach((scene) => observer.observe(scene));
    const stop = () => {
      observer.disconnect();
      scenes.forEach((scene) => scene.classList.remove('chapter-entered'));
    };
    reduced.addEventListener('change', stop);
    cleanupChapters = () => { stop(); reduced.removeEventListener('change', stop); };
  }
  document.addEventListener('astro:page-load', initChapters);
  document.addEventListener('astro:before-swap', () => cleanupChapters?.());

</script>
