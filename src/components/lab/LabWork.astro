---
/** Archivio progetti: le sezioni sono i tipi di lavoro, così la barra naviga l'archivio. */
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getProjectKinds } from '../../lib/content';
import { getPortfolioContent } from '../../lib/portfolio';
import { labPaths, labProjectPath, type LabLocale } from './chrome';

interface Props { lang: LabLocale }
const { lang } = Astro.props;
const isIt = lang === 'it';
const { projects } = await getPortfolioContent();
const pubblicati = projects.filter((p) => p.locale === lang && !p.draft);
// getProjectKinds restituisce i tipi nell'ordine dei file: qui conta la scala del lavoro
const ordine = ['app', 'package', 'open-source', 'experiment'];
const tipi = getProjectKinds(projects, lang).sort((a, b) => ordine.indexOf(a) - ordine.indexOf(b));

const nomi: Record<string, [string, string]> = {
	app: ['App', 'Apps'],
	package: ['Pacchetti', 'Packages'],
	'open-source': ['Open source', 'Open source'],
	experiment: ['Esperimenti', 'Experiments'],
};
const testi: Record<string, [string, string]> = {
	app: ['Prodotti finiti, con utenti veri e vincoli di rilascio.', 'Finished products, with real users and shipping constraints.'],
	package: ['Codice riusabile, estratto da un problema che si ripeteva.', 'Reusable code, extracted from a problem that kept recurring.'],
	'open-source': ['Contributi a progetti di altri, dove il codice va difeso in pubblico.', 'Contributions to other people’s projects, where the code is defended in public.'],
	experiment: ['Prove che servivano a rispondere a una domanda, non a essere spedite.', 'Probes meant to answer a question, not to ship.'],
};
const scegli = (coppia: [string, string]) => (isIt ? coppia[0] : coppia[1]);
const conta = (n: number) => isIt ? `${n} ${n === 1 ? 'progetto' : 'progetti'}` : `${n} ${n === 1 ? 'project' : 'projects'}`;

const t = isIt
	? { title: 'Banco di prova — archivio progetti', kicker: 'Sezione', eyebrow: 'Archivio', headline: 'Progetti,', em: 'per come sono nati.',
		intro: 'in archivio, divisi per il tipo di lavoro che sono stati: prodotti da rilasciare, codice da riusare, contributi, prove. Usa la barra per saltare da un gruppo all’altro.',
		hint: 'Scorri, oppure usa la barra' }
	: { title: 'Experiment — project archive', kicker: 'Section', eyebrow: 'Archive', headline: 'Projects,', em: 'by how they came about.',
		intro: 'in the archive, grouped by the kind of work they were: products to ship, code to reuse, contributions, probes. Use the bar to jump between groups.',
		hint: 'Scroll, or use the bar' };

const sezioni = tipi.map((tipo) => {
	const dentro = pubblicati.filter((p) => p.kind === tipo);
	return {
		id: tipo,
		kicker: t.kicker,
		value: scegli(nomi[tipo] ?? [tipo, tipo]),
		testo: scegli(testi[tipo] ?? ['', '']),
		progetti: dentro,
		detail: { kicker: scegli(nomi[tipo] ?? [tipo, tipo]), value: conta(dentro.length) },
	};
});
---

<ExperimentLayout lang={lang} title={t.title} currentHref={labPaths[lang].work}
	sections={sezioni.map(({ kicker, value, detail }) => ({ kicker, value, detail }))}
	itHref={labPaths.it.work} enHref={labPaths.en.work}>
	<header class="home-section hero" id="inizio" data-section="0">
		<span class="section-kicker">{t.eyebrow}</span>
		<h1>{t.headline} <em>{t.em}</em></h1>
		<p>{conta(pubblicati.length)} {t.intro}</p>
		<span class="hero-hint" aria-hidden="true">{t.hint}</span>
		<i class="section-rule" aria-hidden="true"></i>
	</header>

	{sezioni.map((sezione, i) => (
		<section class="home-section" id={sezione.id} data-section={i + 1}>
			<span class="section-kicker">{t.kicker} {String(i + 1).padStart(2, '0')}</span>
			<h1>{sezione.value}</h1>
			<p>{sezione.testo}</p>
			<ul class="elenco">
				{sezione.progetti.map((project) => (
					<li><a href={labProjectPath(lang, project.slug)}><strong>{project.title}</strong><span>{project.excerpt}</span></a></li>
				))}
			</ul>
			<i class="section-rule" aria-hidden="true"></i>
		</section>
	))}
</ExperimentLayout>
