---
/** Archivio progetti come bacheca: un tavolo solo, filtrato per tipo, con il primo progetto in evidenza. */
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getProjectKinds } from '../../lib/content';
import { getPortfolioContent } from '../../lib/portfolio';
import { getLabCopy } from '../../lib/lab-copy';
import { labPaths, labProjectPath, type LabLocale } from './chrome';
import LabCover from './LabCover.astro';
import '../../styles/lab-work.css';
import '../../styles/lab-tavolo.css';

interface Props { lang: LabLocale }
const { lang } = Astro.props;
const it = lang === 'it';
const { projects } = await getPortfolioContent();
const pubblicati = projects
	.filter((p) => p.locale === lang && !p.draft)
	.toSorted((a, b) => (a.featuredRank ?? 99) - (b.featuredRank ?? 99) || b.year - a.year);
// getProjectKinds restituisce i tipi nell'ordine dei file: qui conta la scala del lavoro
const ordine = ['app', 'package', 'open-source', 'experiment'];
const tipi = getProjectKinds(projects, lang).sort((a, b) => ordine.indexOf(a) - ordine.indexOf(b));

const copy = await getLabCopy(lang);
const nome = (tipo: string) => copy.work.kinds[tipo as keyof typeof copy.work.kinds]?.label ?? tipo;
const conta = (n: number) => `${n} ${n === 1 ? copy.work.one : copy.work.many}`;
const due = (n: number) => String(n).padStart(2, '0');
const stato = it ? { verified: 'Verificato', archived: 'Archiviato', prototype: 'Prototipo', 'in-progress': 'In corso' } : { verified: 'Verified', archived: 'Archived', prototype: 'Prototype', 'in-progress': 'In progress' };
const autori = it ? { individual: 'Individuale', team: 'Team', contribution: 'Contributo' } : { individual: 'Individual', team: 'Team', contribution: 'Contribution' };
const anni = pubblicati.map((p) => p.year);
const periodo = `${Math.min(...anni)} — ${Math.max(...anni)}`;

const t = it
	? { topline: 'Samuele Segrini / Archivio', lead: 'Dal problema al software.', intro: 'Applicazioni, sistemi e piccoli esperimenti. Modi diversi di progettare, costruire e capire come funzionano le cose.', tavolo: 'Sul tavolo', filtro: 'Filtra per tipo', tutti: 'Tutti', evidenza: 'In evidenza', cta: 'Dentro il progetto', tecnologie: 'Tecnologie', mostrati: 'Mostrati', salta: 'Vai ai progetti' }
	: { topline: 'Samuele Segrini / Archive', lead: 'From problem to software.', intro: 'Applications, systems and small experiments. Different ways to design, build and understand how things work.', tavolo: 'On the table', filtro: 'Filter by kind', tutti: 'All', evidenza: 'Featured', cta: 'Inside the project', tecnologie: 'Technologies', mostrati: 'Showing', salta: 'Skip to projects' };

const filtri = [
	{ id: 'all', label: t.tutti, n: pubblicati.length },
	...tipi.map((tipo) => ({ id: tipo, label: nome(tipo), n: pubblicati.filter((p) => p.kind === tipo).length })),
];

// la barra indicizza le due tappe della pagina: l'apertura e il tavolo
const sections = [
	{ kicker: copy.common.section, value: copy.work.title, detail: { kicker: periodo, value: conta(pubblicati.length) } },
	{ kicker: copy.common.section, value: t.tavolo, detail: { kicker: t.filtro, value: `${tipi.length} ${it ? 'tipi' : 'kinds'}` } },
];
---

<ExperimentLayout lang={lang} title={copy.work.title} currentHref={labPaths[lang].work}
	sections={sections} itHref={labPaths.it.work} enHref={labPaths.en.work}>
  <a class="work-skip skip-link" href="#tavolo">{t.salta}</a>
  <div class="work-archive">
    <header class="scene work-hero" id="inizio" data-section="0">
      <div class="work-backdrop depth-0" data-depth="0" aria-hidden="true"></div>
      <div class="work-grid depth-2" data-depth="2" aria-hidden="true"></div>
      <div class="work-hero-content depth-4" data-depth="4" data-work-reveal>
        <div class="work-topline"><span>{t.topline}</span><span>{periodo}</span></div>
        <h1>{copy.work.title}<sup>({due(pubblicati.length)})</sup></h1>
        <div class="work-intro"><span>{t.lead}</span><p>{t.intro}</p></div>
      </div>
    </header>
    <section class="scene tavolo" id="tavolo" data-section="1" aria-labelledby="tavolo-titolo">
      <div class="work-backdrop depth-0" data-depth="0" aria-hidden="true"></div>
      <div class="tavolo-testa depth-4" data-depth="4">
        <h2 id="tavolo-titolo">{t.tavolo}<sup data-shown>{due(pubblicati.length)}</sup></h2>
        <!-- senza JavaScript il filtro non servirebbe a niente: lo mostra lo script -->
        <div class="tavolo-filtri" role="group" aria-label={t.filtro} data-filtri hidden>
          {filtri.map((f) => <button type="button" data-kind={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>{f.label}<small>{due(f.n)}</small></button>)}
        </div>
      </div>
      <p class="tavolo-annuncio" aria-live="polite" data-annuncio data-prefisso={t.mostrati} data-uno={copy.work.one} data-molti={copy.work.many}></p>
      <ul class="tavolo-carte depth-4" data-depth="4">
        {pubblicati.map((project, i) => (
          <li class="tavolo-carta" data-kind={project.kind} data-featured={i === 0 ? '' : undefined} data-work-reveal>
            <a class="tavolo-link" href={labProjectPath(lang, project.slug)} aria-labelledby={`tavolo-${project.translationKey}`}>
              <div class="tavolo-art">
                <LabCover src={project.coverImage} alt={project.coverAlt} width={1200} height={800} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 640px" widths={[420, 640, 840]} />
                <span class="tavolo-freccia" aria-hidden="true">↗</span>
              </div>
              <div class="tavolo-copy">
                <div class="tavolo-meta"><span><span class="tavolo-evidenza">{t.evidenza} · </span>{nome(project.kind)}</span><span>{project.year}</span></div>
                <h3 id={`tavolo-${project.translationKey}`}>{project.title}</h3>
                <p class="tavolo-estratto">{project.excerpt}</p>
                <span class="tavolo-stato"><span>{stato[project.lifecycle]} · {autori[project.authorship]}</span><span aria-hidden="true">↗</span></span>
                <span class="tavolo-piede"><span class="tavolo-tech"><span class="tavolo-sr">{t.tecnologie}: </span>{project.technologies.slice(0, 4).join(' · ')}</span><span class="tavolo-cta">{t.cta} <span aria-hidden="true">↗</span></span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script>
    let cleanup: (() => void) | undefined;
    function mountArchive() {
      cleanup?.();
      const root = document.querySelector('.work-archive');
      if (!root) return;
      const media = matchMedia('(prefers-reduced-motion: reduce)');
      const animations = new Set<Animation>();
      const tweens = new Set<{ kill(): void }>();
      const observer = new IntersectionObserver(entries => entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        if (media.matches) return;
        const gsap = (window as unknown as { gsap?: { fromTo(target: Element, from: object, to: object): { kill(): void } } }).gsap;
        if (gsap) {
          const tween = gsap.fromTo(entry.target, { opacity: 0, y: matchMedia('(pointer: coarse)').matches ? 8 : 18 }, {
            opacity: 1, y: 0, duration: .55, ease: 'power2.out', clearProps: 'opacity,transform', onComplete: () => tweens.delete(tween),
          });
          tweens.add(tween);
          return;
        }
        const animation = entry.target.animate([{ opacity: 0, transform: 'translateY(18px)' }, { opacity: 1, transform: 'none' }], { duration: 550, easing: 'cubic-bezier(.2,.7,.2,1)' });
        animations.add(animation);
        animation.finished.catch(() => {}).finally(() => animations.delete(animation));
      }), { threshold: .05 });
      const stop = () => {
        animations.forEach(animation => animation.cancel());
        tweens.forEach(tween => tween.kill());
        root.querySelectorAll<HTMLElement>('[data-work-reveal]').forEach(el => { el.style.removeProperty('opacity'); el.style.removeProperty('transform'); });
      };
      media.addEventListener('change', stop);
      root.querySelectorAll('[data-work-reveal]').forEach(el => observer.observe(el));

      // il filtro: nasconde le carte di altri tipi e mette in evidenza la prima che resta
      const perPagina = new AbortController();
      const filtri = root.querySelector<HTMLElement>('[data-filtri]');
      const carte = [...root.querySelectorAll<HTMLElement>('.tavolo-carta')];
      const annuncio = root.querySelector<HTMLElement>('[data-annuncio]');
      if (filtri) {
        const bottoni = [...filtri.querySelectorAll<HTMLButtonElement>('button[data-kind]')];
        const tipi = new Set(bottoni.map(b => b.dataset.kind));
        const applica = (tipo: string, annuncia: boolean) => {
          let n = 0;
          for (const carta of carte) {
            const dentro = tipo === 'all' || carta.dataset.kind === tipo;
            carta.hidden = !dentro;
            carta.toggleAttribute('data-featured', dentro && n === 0);
            if (dentro) n++;
          }
          bottoni.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.kind === tipo)));
          root.querySelectorAll('[data-shown]').forEach(el => { el.textContent = String(n).padStart(2, '0'); });
          if (annuncio && annuncia) {
            const { prefisso, uno, molti } = annuncio.dataset;
            annuncio.textContent = `${prefisso} ${n} ${n === 1 ? uno : molti}`;
          }
        };
        filtri.hidden = false;
        // un indirizzo con #tipo (anche i vecchi salti alle categorie) apre il tavolo già filtrato
        const iniziale = location.hash.slice(1);
        if (tipi.has(iniziale)) applica(iniziale, false);
        filtri.addEventListener('click', event => {
          const bottone = (event.target as Element).closest<HTMLButtonElement>('button[data-kind]');
          if (!bottone?.dataset.kind) return;
          const tipo = bottone.dataset.kind;
          applica(tipo, true);
          history.replaceState(history.state, '', tipo === 'all' ? location.pathname + location.search : `#${tipo}`);
        }, { signal: perPagina.signal });
      }
      cleanup = () => { observer.disconnect(); stop(); media.removeEventListener('change', stop); perPagina.abort(); };
    }
    mountArchive();
    document.addEventListener('astro:page-load', mountArchive);
    document.addEventListener('astro:before-swap', () => cleanup?.());
  </script>
</ExperimentLayout>
