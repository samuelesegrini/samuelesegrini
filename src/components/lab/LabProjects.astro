---
import type { ProjectEntry } from '../../lib/content';
import type { LabCopy } from '../../lib/lab-copy';
import { labPaths, labProjectPath, type LabLocale } from './chrome';

interface Props {
	lang: LabLocale;
	projects: ProjectEntry[];
	total: number;
	years: string;
	copy: LabCopy;
}

const { lang, projects, total, years, copy } = Astro.props;
const text = lang === 'it'
	? { selected: 'Lavori selezionati', archive: 'Tutti i progetti', preview: 'Anteprima', index: 'Indice', more: 'Progetti, esperimenti, contributi.' }
	: { selected: 'Selected work', archive: 'All projects', preview: 'Preview', index: 'Index', more: 'Projects, experiments, contributions.' };
const explore = lang === 'it' ? 'Esplora il progetto' : 'Explore project';
const count = String(projects.length).padStart(2, '0');
---

<div class="project-journey" data-active="0">
  <div class="vetrina">
    <div class="exhibition-visual exhibition-sticky">
      <div class="hero-media exhibition-screen">
        <div class="hero-media-fill">
          <div class="preview-studies">
            {projects.map((project, index) => (
              <div class="exhibition-scene" data-scene={index} aria-hidden="true">
                <span class="scene-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="scene-crosshair"></span>
                <span class="scene-name" data-caption={index}><i></i><span>{String(index + 1).padStart(2, '0')} / {project.title}</span></span>
                <span class="preview-tags">{project.technologies.slice(0, 3).map((technology) => <span>{technology}</span>)}</span>
              </div>
            ))}
            {projects[0] && <a class="preview-open" href={labProjectPath(lang, projects[0].slug)} aria-label={`${explore}: ${projects[0].title}`} data-explore={explore}><span class="preview-action"><span>{explore}</span><span aria-hidden="true">↗</span></span></a>}
          </div>
        </div>
      </div>
    </div>
  </div>
  <section class="home-section project-gallery" id="progetti" data-section="1" data-active="0" aria-labelledby="projects-heading">
    <div class="projects-column">
      <header class="projects-opening">
        <h2 id="projects-heading">{copy.home.work}<sup>({count})</sup></h2>
        <span>{years}</span>
      </header>
      <ol class="project-index" role="list">
        {projects.map((project, index) => (
          <li class="project-entry" data-project-key={project.translationKey} data-index={index}>
            <div class="entry-kicker"><span>{String(index + 1).padStart(2, '0')}</span><span>{copy.work.kinds[project.kind].label}</span><span>{project.year}</span></div>
            <h3><a class="project-link" href={labProjectPath(lang, project.slug)}><span>{project.title}</span><span class="entry-arrow" aria-hidden="true">↗</span></a></h3>
            <p>{project.excerpt}</p>
            <ul class="entry-technologies" role="list">{project.technologies.slice(0, 3).map((technology) => <li>{technology}</li>)}</ul>
          </li>
        ))}
      </ol>
      <footer class="projects-outro"><a class="projects-archive" href={labPaths[lang].work}><span>{text.archive}<sup>({String(total).padStart(2, '0')})</sup></span><span aria-hidden="true">↗</span></a></footer>
    </div>
  </section>
</div>

<style>
  .project-journey { --tinta: var(--orange); position: relative; }
  .project-journey .vetrina { position: sticky; top: 0; height: 100vh; min-height: 100vh; pointer-events: none; }
  .exhibition-visual { width: 100%; min-width: 0; }
  .project-journey .hero-media { position: relative; }
  .preview-studies { position: absolute; inset: 0; }
  .exhibition-scene { position: absolute; inset: 0; display: grid; place-items: center; background: #dcd8ce; color: #6a685f; clip-path: inset(100% 0 0); transition: clip-path 650ms var(--ease); }
  .exhibition-scene:nth-child(2) { background: #cdd5ce; color: #526358; }
  .exhibition-scene:nth-child(3) { background: #e3cebc; color: #795e49; }
  .scene-number { font-size: clamp(140px, 23vw, 360px); letter-spacing: -.09em; line-height: 1; opacity: .22; }
  .scene-name { position: absolute; top: 24px; left: 24px; right: 24px; display: flex; align-items: center; gap: 9px; color: #383a32; font: 11px/1.5 var(--mono); letter-spacing: .04em; opacity: 0; transform: translateY(12px); transition: opacity 650ms var(--ease), transform 650ms var(--ease); }
  .scene-name i { width: 6px; height: 6px; flex: none; border-radius: 50%; background: currentColor; }
  .preview-tags { position: absolute; bottom: 24px; left: 24px; right: 24px; display: flex; flex-wrap: wrap; gap: 6px; padding-right: 180px; opacity: 0; transform: translateY(12px); transition: opacity 650ms var(--ease), transform 650ms var(--ease); }
  .preview-tags > span { padding: 7px 10px; border-radius: 10px; background: #f4f2eac9; color: #383a32; font: 10px/1.4 var(--mono); }
  .preview-open { position: absolute; inset: 0; z-index: 3; border-radius: 28px; pointer-events: auto; color: #303229; }
  .preview-open[inert] { pointer-events: none; }
  .preview-open:focus-visible { outline: 3px solid #303229; outline-offset: -6px; }
  .preview-action { position: absolute; right: 24px; bottom: 24px; display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 10px 14px; background: #f4f2ea; border-radius: 12px; font: 11px var(--mono); }
  .preview-action > span:last-child { font-size: 20px; transition: transform 350ms var(--ease); }
  .preview-open:is(:hover, :focus-visible) .preview-action > span:last-child { transform: translate(2px, -2px); }
  .scene-crosshair { position: absolute; width: 22px; height: 22px; opacity: .35; }
  .scene-crosshair:before, .scene-crosshair:after { content: ''; position: absolute; background: currentColor; }
  .scene-crosshair:before { width: 1px; height: 100%; left: 50%; }
  .scene-crosshair:after { height: 1px; width: 100%; top: 50%; }
  .project-journey[data-active='0'] [data-scene='0'], .project-journey[data-active='1'] [data-scene='1'], .project-journey[data-active='2'] [data-scene='2'] { z-index: 1; clip-path: inset(0); }
  .project-journey[data-active='0'] [data-caption='0'], .project-journey[data-active='1'] [data-caption='1'], .project-journey[data-active='2'] [data-caption='2'] { opacity: 1; transform: none; }
  .project-journey[data-active='0'] [data-scene='0'] .preview-tags, .project-journey[data-active='1'] [data-scene='1'] .preview-tags, .project-journey[data-active='2'] [data-scene='2'] .preview-tags { opacity: 1; transform: none; }
  .home-section.project-gallery { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; min-height: 0; margin-top: -100vh; scroll-margin-top: -100vh; padding: calc(100vh + 48px) max(24px, 4vw) max(180px, 25vh); pointer-events: none; }
  .projects-column { width: 38%; margin-left: auto; pointer-events: auto; }
  .projects-opening { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 22px; }
  .projects-opening h2 { margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -.04em; }
  .projects-opening sup { margin-left: 9px; font: 11px var(--mono); }
  .projects-opening > span { font: 10px var(--mono); color: #6b6760; }
  .project-index { display: grid; gap: 14px; list-style: none; margin: 0; padding: 0; }
  .project-entry { position: relative; border-radius: 22px; padding: 26px; background: #e8e5dd; color: #262520; transition: background-color 650ms var(--ease); scroll-margin: 80px 0 160px; }
  .entry-kicker { display: flex; gap: 12px; font: 10px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: #625e55; }
  .entry-kicker > span:first-child { display: flex; align-items: center; gap: 7px; }
  .entry-kicker > span:first-child:before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: 0; transition: opacity 650ms var(--ease); }
  .project-gallery[data-active='0'] [data-index='0'] .entry-kicker > span:first-child:before, .project-gallery[data-active='1'] [data-index='1'] .entry-kicker > span:first-child:before, .project-gallery[data-active='2'] [data-index='2'] .entry-kicker > span:first-child:before { opacity: 1; }
  .entry-kicker > span:last-child { margin-left: auto; }
  .project-entry h3 { margin: 24px 0 14px; font-size: clamp(25px, 2.65vw, 43px); font-weight: 500; line-height: 1.05; letter-spacing: -.065em; }
  .project-link { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; color: inherit; }
  .project-link > span:first-child { overflow-wrap: anywhere; min-width: 0; }
  .entry-arrow { flex: none; font-size: .65em; transition: transform 350ms var(--ease); }
  .project-link:after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .project-link:focus-visible { outline: 2px solid #262520; outline-offset: 6px; }
  .project-link:hover .entry-arrow { transform: translate(3px, -3px); }
  .project-gallery .project-entry p { margin: 0; font-size: 14px; line-height: 1.6; color: #514d45; }
  .entry-technologies { display: flex; flex-wrap: wrap; gap: 6px 12px; list-style: none; margin: 22px 0 0; padding: 0; font: 10px/1.5 var(--mono); color: #625e55; }
  .project-gallery[data-active='0'] [data-index='0'], .project-gallery[data-active='1'] [data-index='1'], .project-gallery[data-active='2'] [data-index='2'] { background: var(--tinta); }
  .projects-outro { margin-top: 24px; }
  .projects-archive { display: flex; justify-content: space-between; gap: 16px; align-items: center; min-height: 48px; font-size: 15px; color: #262520; }
  .projects-archive sup { font: 10px var(--mono); margin-left: 7px; }
  @keyframes dock-preview { from { width: 100%; } to { width: calc(62% - 14px); } }
  @keyframes reveal-studies { from { opacity: 0; } to { opacity: 1; } }
  @keyframes reveal-projects { from { opacity: 0; clip-path: inset(0 0 0 100%); } to { opacity: 1; clip-path: inset(0); } }
  @supports (animation-timeline: scroll()) {
    @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
      /* la fase "prima" di un intervallo che non parte da 0 non riempie sempre indietro:
         il riposo deve già valere come il primo fotogramma, non come l'ultimo */
      .exhibition-visual { animation-name: dock-preview; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root block); animation-range: 100vh 170vh; }
      .preview-studies { opacity: 0; animation-name: reveal-studies; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root block); animation-range: 115vh 170vh; }
      .projects-column { opacity: 0; clip-path: inset(0 0 0 100%); animation-name: reveal-projects; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root block); animation-range: 100vh 170vh; }
    }
  }
  @media (max-width: 1039px) {
    .scene-name { top: 16px; left: 16px; right: 16px; font-size: 10px; }
    .preview-tags { bottom: 16px; left: 16px; right: 16px; padding-right: 52px; }
    .preview-tags > span { padding: 5px 7px; font-size: 9px; }
    .preview-action { right: 16px; bottom: 16px; padding: 8px 12px; }
    .preview-action > span:first-child { display: none; }
  }
  @media (max-width: 767px) {
    .project-journey .vetrina { position: relative; height: auto; min-height: 0; }
    .exhibition-visual { width: 100%; position: static; }
    .home-section.project-gallery { margin-top: 0; scroll-margin-top: 0; padding-top: 12px; }
    .projects-column { width: 100%; }
    .project-entry { padding: 24px; }
    .project-entry h3 { font-size: clamp(28px, 7vw, 40px); }
    .scene-number { font-size: 42vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .exhibition-scene, .scene-name, .preview-tags, .project-entry, .entry-arrow, .entry-kicker > span:first-child:before, .preview-action > span:last-child { transition: none; }
    .preview-open:is(:hover, :focus-visible) .preview-action > span:last-child { transform: none; }
    .home-section.project-gallery { padding-top: 48px; scroll-margin-top: 0; }
    .project-journey .vetrina { position: sticky; }
  }
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) { .project-journey .vetrina { position: relative; } }
</style>

<script>
	let cleanup: (() => void) | undefined;

	function initProjectGallery() {
		cleanup?.();
		const gallery = document.querySelector<HTMLElement>('.project-gallery');
		if (!gallery) return;
		const entries = [...gallery.querySelectorAll<HTMLElement>('.project-entry')];
		const desktop = window.matchMedia('(min-width: 768px)');
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		const journey = gallery.closest<HTMLElement>('.project-journey')!;
		const preview = journey.querySelector<HTMLAnchorElement>('.preview-open');
		const controller = new AbortController();
		const { signal } = controller;
		let hovered: string | undefined;
		let focused: string | undefined;
		let scrolled = '0';
		const update = () => {
      const active = focused ?? hovered ?? scrolled;
      gallery.dataset.active = active;
      journey.dataset.active = active;
      const link = entries[Number(active)]?.querySelector<HTMLAnchorElement>('.project-link');
      if (preview && link) {
        preview.setAttribute('href', link.getAttribute('href')!);
        preview.setAttribute('aria-label', `${preview.dataset.explore}: ${link.firstElementChild?.textContent}`);
      }
    };
    // The surface is decorative until its project content has appeared.
    const syncPreviewAccess = () => {
      if (!preview) return;
      const available = !desktop.matches || reduced.matches || !CSS.supports('animation-timeline: scroll()') || window.scrollY >= innerHeight * 1.7;
      preview.inert = !available;
      preview.tabIndex = available ? 0 : -1;
      preview.setAttribute('aria-hidden', String(!available));
    };
    window.addEventListener('scroll', syncPreviewAccess, { signal, passive: true });
    window.addEventListener('resize', syncPreviewAccess, { signal });
    reduced.addEventListener('change', syncPreviewAccess, { signal });
    preview?.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') { hovered = journey.dataset.active; update(); } }, { signal });
    preview?.addEventListener('pointerleave', () => { scrolled = hovered ?? scrolled; hovered = undefined; update(); }, { signal });
    preview?.addEventListener('focus', () => { focused = journey.dataset.active; update(); }, { signal });
    preview?.addEventListener('blur', () => { scrolled = journey.dataset.active ?? '0'; focused = undefined; update(); }, { signal });
    syncPreviewAccess();
    update();

		for (const entry of entries) {
			entry.addEventListener('pointerenter', (event) => {
				if (event.pointerType === 'mouse') { hovered = entry.dataset.index; scrolled = hovered ?? scrolled; update(); }
			}, { signal });
			entry.addEventListener('pointerleave', () => { scrolled = hovered ?? scrolled; hovered = undefined; update(); }, { signal });
			entry.addEventListener('focusin', () => { hovered = undefined; focused = entry.dataset.index; scrolled = focused ?? scrolled; update(); }, { signal });
			entry.addEventListener('focusout', () => { scrolled = focused ?? scrolled; focused = undefined; update(); }, { signal });
		}

		// Only the shared desktop visual follows the reading position; mobile keeps its opening image.
		const observer = new IntersectionObserver((changes) => {
			if (!desktop.matches) return;
			const entering = changes.filter((change) => change.isIntersecting);
			if (!entering.length) return;
			const closest = entering.sort((a, b) => Math.abs(a.boundingClientRect.top - innerHeight * .4) - Math.abs(b.boundingClientRect.top - innerHeight * .4))[0];
			scrolled = (closest.target as HTMLElement).dataset.index ?? '0';
			update();
		}, { rootMargin: '-35% 0px -45% 0px', threshold: 0 });
		entries.forEach((entry) => observer.observe(entry));
		desktop.addEventListener('change', () => { hovered = undefined; focused = undefined; scrolled = '0'; update(); syncPreviewAccess(); }, { signal });
		cleanup = () => { controller.abort(); observer.disconnect(); };
	}

	initProjectGallery();
	document.addEventListener('astro:page-load', initProjectGallery);
	document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
</script>
