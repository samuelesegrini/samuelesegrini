---
/** Dettaglio progetto: la barra indicizza le parti che il progetto ha davvero. */
import { render } from 'astro:content';
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import { getTranslationPair } from '../../lib/content';
import { getPortfolioContent } from '../../lib/portfolio';
import { getLabCopy } from '../../lib/lab-copy';
import { labPaths, labProjectPath, type LabLocale } from './chrome';

interface Props { lang: LabLocale; slug: string }
const { lang, slug } = Astro.props;
const { projects, projectDocuments } = await getPortfolioContent();
const progetto = projects.find((p) => p.locale === lang && p.slug === slug)!;
const documento = projectDocuments.find((d) => d.data.locale === lang && d.data.slug === slug)!;
const { Content } = await render(documento);

// se la traduzione manca, l'altra lingua porta al suo archivio invece che a una pagina assente
const gemello = (altra: LabLocale) => {
	const pari = getTranslationPair(projects, progetto.translationKey, altra);
	return pari ? labProjectPath(altra, pari.slug) : labPaths[altra].work;
};

const copy = await getLabCopy(lang);
const t = { ...copy.projectDetail, kicker: copy.common.section };

const sezioni = [
	{ id: 'caso', value: t.body, detail: { kicker: t.role, value: progetto.role } },
	...(progetto.outcomes.length ? [{ id: 'risultati', value: t.results, detail: { kicker: t.results, value: String(progetto.outcomes.length) } }] : []),
	{ id: 'tecnologie', value: t.tech, detail: { kicker: t.year, value: String(progetto.year) } },
];
---

<ExperimentLayout lang={lang} title={`${progetto.title} — ${t.eyebrow}`} currentHref={labProjectPath(lang, slug)}
	sections={sezioni.map((s) => ({ kicker: t.kicker, value: s.value, detail: s.detail }))}
	itHref={gemello('it')} enHref={gemello('en')}>
	<header class="home-section hero" id="inizio" data-section="0">
		<span class="section-kicker">{t.eyebrow} · {progetto.year}</span>
		<h1>{progetto.title}</h1>
		<p>{progetto.excerpt}</p>
		<a class="collegamento" href={labPaths[lang].work}>{t.back}</a>
		<i class="section-rule" aria-hidden="true"></i>
	</header>

	<section class="home-section" id="caso" data-section="1">
		<span class="section-kicker">{t.kicker} 01</span>
		<h1>{t.body}</h1>
		<div class="prosa"><Content /></div>
		<i class="section-rule" aria-hidden="true"></i>
	</section>

	{progetto.outcomes.length > 0 && (
		<section class="home-section" id="risultati" data-section="2">
			<span class="section-kicker">{t.kicker} 02</span>
			<h1>{t.results}</h1>
			<ul class="elenco">
				{progetto.outcomes.map((esito) => (
					<li><a href={labPaths[lang].work}><strong>{esito.value}</strong><span>{esito.label ?? ''}</span></a></li>
				))}
			</ul>
			<i class="section-rule" aria-hidden="true"></i>
		</section>
	)}

	<section class="home-section" id="tecnologie" data-section={progetto.outcomes.length ? 3 : 2}>
		<span class="section-kicker">{t.kicker} {progetto.outcomes.length ? '03' : '02'}</span>
		<h1>{t.tech}</h1>
		<p>{progetto.technologies.join(' · ')}</p>
		<i class="section-rule" aria-hidden="true"></i>
	</section>
</ExperimentLayout>
