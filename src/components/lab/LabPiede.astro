---
/**
 * Il piede del banco di prova: la scena che chiude ogni pagina.
 *
 * La carta finisce e sotto c'è il tavolo scuro. L'invito grande a scrivere, poi le
 * quattro pagine appoggiate come carte, ognuna con la tinta della propria sezione.
 * I pezzi visivi (scheda, mazzo, sigillo, freccia-scambio) stanno in
 * lab-primitives.css per tornare nelle sezioni.
 */
import { siteConfig } from '../../config/site';
import { labPaths, mailHref, type LabLocale } from './chrome';
import type { LabCopy } from '../../lib/lab-copy';

interface Props {
	lang: LabLocale;
	copy: LabCopy;
	/** 'liscio' è il tavolo nudo; 'impronta' ci lascia sopra l'orma tratteggiata. */
	variante?: 'liscio' | 'impronta';
}
const { lang, copy, variante = 'liscio' } = Astro.props;
const t = copy.footer;
const percorsi = labPaths[lang];
const tinte = ['var(--paper)', 'var(--orange)', 'var(--violet)', 'var(--acid)'];
const pagine = [percorsi.home, percorsi.work, percorsi.writing, percorsi.about].map((href, i) => ({
	href,
	label: copy.nav[i].label,
	kicker: copy.nav[i].kicker,
	tinta: tinte[i],
}));
const altrove = [
	{ label: 'GitHub', href: siteConfig.github },
	{ label: 'LinkedIn', href: siteConfig.linkedin },
	{ label: 'Email', href: mailHref },
];
const anno = new Date().getFullYear();
const anello = `${siteConfig.name} — ${siteConfig.role} — `;
---

<footer class="scene piede" id="footer" aria-labelledby="piede-titolo" data-scene="contact" data-variante={variante}>
	{variante === 'impronta' && <div class="piede-impronta" aria-hidden="true" />}
	<div class="piede-foglio">

		<div class="piede-gesto">
			<a class="piede-invito" href={mailHref} aria-labelledby="piede-titolo" aria-describedby="piede-indirizzo">
				<span class="piede-apertura">{t.apertura}</span>
				<h2 id="piede-titolo"><span>{t.invito}</span></h2>
				<span class="piede-contatto">
					<span class="piede-mail" id="piede-indirizzo">{siteConfig.email}</span>
					<span class="freccia-scambio piede-freccia" aria-hidden="true"><span>↗</span><span>↗</span></span>
				</span>
				<span class="piede-risposta">{t.risposta}</span>
			</a>
			<div class="sigillo piede-sigillo" aria-hidden="true">
				<svg viewBox="0 0 100 100"><defs><path id="piede-anello" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs><text><textPath href="#piede-anello" textLength="236" lengthAdjust="spacing">{anello}</textPath></text></svg>
				<b>SS</b>
			</div>
		</div>

		<nav class="piede-navigazione" aria-label={t.navigazione}>
			<ul class="mazzo" role="list">{pagine.map((pagina) => (
				<li style={`--tinta: ${pagina.tinta}`}>
					<a class="scheda" href={pagina.href}>
						<span class="scheda-kicker">{pagina.kicker}</span>
						<span class="scheda-titolo">{pagina.label}</span>
						<span class="scheda-freccia" aria-hidden="true">↗</span>
					</a>
				</li>
			))}</ul>
		</nav>

		<div class="piede-dettagli">
			<div class="piede-altrove">
				<span class="piede-etichetta">{t.altrove}</span>
				<ul role="list">{altrove.map((voce) => <li><a href={voce.href} rel="me noopener">{voce.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul>
			</div>
			<div class="piede-colofone">
				<span class="piede-etichetta">{t.colofone}</span>
				<p>{t.fattoCon}<br />{t.caratteri}</p>
			</div>
		</div>

		<div class="piede-chiusura">
			<span>© {anno} {siteConfig.name}</span>
			<span>{t.diritti}</span>
		</div>
	</div>
</footer>

<script>
	// Le carte entrano una alla volta quando il piede arriva in vista. Senza JavaScript, o con
	// movimento ridotto, restano semplicemente al loro posto.
	let smontaPiede: (() => void) | undefined;
	function montaPiede() {
		smontaPiede?.();
		const piede = document.querySelector<HTMLElement>('.piede');
		const mazzo = piede?.querySelector<HTMLElement>('.piede-navigazione');
		if (!piede || !mazzo) return;
		const ridotto = matchMedia('(prefers-reduced-motion: reduce)');
		if (ridotto.matches) return;
		const osservatore = new IntersectionObserver((voci) => {
			if (!voci.some((voce) => voce.isIntersecting)) return;
			piede.dataset.entrato = '';
			osservatore.disconnect();
		}, { threshold: .15 });
		osservatore.observe(mazzo);
		smontaPiede = () => { osservatore.disconnect(); delete piede.dataset.entrato; };
	}
	montaPiede();
	document.addEventListener('astro:page-load', montaPiede);
	document.addEventListener('astro:before-swap', () => smontaPiede?.());
</script>

<style>
	.piede {
		--tinta: var(--blue);
		--inchiostro: #171713;
		--piede-carta: #f4f1e9;
		--piede-tenue: #a9a59b;
		--piede-filo: #3a3b35;
		position: relative;
		isolation: isolate;
		overflow: clip;
		background: var(--inchiostro);
		color: var(--piede-carta);
	}
	.piede a { color: inherit; text-decoration: none; }
	.piede a:focus-visible { outline: 3px solid var(--tinta); outline-offset: 5px; }
	.piede-foglio { display: grid; gap: clamp(48px, 6vw, 88px); padding: clamp(40px, 5vw, 72px) max(24px, 4vw) 174px; }

	/* l'invito: apertura piccola, titolo enorme che sale dalla sua feritoia, indirizzo sotto */
	.piede-gesto { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 32px; }
	.piede .piede-invito { display: grid; gap: 18px; min-width: 0; }
	.piede-apertura { color: var(--piede-tenue); font: 11px var(--mono); letter-spacing: .1em; text-transform: uppercase; }
	.piede-invito h2 { overflow: clip; margin: 0 0 0 -.05em; padding: .02em 0 .12em; font-size: clamp(64px, 12.5vw, 184px); font-weight: 500; letter-spacing: -.08em; line-height: .92; }
	.piede-invito h2 > span { display: block; white-space: nowrap; }
	.piede-risposta { color: var(--piede-tenue); font-size: 14px; }
	.piede-contatto { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 22px; }
	.piede-mail { position: relative; font-size: clamp(18px, 2.4vw, 34px); letter-spacing: -.04em; overflow-wrap: anywhere; }
	.piede-mail::after { content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 2px; background: var(--tinta); transform: scaleX(0); transform-origin: left; transition: transform 600ms var(--ease); }
	.piede-invito:is(:hover, :focus-visible) .piede-mail::after { transform: scaleX(1); }
	.piede-freccia { background: var(--tinta); color: #171713; font-size: clamp(34px, 3.4vw, 52px); }
	.piede-sigillo { --sigillo-misura: clamp(110px, 12vw, 168px); --inchiostro: var(--piede-tenue); --tinta: var(--blue); margin-bottom: 10px; }

	/* le quattro pagine, appoggiate come carte */
	.piede-navigazione .mazzo { --mazzo-colonne: 4; }
	/* le carte sono chiare e tengono l'inchiostro scuro, non quello del piede */
	.piede .scheda { color: var(--inchiostro); }
	.piede .scheda:focus-visible { outline-color: var(--piede-carta); }
	.piede-navigazione .scheda { min-height: clamp(180px, 16vw, 240px); }
	.piede-navigazione .scheda-titolo { font-size: clamp(26px, 2.6vw, 40px); }

	/* le tre colonne di servizio */
	.piede-dettagli { display: grid; grid-template-columns: 1fr 1.3fr; gap: 32px; padding-top: clamp(28px, 4vw, 44px); border-top: 1px solid var(--piede-filo); }
	.piede-etichetta { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; color: var(--piede-tenue); font: 10px var(--mono); letter-spacing: .14em; text-transform: uppercase; }
	.piede-etichetta::before { content: ''; width: 7px; height: 7px; border-radius: 2px; background: var(--tinta); }
	.piede-altrove ul { display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 0; padding: 0; list-style: none; }
	.piede-altrove a { display: inline-flex; align-items: baseline; gap: 6px; min-height: 30px; font-size: 15px; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 6px; transition: text-decoration-color 300ms ease, color 300ms ease; }
	.piede-altrove a:is(:hover, :focus-visible) { color: var(--tinta); text-decoration-color: var(--tinta); }
	.piede-altrove a > span { font-size: 12px; }
	.piede-colofone p { margin: 0; color: var(--piede-tenue); font-size: 14px; line-height: 1.7; }

	/* l'ultima riga sta sopra la barra fissa: il padding del foglio le lascia il posto */
	.piede-chiusura { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; padding-top: 22px; border-top: 1px solid var(--piede-filo); color: var(--piede-tenue); font: 11px/1.5 var(--mono); letter-spacing: .04em; }

	/* l'orma: una sagoma di piede ridotta a puntini, stampata sul tavolo dietro al testo.
	   Tre maschere sovrapposte — la sfumatura che la fa svanire in alto, la griglia di punti,
	   la sagoma stessa — intersecate fra loro: restano solo i punti dentro al piede. */
	.piede-impronta {
		--punto-passo: clamp(7px, .9vw, 11px);
		--punto-raggio: calc(var(--punto-passo) * .17);
		position: absolute;
		right: clamp(16px, 4vw, 84px);
		/* sta sopra la barra fissa: l'orma resta intera, non tagliata dal bordo */
		bottom: 128px;
		z-index: -1;
		/* l'orma vive nella fascia fra il mazzo e la riga di chiusura: oltre quell'altezza
		   le dita finiscono dietro alle carte, che sono opache e se la mangiano */
		height: clamp(230px, 22vw, 320px);
		aspect-ratio: 200 / 430;
		rotate: -13deg;
		background: var(--tinta);
		opacity: .42;
		-webkit-mask-image:
			linear-gradient(to top, #000 40%, rgba(0, 0, 0, .3) 100%),
			radial-gradient(circle, #000 var(--punto-raggio), transparent calc(var(--punto-raggio) + .6px)),
			url('/images/impronta.svg');
		mask-image:
			linear-gradient(to top, #000 40%, rgba(0, 0, 0, .3) 100%),
			radial-gradient(circle, #000 var(--punto-raggio), transparent calc(var(--punto-raggio) + .6px)),
			url('/images/impronta.svg');
		mask-size: 100% 100%, var(--punto-passo) var(--punto-passo), contain;
		mask-repeat: no-repeat, repeat, no-repeat;
		mask-position: center, center, center;
		mask-composite: intersect, intersect, add;
		-webkit-mask-composite: source-in, source-in, source-over;
	}
	/* dove le maschere multiple non reggono, meglio niente che un blocco di colore pieno */
	@supports not (mask-composite: intersect) { .piede-impronta { display: none; } }

	/* ingresso: il titolo sale dalla feritoia mentre il piede entra, le carte una alla volta */
	@keyframes piede-titolo-entra { from { transform: translateY(110%); } to { transform: none; } }
	@keyframes piede-carta-entra { from { opacity: 0; translate: 0 28px; } to { opacity: 1; translate: 0 0; } }
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) and (pointer: fine) {
			.piede-invito h2 > span { animation-name: piede-titolo-entra; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.piede[data-entrato] .mazzo > li { animation: piede-carta-entra 650ms var(--ease) both; animation-delay: calc(var(--i) * 80ms); }
		.mazzo > li:nth-child(1) { --i: 0; } .mazzo > li:nth-child(2) { --i: 1; } .mazzo > li:nth-child(3) { --i: 2; } .mazzo > li:nth-child(4) { --i: 3; }
	}

	@media (max-width: 899px) {
		.piede-gesto { grid-template-columns: minmax(0, 1fr); }
		.piede-sigillo { display: none; }
		.piede-navigazione .mazzo { --mazzo-colonne: 2; gap: 12px; }
		.piede-navigazione .scheda { min-height: 160px; padding: 18px 20px; }
		.piede-navigazione .scheda-titolo { font-size: clamp(22px, 5vw, 30px); }
		.piede-dettagli { grid-template-columns: minmax(0, 1fr); gap: 28px 20px; }
	}
	@media (max-width: 600px) {
		.piede-impronta { right: 4vw; bottom: 172px; height: clamp(190px, 26vh, 260px); opacity: .24; }
		.piede-foglio { gap: 40px; padding-bottom: 150px; }
		.piede-invito h2 { font-size: clamp(44px, 15vw, 88px); }
		.piede-mail { font-size: 16px; }
		.piede-freccia { font-size: 30px; }
		.piede-altrove a { min-height: 36px; }
		.piede-chiusura { font-size: 10px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.piede-mail::after, .piede-altrove a { transition: none; }
	}
</style>
