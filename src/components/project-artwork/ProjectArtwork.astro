---
import EasyManagerServicePulse from './EasyManagerServicePulse.astro';
import GalaxyNetworkArtwork from './GalaxyNetworkArtwork.astro';
import SpinGORouteArtwork from './SpinGORouteArtwork.astro';
import { getFeaturedArtworkTreatment } from '../../lib/project-artwork';

interface Props {
	translationKey?: string;
	lang: 'it' | 'en';
	coverImage?: string;
	coverAlt: string;
	lead: boolean;
	featured: boolean;
	transitionName?: string;
}

const {
	translationKey,
	lang,
	coverImage,
	coverAlt,
	lead,
	featured,
	transitionName,
} = Astro.props;
const treatment = featured
	? getFeaturedArtworkTreatment(translationKey ?? '')
	: undefined;
---

{
	treatment === 'easy-service-pulse' ? (
		<EasyManagerServicePulse lang={lang} transitionName={transitionName} />
	) : treatment === 'galaxy-network' && coverImage ? (
		<GalaxyNetworkArtwork coverImage={coverImage} coverAlt={coverAlt} lead={lead} transitionName={transitionName} />
	) : treatment === 'spingo-route' && coverImage ? (
		<SpinGORouteArtwork coverImage={coverImage} coverAlt={coverAlt} lead={lead} transitionName={transitionName} />
	) : coverImage ? (
		<img
			data-project-artwork
			style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
			class="project-cover"
			src={coverImage}
			alt={coverAlt}
			width="1200"
			height="800"
			loading={lead ? 'eager' : 'lazy'}
		/>
	) : (
		<div class="project-art" data-project-artwork style={transitionName ? `view-transition-name: ${transitionName}` : undefined} aria-hidden="true"><span /><span /><span /></div>
	)
}
