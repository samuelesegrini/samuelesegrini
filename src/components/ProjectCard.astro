---
import ProjectArtwork from './project-artwork/ProjectArtwork.astro';

interface Props {
	rank: number;
	title: string;
	excerpt: string;
	kind: string;
	year: number;
	href: string;
	tone: 'blue' | 'lime' | 'violet' | 'orange' | 'paper';
	lead?: boolean;
	featured?: boolean;
	archive?: boolean;
	coverImage?: string;
	coverAlt?: string;
	filterKind?: string;
	outcome?: { value: string; label: string };
	lifecycleLabel?: string;
	translationKey?: string;
	role?: string;
	authorshipLabel?: string;
	lang?: 'it' | 'en';
	style?: string;
}

const {
	rank,
	title,
	excerpt,
	kind,
	year,
	href,
	tone,
	lead = false,
	featured = false,
	archive = false,
	coverImage,
	coverAlt = '',
	filterKind,
	outcome,
	lifecycleLabel,
	translationKey,
	role,
	authorshipLabel,
	lang = 'it',
	style,
} = Astro.props;
---

<article
	class:list={['project-card', `tone-${tone}`, { lead }]}
	data-featured-project={featured ? '' : undefined}
	data-project-item={archive ? '' : undefined}
	data-project-key={translationKey}
	data-kind={filterKind ?? kind}
	style={style}
	data-reveal={featured ? '' : undefined}
>
	<div class="project-card-surface">
		<div class="project-card-header">
			<div class="project-meta">
				<span>0{rank}</span>
				<span>{kind} · {year}</span>
			</div>
			{featured && authorshipLabel && role && <p class="project-role">{authorshipLabel} · {role}</p>}
		</div>
		<ProjectArtwork
			transitionName={featured && translationKey ? `project-art-${translationKey}` : undefined}
			translationKey={translationKey}
			lang={lang}
			coverImage={coverImage}
			coverAlt={coverAlt}
			lead={lead}
			featured={featured}
		/>
		<div class="project-card-copy">
			<a class="project-card-link" href={href}><h3>{title}</h3><span class="project-arrow" aria-hidden="true">↗</span></a>
			<p>{excerpt}</p>
			{archive && outcome && <p class="project-proof"><strong>{outcome.value}</strong> {outcome.label}</p>}
			{archive && lifecycleLabel && authorshipLabel && <p class="project-status">{lifecycleLabel} · {authorshipLabel}</p>}
		</div>
	</div>
</article>
