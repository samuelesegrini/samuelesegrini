---
import { getProjectKinds, type Locale, type WorkKind } from '../lib/content';
import { getPortfolioContent, projectPath } from '../lib/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const { projects } = await getPortfolioContent();
const published = projects
	.filter((project) => !project.draft && project.locale === lang)
	.toSorted(
		(left, right) =>
			(left.featuredRank ?? 99) - (right.featuredRank ?? 99) ||
			right.year - left.year ||
			left.title.localeCompare(right.title),
	);
const representedKinds = getProjectKinds(projects, lang);
const orderedKinds: WorkKind[] = ['app', 'package', 'open-source', 'experiment'];
const kinds = orderedKinds.filter((kind) => representedKinds.includes(kind));
const isIt = lang === 'it';
const copy = isIt
	? { title: 'Progetti', eyebrow: 'Indice completo', description: 'Applicazioni, pacchetti, contributi open source ed esperimenti.', all: 'Tutti', filter: 'Filtra per tipo' }
	: { title: 'Projects', eyebrow: 'Complete index', description: 'Applications, packages, open-source contributions, and experiments.', all: 'All', filter: 'Filter by type' };
const labels = isIt
	? { app: 'App', package: 'Pacchetti', 'open-source': 'Open source', experiment: 'Esperimenti' }
	: { app: 'Apps', package: 'Packages', 'open-source': 'Open source', experiment: 'Experiments' };
const cardLabels = isIt
	? { app: 'App', package: 'Pacchetto', 'open-source': 'Open source', experiment: 'Esperimento' }
	: { app: 'App', package: 'Package', 'open-source': 'Open source', experiment: 'Experiment' };
const lifecycleLabels = isIt
	? { verified: 'Verificato', archived: 'Archiviato', prototype: 'Prototipo', 'in-progress': 'In corso' }
	: { verified: 'Verified', archived: 'Archived', prototype: 'Prototype', 'in-progress': 'In progress' };
const authorshipLabels = isIt
	? { individual: 'Individuale', team: 'Team', contribution: 'Contributo' }
	: { individual: 'Individual', team: 'Team', contribution: 'Contribution' };
const tones = ['blue', 'lime', 'violet', 'orange', 'paper'] as const;
---

<BaseLayout
	lang={lang}
	title={`${copy.title} — Software Engineer`}
	description={copy.description}
	translationURL={isIt ? '/en/projects/' : '/it/progetti/'}
	alternateIt="/it/progetti/"
	alternateEn="/en/projects/"
>
	<header class="page-hero dark-section">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h1>{copy.title}</h1>
		<p>{copy.description}</p>
	</header>
	<section class="section archive-section" data-project-archive>
		<div class="filters" role="group" aria-label={copy.filter}>
			<button class="is-active" type="button" data-project-filter="all" aria-pressed="true">{copy.all}</button>
			{kinds.map((kind) => <button type="button" data-project-filter={kind} aria-pressed="false">{labels[kind]}</button>)}
		</div>
		<p class="filter-status" aria-live="polite"></p>
		<div class="project-grid archive-grid">
			{published.map((project, index) => (
				<ProjectCard
					rank={index + 1}
					title={project.title}
					excerpt={project.excerpt}
					kind={cardLabels[project.kind]}
					filterKind={project.kind}
					year={project.year}
					href={projectPath(project)}
					tone={tones[index % tones.length]}
					archive
					translationKey={project.translationKey}
					role={project.role}
					lang={lang}
					coverImage={project.coverImage}
					coverAlt={project.coverAlt}
					outcome={project.outcomes[0]}
					lifecycleLabel={lifecycleLabels[project.lifecycle]}
					authorshipLabel={authorshipLabels[project.authorship]}
				/>
			))}
		</div>
	</section>
</BaseLayout>

<script>
	const archive = document.querySelector<HTMLElement>('[data-project-archive]');
	if (archive) {
		const buttons = [...archive.querySelectorAll<HTMLButtonElement>('[data-project-filter]')];
		const items = [...archive.querySelectorAll<HTMLElement>('[data-project-item]')];
		const status = archive.querySelector<HTMLElement>('.filter-status');
		for (const button of buttons) {
			button.addEventListener('click', () => {
				const filter = button.dataset.projectFilter ?? 'all';
				for (const item of items) item.hidden = filter !== 'all' && item.dataset.kind !== filter;
				for (const candidate of buttons) {
					const active = candidate === button;
					candidate.classList.toggle('is-active', active);
					candidate.setAttribute('aria-pressed', String(active));
				}
				if (status) status.textContent = `${items.filter((item) => !item.hidden).length}`;
			});
		}
	}
</script>
