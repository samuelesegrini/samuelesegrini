---
interface Props { variation: 1 | 2 | 3 | 4 | 5 }
const { variation } = Astro.props;
const labels = [
	['D–01', 'Case file', 'Bold dossier / compact facts'],
	['D–02', 'Storyboard', 'Chapter-led / visual narrative'],
	['D–03', 'Outcome console', 'Proof-first / recruiter scan'],
	['D–04', 'Technical monograph', 'Quiet authority / considered depth'],
	['D–05', 'System atlas', 'Diagrammatic / process-led'],
] as const;
const label = labels[variation - 1];
---

<header class="prototype-label"><span>{label[0]}</span><strong>{label[1]}</strong><small>{label[2]}</small></header>

{variation === 1 && (
	<div class="prototype-canvas detail-casefile">
		<h3>EASYMANAGER</h3>
		<div class="casefile-meta"><div><span>YEAR</span><b>2026</b></div><div><span>ROLE</span><p>Product designer<br />Software engineer</p></div><div><span>SYSTEM</span><p>Swift 6.3 · Concurrency<br />Hardware · SQL</p></div><div><span>SUMMARY</span><p>Restaurant operations rebuilt as durable workflows with honest failure semantics.</p></div></div>
		<figure><img src="/images/projects/easymanager-service-pulse.svg" alt="EasyManager service flow" /><figcaption><span>Order lifecycle / five explicit stages</span><b>View repository ↗</b></figcaption></figure>
	</div>
)}

{variation === 2 && (
	<div class="prototype-canvas detail-storyboard">
		<header><span>CASE STUDY / 02</span><h3>Galaxy Trucker</h3><p>Making four players inhabit one authoritative match.</p></header>
		<div class="story-chapters"><article><span>01 / THE PROMISE</span><h4>A board game, made playable across a network.</h4><p>The visible goal was a ship. The real problem was shared truth.</p></article><figure><img src="/images/projects/galaxy-trucker-network.png" alt="Galaxy Trucker network interface" /><figcaption>Shared state / 4 clients / 1 server</figcaption></figure><article><span>02 / THE SYSTEM</span><h4>Two transports. One behaviour.</h4><p>Socket and RMI implementations had to preserve the same rules and lifecycle.</p></article><article class="story-quote"><span>03 / THE LESSON</span><blockquote>“Interfaces are agreements between people before they are abstractions in code.”</blockquote></article></div>
	</div>
)}

{variation === 3 && (
	<div class="prototype-canvas detail-console">
		<div class="console-top"><span>PROJECT / EASYMANAGER</span><span>STATUS / ACTIVE RE-ENGINEERING</span><span>VERSION / 0.1.0</span></div>
		<header><div><p>RESTAURANT OPERATIONS TOOLKIT</p><h3>Durable orders.<br />Honest uncertainty.</h3></div><p>A modular Swift system designed around long-lived workflows, serialized device access, and fiscal reconciliation.</p></header>
		<div class="console-metrics"><div><b>31</b><span>Modules in verified source</span></div><div><b>0</b><span>Remote package dependencies</span></div><div><b>6.3</b><span>Swift language mode</span></div><div><b>0.1.0</b><span>Versioned public API</span></div></div>
		<div class="console-bottom"><article><span>CORE DECISION</span><h4>Model uncertainty as state.</h4><p>A lost reply cannot prove a fiscal mutation did not execute.</p></article><figure><img src="/images/projects/easymanager-service-pulse.svg" alt="Five-stage order lifecycle" /></figure><aside><span>EXPLORE</span><b>01 Context</b><b>02 Boundaries</b><b>03 Failure</b><b>04 Evidence</b></aside></div>
	</div>
)}

{variation === 4 && (
	<div class="prototype-canvas detail-monograph">
		<div class="monograph-number">MONOGRAPH 01 / 2026</div>
		<header><p>A CASE STUDY BY SAMUELE SEGRINI</p><h3>EasyManager</h3><p>Re-engineering restaurant operations from application-shaped code into a modular Swift toolkit.</p></header>
		<figure><img src="/images/projects/easymanager-service-pulse.svg" alt="EasyManager order stages" /><figcaption>Figure 01. One order travelling from draft to fiscal reconciliation.</figcaption></figure>
		<div class="monograph-body"><aside><span>DISCIPLINE</span><b>Swift systems design</b><span>ROLE</span><b>Product & engineering</b><span>PERIOD</span><b>2023—2026</b></aside><article><p class="monograph-lead">The project has two distinct code histories. The first made the problem tangible; the second asks which boundaries let the workflow remain understandable under concurrency and device failure.</p><h4>Two eras, one problem domain</h4><p>An order-taking flow, kitchen work, inventory, checkout, devices, and fiscal records all have different lifetimes. Treating them as one application surface made local changes carry hidden consequences.</p></article></div>
	</div>
)}

{variation === 5 && (
	<div class="prototype-canvas detail-atlas">
		<header><div><span>ATLAS / SWIFT SYSTEMS</span><h3>EASY<br />MANAGER</h3></div><p>One case study mapped through the decisions that make a restaurant operation durable.</p></header>
		<div class="atlas-route"><article><b>01</b><div><span>ORIGIN</span><h4>A screen-shaped application</h4><p>Useful domain knowledge, entangled lifetimes.</p></div></article><article><b>02</b><div><span>PRESSURE</span><h4>Orders outlive views</h4><p>Device work and fiscal work demand explicit ownership.</p></div></article><figure><img src="/images/projects/easymanager-service-pulse.svg" alt="EasyManager system lifecycle" /><figcaption>THE ROUTE / draft → reconciliation</figcaption></figure><article><b>03</b><div><span>BOUNDARY</span><h4>Serialize the physical world</h4><p>A device lane protects command order at each endpoint.</p></div></article><article><b>04</b><div><span>OUTCOME</span><h4>Uncertainty becomes visible</h4><p>Reconciliation replaces unsafe blind retry.</p></div></article></div>
	</div>
)}
