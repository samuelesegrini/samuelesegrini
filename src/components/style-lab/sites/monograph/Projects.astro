---
import type { LabSiteContent } from '../../../../lib/lab-sites';
import '../../../../styles/lab-sites/monograph.css';

interface Props { content: LabSiteContent }
const { content } = Astro.props;
---

<header class="monograph-index-header">
	<p class="monograph-label">Monograph no. 02 · Index</p>
	<h1>Projects</h1>
	<p class="monograph-lead">A publication index of software, games, and interface experiments.</p>
</header>

<section class="monograph-project-index" aria-label="Project index">
	{content.featuredProjects.map((document, index) => (
		<article data-project-row>
			<p class="monograph-label">{String(index + 1).padStart(2, '0')} · {document.data.year}</p>
			<img src={document.data.coverImage} alt={document.data.coverAlt} width="1200" height="800" />
			<div>
				<h2>{document.data.title}</h2>
				<p>{document.data.excerpt}</p>
			</div>
			<p class="monograph-role">{document.data.role}</p>
		</article>
	))}
</section>
