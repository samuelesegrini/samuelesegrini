---
import type { MarkdownHeading } from 'astro';
import type { LabSiteContent } from '../../../../lib/lab-sites';
import '../../../../styles/lab-sites/monograph.css';

interface Props { content: LabSiteContent; headings: readonly MarkdownHeading[] }
const { content, headings } = Astro.props;
const sections = headings.filter(({ depth }) => depth === 2);
---

<header class="monograph-article-hero">
	<p class="monograph-label">Essay · distributed systems</p>
	<h1>{content.articleDocument.data.title}</h1>
	<p class="monograph-lead">{content.articleDocument.data.excerpt}</p>
	<p class="monograph-byline">By Samuele Segrini</p>
</header>

<div class="monograph-article-layout">
	<aside class="monograph-contents" aria-label="Article contents">
		<p class="monograph-label">Contents</p>
		{sections.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
	</aside>
	<article class="monograph-reading"><slot name="body" /></article>
	<aside class="monograph-marginalia" data-monograph-marginalia>
		<p class="monograph-label">Marginalia</p>
		<p>Several players can share one world only when the system keeps its promises.</p>
	</aside>
</div>
