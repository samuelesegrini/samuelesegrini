---
import type { LabSiteContent } from '../../../../lib/lab-sites';
import '../../../../styles/lab-sites/atlas.css';

interface Props { content: LabSiteContent }
const { content } = Astro.props;
---

<section class="atlas-home-hero">
	<p class="atlas-meta atlas-route-marker">Atlas / working index / 2023—2026</p>
	<h1>Work in<br /><span>active orbit.</span></h1>
	<p class="atlas-narrative">An index of systems, collaborative work, and the evidence they leave behind.</p>
</section>

<section class="atlas-editions" aria-labelledby="atlas-editions-title">
	<div class="atlas-editions-heading">
		<p class="atlas-meta atlas-route-marker">Selected editions</p>
		<h2 id="atlas-editions-title">Three working records</h2>
	</div>
	<div class="atlas-edition-row">
		{content.featuredProjects.map((document, index) => (
			<article class="atlas-edition" data-atlas-edition>
				<p class="atlas-meta">Edition {String(index + 1).padStart(2, '0')} / {document.data.year}</p>
				<div class="atlas-edition-image"><img src={document.data.coverImage} alt={document.data.coverAlt} width="1200" height="800" /></div>
				<p class="atlas-edition-kind">{document.data.kind}</p>
				<h3>{document.data.title}</h3>
				<p>{document.data.excerpt}</p>
			</article>
		))}
	</div>
</section>

<section class="atlas-compact-index" data-atlas-compact-index aria-labelledby="atlas-index-title">
	<div>
		<p class="atlas-meta atlas-route-marker">Compact index</p>
		<h2 id="atlas-index-title">Proof, at a glance</h2>
	</div>
	<div>
		{content.featuredProjects.map((document, index) => {
			const proof = document.data.outcomes[0];
			return <article data-project-row>
				<span class="atlas-meta">{String(index + 1).padStart(2, '0')}</span>
				<h3>{document.data.title}</h3>
				<p>{proof ? `${proof.value} ${proof.label}` : document.data.role}</p>
			</article>;
		})}
	</div>
</section>
