---
import type { MarkdownHeading } from 'astro';
import type { LabSiteContent } from '../../../../lib/lab-sites';
import '../../../../styles/lab-sites/atlas.css';

interface Props { content: LabSiteContent; headings: readonly MarkdownHeading[] }
const { content, headings } = Astro.props;
const sections = headings.filter(({ depth }) => depth === 2);
---

<header class="atlas-aperture" data-atlas-aperture>
	<p class="atlas-meta atlas-route-marker">Atlas / field note / 01</p>
	<p class="atlas-meta">Personal experience · 2026</p>
	<h1>{content.articleDocument.data.title}</h1>
	<p class="atlas-narrative">{content.articleDocument.data.excerpt}</p>
</header>

<section class="atlas-reading" data-atlas-reading>
	<aside class="atlas-contents" aria-label="Article contents">
		<p class="atlas-meta">Contents</p>
		{sections.map((heading, index) => <a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a>)}
	</aside>
	<article class="atlas-prose"><slot name="body" /></article>
	<aside class="atlas-evidence" aria-label="Article evidence">
		<p class="atlas-meta">Evidence module</p>
		<strong>Galaxy Trucker</strong>
		<p>The essay’s working record: a multiplayer project where several players had to share one match.</p>
	</aside>
</section>
