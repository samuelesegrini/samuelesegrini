---
import type { LabSiteContent } from '../../../../lib/lab-sites';
import '../../../../styles/lab-sites/atlas.css';

interface Props { content: LabSiteContent }
const { content } = Astro.props;
---

<header class="atlas-index-hero">
	<p class="atlas-meta atlas-route-marker">Atlas / project index</p>
	<h1>Every record<br />has an edge.</h1>
	<p class="atlas-narrative">A compact atlas of software and product work, read through its scope, material, and first available proof.</p>
</header>

<section class="atlas-project-index" aria-label="Atlas project index">
	{content.featuredProjects.map((document, index) => {
		const proof = document.data.outcomes[0];
		return <article data-atlas-project-row>
			<p class="atlas-project-number" aria-label={`Project ${index + 1}`}>{String(index + 1).padStart(2, '0')}</p>
			<div class="atlas-poster-window"><img src={document.data.coverImage} alt={document.data.coverAlt} width="1200" height="800" /></div>
			<div class="atlas-project-title"><p class="atlas-meta">{document.data.kind} / {document.data.year}</p><h2>{document.data.title}</h2></div>
			<p class="atlas-project-proof">{proof ? `${proof.value} ${proof.label}` : document.data.role}</p>
		</article>;
	})}
</section>
