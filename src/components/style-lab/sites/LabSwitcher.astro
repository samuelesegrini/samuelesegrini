---
import { labSitePath, labSiteThemes, type LabSiteTheme } from '../../../lib/lab-sites';

interface Props { currentTheme: LabSiteTheme }
const { currentTheme } = Astro.props;
const labels: Record<LabSiteTheme, string> = {
	signal: 'Signal',
	monograph: 'Monograph',
	atlas: 'Atlas',
};
---

<nav class="lab-switcher" data-lab-switcher aria-label="Compare portfolio directions">
	<a href="/lab/styles/">Studies</a>
	{labSiteThemes.map((theme) => (
		<a href={labSitePath(theme, 'home')} aria-current={theme === currentTheme ? 'true' : undefined}>{labels[theme]}</a>
	))}
</nav>
