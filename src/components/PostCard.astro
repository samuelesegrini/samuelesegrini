---
interface Props {
	title: string;
	excerpt: string;
	href: string;
	date: Date;
	lang: 'it' | 'en';
	tags: readonly string[];
}

const { title, excerpt, href, date, lang, tags } = Astro.props;
const formattedDate = new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-GB', {
	day: '2-digit',
	month: 'long',
	year: 'numeric',
}).format(date);
---

<article class="post-card" data-post-item data-reveal>
	<a href={href}>
		<div class="post-meta">
			<time datetime={date.toISOString()}>{formattedDate}</time>
			<span>{tags.join(' · ')}</span>
		</div>
		<h3>{title}</h3>
		<p>{excerpt}</p>
		<span class="text-link">{lang === 'it' ? 'Leggi l’articolo' : 'Read article'} <span aria-hidden="true">↗</span></span>
	</a>
</article>
